# Environment for the Docker Compose stack used by the demo-smoke run (Issue #232,
# scripts/run-e2e.mjs --target demo). Starts the "demo" Compose profile
# (docs/features/demo-instance.md) with ai-stub standing in for the chat/embedding provider,
# instead of a real OpenAI-compatible endpoint or the demo README's own default of a locally
# running Ollama - matching how e2e/e2e.env avoids any real, non-deterministic, potentially
# costly model in CI.
#
# Intentionally tracked in git: every credential here is a documented demo value
# (demo/README.md, "Nutzerkonten"), not a real secret, and there is no real AI secret here
# either - ai-stub does not check the placeholder API key at all.

# Keycloak login (not "dev"), matching the demo profile's whole point of showing the realistic
# anmeldemodell (docs/features/demo-instance.md, "Installation und Seed").
SPRING_PROFILES_ACTIVE=docker,oidc
# Backend must listen on all interfaces to be reachable from the frontend container (default is
# "localhost", which is loopback-only).
OPAA_SERVER_ADDRESS=0.0.0.0

# The installation from the answer file e2e/installation/demo-smoke.json (ADR-0060), mounted by
# scripts/run-e2e.mjs: the first administrator is the local bootstrap account, not the Keycloak
# user (ADR-0033). Its address looks deliverable (the same string as the Keycloak "demo-admin"
# user's is fine, the two are different accounts under different issuers), and its password is
# fixed so the seed can sign in as that account and grant SYSTEM_ADMIN to "demo-admin"
# (demo/seed/seed.py, provision_users). The bundled Keycloak is the identity provider of the
# installation: the browser reaches its issuer on localhost, the backend its JWK set under the
# Compose service name "keycloak" - both hosts pass the address check only through the allowlist.
OPAA_INSTALLATION_ANSWER_FILE=/run/opaa/installation/demo-smoke.json
OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=localhost:8180,keycloak:8180

# The SSRF target-address check defaults to active and would otherwise reject every
# HTTP_DIRECTORY/RSS_FEED/S3 fetch against the demo source services below - all three resolve to
# container-internal addresses on the Compose network's own bridge, a private range legitimate
# for this stack (see demo/README.md, "Installation mit einem Befehl" for the identical reasoning
# against a developer's own .env.docker). "objectstore" is the S3 endpoint of the sixth
# library.
OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=demo-corpus,presse.stadt-rheinfurt.example,objectstore
OPAA_MODEL_TARGET_VALIDATION_ALLOWLIST=ai-stub:8089

# Without this, the frontend's own Content-Security-Policy silently blocks the OIDC login in the
# browser (#409/#670) - the seed itself would still succeed (it talks to Keycloak directly, never
# through the browser), but Playwright's login step below would fail with no obvious cause.
OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:8180

# Same reasoning as e2e/e2e.env: "openai" here names the wire protocol (see application.yml) -
# the only anbindungsweg - and the address points at ai-stub (e2e/ai-stub/server.mjs),
# reused as-is by e2e/docker-compose.demo-smoke.yml - not an external endpoint, and not
# application.yml's own default (a locally operated Ollama server). The address is therefore
# overridden explicitly below.
#
# Deliberately no OPAA_OPENAI_API_KEY here (unlike e2e/e2e.env, which activates the "dev"
# profile and gets its OPAA_SETTINGS_ENCRYPTION_KEY default from application.yml along with it -
# this file only activates "docker,oidc", so no such default exists). ai-stub does not check the
# key at all; the chat model of the answer file carries none either.
OPAA_OPENAI_BASE_URL=http://ai-stub:8089

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa

# Root secret of the local account management (ADR-0033): this stack runs "docker,oidc", where the
# backend refuses to start without a strong OPAA_AUTH_JWT_SECRET (at least 32 characters, no
# placeholder). A public test value guarding only demo accounts, never a real secret - a real
# deployment generates its own with `openssl rand -base64 48` (see .env.docker.example).
OPAA_AUTH_JWT_SECRET=demo-smoke-local-auth-jwt-secret-not-for-production-0123456789

# The frontend's nginx forwards every API call, so X-Forwarded-For counts only from exactly that
# container - the fixed address run-e2e.mjs passes as OPAA_COMPOSE_FRONTEND_ADDRESS (ADR-0033,
# Entscheidung 9).
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.30.0.10/32

# The S3 library of the demo profile is the first seeded library with source credentials
# (accessKey:secretKey of the stack's own MinIO), and storing credentials needs the AES key of
# io.opaa.security.CredentialsEncryptor - this stack activates "docker,oidc", not "dev", so
# application.yml's dev-only default does not apply - "oidc" refuses it (PublishedEncryptionKeyGuard)
# - and the seed would fail with 503 without a key. Deliberately empty: scripts/run-e2e.mjs fills in
# a key generated per run (scripts/run-env-file.mjs), since a key in this file would be public and
# "oidc" refuses those. A real deployment generates its own (see .env.docker.example).
OPAA_CREDENTIALS_ENCRYPTION_KEY=

# The demo keeps its uploaded originals in the object store (ADR-0030), not on the
# filesystem - the bucket "opaa-uploads" of the stack's own "objectstore", with the bucket-scoped
# key the "objectstore-seed" init step creates (demo/objectstore/opaa-uploads-policy.json), not
# the root key the two S3 source libraries carry. Same values demo/README.md documents for a
# hand-configured demo. The upload store's target validation passes its configured endpoint by
# definition, so "objectstore" being on OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST above is about
# the connectors alone.
OPAA_UPLOAD_STORE=s3
OPAA_UPLOAD_S3_ENDPOINT=http://objectstore:9000
OPAA_UPLOAD_S3_BUCKET=opaa-uploads
OPAA_UPLOAD_S3_ACCESS_KEY=opaa-uploads
OPAA_UPLOAD_S3_SECRET_KEY=OpaaUploads!2026

# demo/seed/seed.py uploads all 26 documents of the "Interne Dienstanweisungen Meldewesen"
# library back-to-back (no delay between requests, unlike its own polling waits for INDEXED
# status) - uploadTaskExecutor's default queue capacity of 20 (opaa.upload.thread-pool,
# core=2/max=4/queue=20) can fill up before Tika finishes parsing the slower PDF/DOCX/PPTX
# uploads already ahead in the queue, failing the last one or two with "Die Verarbeitung ist
# derzeit ausgelastet" (observed against a real Rheinfurt corpus run, see this PR's own
# description for the concrete failure). Raised, not just retried away: a one-off idempotent
# second seed.py run (as demo/README.md's own idempotency section documents) would also fix it,
# but would make every demo-smoke run's duration depend on whether that race actually happened.
OPAA_UPLOAD_THREAD_POOL_QUEUE_CAPACITY=30

# The demo profile's Keycloak realm (keycloak/realm-export.json) has a static redirectUris/
# webOrigins list scoped to http://localhost:3000 - unlike e2e/e2e.env's dynamic CORS origin, this
# is therefore not freely relocatable via OPAA_FRONTEND_PORT without also editing the realm
# export (see scripts/run-e2e.mjs's own comment on this).
OPAA_CORS_ALLOWED_ORIGINS=http://localhost:3000

# The seed's last step imports the prepared chats of Andrea's space through the seed-only
# route POST /api/v1/spaces/{id}/chat-imports, which exists only with this switch (off by default).
OPAA_DEMO_CHAT_IMPORT_ENABLED=true

# Shows the demo/source notice (frontend/src/app/shell/DemoNotice.tsx) in the footer - off by
# default (frontend/Dockerfile), on here because a real demo deployment always sets it too
# (docs/features/demo-instance.md) and the smoke test asserts on it being visible (Issue #232's
# own acceptance criteria only ever named the belegte-Antwort scenario, but #230 landed alongside
# this issue in the same epic and the notice is part of what "the demo profile works" means).
OPAA_DEMO_MODE=true
