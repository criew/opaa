# Environment for the Docker Compose stack used by the demo-smoke run (Issue #232,
# scripts/run-e2e.mjs --target demo). Starts the "demo" Compose profile
# (docs/features/demo-instance.md) with ai-stub standing in for the chat/embedding provider,
# instead of a real OpenAI-compatible endpoint or the demo README's own default of a locally
# running Ollama - matching how e2e/e2e.env avoids any real, non-deterministic, potentially
# costly model in CI.
#
# Intentionally tracked in git: every credential here is a documented demo value
# (demo/README.md, "Demo-Zugangsdaten"), not a real secret, and there is no real AI secret here
# either - ai-stub does not check the placeholder API key at all.

# Keycloak login (not "dev"), matching the demo profile's whole point of showing the realistic
# anmeldemodell (docs/features/demo-instance.md, "Installation und Seed").
SPRING_PROFILES_ACTIVE=docker,oidc
# Backend must listen on all interfaces to be reachable from the frontend container (default is
# "localhost", which is loopback-only).
OPAA_SERVER_ADDRESS=0.0.0.0

# Must match the Keycloak realm's "demo-admin" user (keycloak/realm-export.json) - otherwise no
# account gets SYSTEM_ADMIN and the seed's first step aborts with a clear error (see
# demo/README.md, "Compose-Stack starten (#229)").
OPAA_INITIAL_ADMIN_EMAIL=admin@stadt-rheinfurt.example

# #267: the SSRF target-address check defaults to active and would otherwise reject every
# HTTP_DIRECTORY/RSS_FEED fetch against the demo corpus services below - both resolve to
# container-internal addresses on the Compose network's own bridge, a private range legitimate
# for this stack (see demo/README.md, "Compose-Stack starten (#229)" for the identical reasoning
# against a developer's own .env.docker).
OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=demo-corpus,presse.stadt-rheinfurt.example

# Without this, the frontend's own Content-Security-Policy silently blocks the OIDC login in the
# browser (#409/#670) - the seed itself would still succeed (it talks to Keycloak directly, never
# through the browser), but Playwright's login step below would fail with no obvious cause.
OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:8180

# JWK Set URI for token verification MUST be the container-internal address ("keycloak", the
# Compose service name) - unlike OPAA_OIDC_ISSUER_URI/OPAA_OIDC_AUTHORITY (deliberately not set in
# this file at all - application.yml's own default of http://localhost:8180/realms/opaa is already
# correct here, see scripts/run-e2e.mjs's own comment on why keycloakPort is a fixed constant),
# this one is fetched by the backend itself, never by the browser, so "localhost" here would point
# at the backend container's own loopback instead of the keycloak service and every token
# verification would fail (see .env.docker.example's identical comment).
OPAA_OIDC_JWK_SET_URI=http://keycloak:8180/realms/opaa/protocol/openid-connect/certs

# Same reasoning as e2e/e2e.env: "openai" here names the wire protocol used for chat (see
# application.yml) - and the address points at ai-stub (e2e/ai-stub/server.mjs), reused as-is by
# e2e/docker-compose.demo-smoke.yml - not an external endpoint, and not application.yml's own
# default (a locally operated Ollama server). The address is therefore overridden explicitly
# below. The API key is a placeholder; ai-stub does not check it.
OPAA_OPENAI_API_KEY=sk-demo-smoke-placeholder
OPAA_OPENAI_BASE_URL=http://ai-stub:8089

# Embedding uses Ollama's native API since #773 - a separate variable from OPAA_OPENAI_BASE_URL
# above (the two functions no longer share one). ai-stub answers both wire shapes (see its own
# header comment), so this points at the very same stub instance/port as chat above.
OPAA_OLLAMA_EMBEDDING_BASE_URL=http://ai-stub:8089

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa

# demo/seed/seed.py uploads all 26 documents of the "Interne Dienstanweisungen Meldewesen"
# library back-to-back (no delay between requests, unlike its own polling waits for INDEXED
# status) - uploadTaskExecutor's default queue capacity of 20 (opaa.upload.thread-pool,
# core=2/max=4/queue=20) can fill up before Tika finishes parsing the slower PDF/DOCX/PPTX
# uploads already ahead in the queue, failing the last one or two with "Die Verarbeitung ist
# derzeit ausgelastet" (observed against a real Rheinfurt corpus run, see this PR's own
# description for the concrete failure). Raised, not just retried away: a one-off idempotent
# second seed.py run (as demo/README.md's own idempotency section documents) would also fix it,
# but would make every demo-smoke run's duration depend on whether that race actually happened.
OPAA_UPLOAD_THREAD_POOL_QUEUE_CAPACITY=30

# The demo profile's Keycloak realm (keycloak/realm-export.json) has a static redirectUris/
# webOrigins list scoped to http://localhost:3000 - unlike e2e/e2e.env's dynamic CORS origin, this
# is therefore not freely relocatable via OPAA_FRONTEND_PORT without also editing the realm
# export (see scripts/run-e2e.mjs's own comment on this).
OPAA_CORS_ALLOWED_ORIGINS=http://localhost:3000

# #230: shows the demo/source notice (frontend/src/layouts/DemoNotice.tsx) in the footer - off by
# default (frontend/Dockerfile), on here because a real demo deployment always sets it too
# (docs/features/demo-instance.md) and the smoke test asserts on it being visible (Issue #232's
# own acceptance criteria only ever named the belegte-Antwort scenario, but #230 landed alongside
# this issue in the same epic and the notice is part of what "the demo profile works" means).
OPAA_DEMO_MODE=true
