# Environment of the "installation" target (scripts/run-e2e.mjs --target installation, ADR-0060):
# the operating mode "oidc" on an empty database, without answer file and without start values,
# so every start stays in installation mode until the set-up assistant completes it. The token is
# preset so the scenario knows it; without it the first start would print a generated one to the
# log only.
#
# Intentionally tracked in git and safe to commit: every value here is a public test value for a
# stack that is created and destroyed by one command, never a real secret.
SPRING_PROFILES_ACTIVE=docker,oidc
OPAA_SERVER_ADDRESS=0.0.0.0
OPAA_INSTALLATION_TOKEN=e2e-installations-token-0123456789abcdef
# The chat, embedding and rerank model the assistant enters run on ai-stub, a private address the
# target address check refuses without this entry.
OPAA_MODEL_TARGET_VALIDATION_ALLOWLIST=ai-stub:8089,ocr-stub:5001
# Text recognition released by the operation, so the assistant offers its step (ADR-0060,
# Entscheidung 18); the scenario checks it against ocr-stub.
OPAA_OCR_ENABLED=true
# The identity provider of the sign-in step is oidc-stub: the browser reads it under the issuer
# (loopback port 18095, fixed in e2e/docker-compose.installation.yml), the backend only its JWK set
# under the service name. Both are private addresses the OIDC address check refuses without this.
OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=localhost:18095,oidc-stub:8095
# The sign-in page's OIDC client reads the provider's discovery document from the browser.
OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:18095
# The mail server of the assistant's mail step is mailpit, a private address the installation's
# address check of mail servers refuses without this entry.
OPAA_INSTALLATION_MAIL_TARGET_ALLOWLIST=mailpit:1025

# Signing secret of the local issuer, empty on purpose: scripts/run-e2e.mjs fills in one generated
# per run (scripts/run-env-file.mjs).
OPAA_AUTH_JWT_SECRET=
# The run talks plain HTTP on localhost; a Secure cookie would never be sent back.
OPAA_AUTH_LOCAL_COOKIE_SECURE=false
# Encrypts the chat model's key of the assistant. Empty on purpose: scripts/run-e2e.mjs fills in a
# key generated per run (scripts/run-env-file.mjs).
OPAA_SETTINGS_ENCRYPTION_KEY=
# The frontend container's fixed address of this stack (scripts/run-e2e.mjs).
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.27.0.10/32

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa

# The quick tour's hint is a modal dialog on the empty chat and would block every scenario that
# lands there; the tour's own scenarios switch it on for themselves.
OPAA_FEATURES_QUICK_TOUR_ENABLED=false
