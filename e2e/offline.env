# Environment of the offline target (scripts/offline.mjs): operating mode "oidc" without any
# identity provider, so the local sign-in of the bootstrap administrator is the way in, and the
# models behind ai-stub inside the isolated stack. Public test values only, never a real secret.
SPRING_PROFILES_ACTIVE=docker,oidc
OPAA_SERVER_ADDRESS=0.0.0.0
TZ=UTC

OPAA_INITIAL_ADMIN_EMAIL=systemverwaltung@opaa.example
OPAA_INITIAL_ADMIN_PASSWORD=E2eOhneInternetKonto!2026
OPAA_AUTH_JWT_SECRET=offline-e2e-issuer-secret-not-for-production-0123456789abcdef
# The run talks plain HTTP on localhost; a Secure cookie would never be sent back.
OPAA_AUTH_LOCAL_COOKIE_SECURE=false
OPAA_SETTINGS_ENCRYPTION_KEY=c2V0dGluZ3NkZXZrZXkwMHNldHRpbmdzZGV2a2V5MDE=
OPAA_CREDENTIALS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# The fixed address of the frontend's nginx in this stack's subnet (scripts/offline.mjs).
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.24.0.10/32

# Chat and embedding model: the OpenAI-compatible service ai-stub inside the stack.
OPAA_OPENAI_BASE_URL=http://ai-stub:8089

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa
