# Environment for the Docker Compose stack used by the E2E suite.
# scripts/run-e2e.mjs passes this file as OPAA_ENV_FILE (see
# docker-compose.yml: `env_file: ${OPAA_ENV_FILE:-.env.docker}`), so the
# stack never touches a developer's own .env.docker.
#
# Intentionally tracked in git and safe to commit: the dev auth profile has
# no credentials and no signing secret at all (see README.md, "Warum der
# dev-Auth-Modus?"), and there are no real AI secrets here.

# Activates docker-specific Spring config (DB host "postgres" instead of
# "localhost") and the "dev" auth profile, in which every request is
# authenticated as one of the users configured under opaa.auth.dev.users
# (see docs/handbuch/deployment.md and ADR-0005).
SPRING_PROFILES_ACTIVE=docker,dev
# Backend must listen on all interfaces to be reachable from the frontend
# container (default is "localhost", which is loopback-only).
OPAA_SERVER_ADDRESS=0.0.0.0

# The suite never reaches a real model or the network: "openai" here names the wire protocol
# (see application.yml) - the only anbindungsweg since #762, no longer a choice against a native
# "ollama" provider - and the address points at ai-stub, a minimal in-suite stand-in for that
# protocol (see e2e/ai-stub/server.mjs and docker-compose.e2e.yml's "ai-stub" service) - not an
# external endpoint, and not application.yml's own default (a locally operated Ollama server).
# The address has to be overridden explicitly for that reason. The API key is a placeholder;
# ai-stub does not check it.
OPAA_OPENAI_API_KEY=sk-e2e-placeholder
OPAA_OPENAI_BASE_URL=http://ai-stub:8089

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa

# OPAA_CORS_ALLOWED_ORIGINS is set dynamically in docker-compose.e2e.yml
# (must match the frontend's host port, which run-e2e.mjs controls), not
# here.

# Two of the four test users come from the dev profile's defaults: "dev-admin" (email
# admin@opaa.local, which matches the default opaa.auth.initial-admin-email and is therefore
# provisioned as SYSTEM_ADMIN) and "dev-user" (a plain user). The other two, "dev-outsider" and
# "dev-format-pipelines", exist only for this suite - neither is part of the dev profile's
# defaults in application.yml, so a plain `SPRING_PROFILES_ACTIVE=local,dev` backend does not have
# them. Both are added on top via indexed OPAA_AUTH_DEV_USERS_* environment variables in
# docker-compose.e2e.yml (see the comment there for why they live in that file and not here).
# e2e/fixtures/auth.ts selects between all four per scenario.
