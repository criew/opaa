# Environment of the two-instance stack (ADR-0053; scripts/run-e2e.mjs --target multi-instance):
# docker-compose.yml with docker-compose.multi.yml (migration step, backend-a, backend-b) and the
# overlay e2e/docker-compose.multi-instance.yml. Like e2e/local-auth.env it runs the operating mode
# "oidc" without Keycloak, so the local sign-in is the way in and its sessions can be checked across
# instances.
#
# Intentionally tracked in git: every value is a public test value for a stack that one command
# creates and destroys, never a real secret. Every instance reads this one file, which is what keeps
# their configuration fingerprints equal (ADR-0053, Entscheidung 4).

SPRING_PROFILES_ACTIVE=docker,oidc
OPAA_SERVER_ADDRESS=0.0.0.0
TZ=UTC

# The installation from the answer file, mounted from e2e/installation/ (ADR-0060). The previous
# version of the phase "rolling" reads it as well: it has to carry the installation mode and the
# embedding model of the installation (#3206), see docs/entwicklung/build-und-ci.md.
OPAA_INSTALLATION_ANSWER_FILE=/run/opaa/installation/multi-instance.json
OPAA_AUTH_JWT_SECRET=multi-instance-e2e-issuer-secret-not-for-production-0123456789
OPAA_AUTH_LOCAL_COOKIE_SECURE=false
# One token outlasts the rolling-update scenario, whose load runs with it throughout.
OPAA_AUTH_LOCAL_ACCESS_TOKEN_TTL=30m
OPAA_SETTINGS_ENCRYPTION_KEY=c2V0dGluZ3NkZXZrZXkwMHNldHRpbmdzZGV2a2V5MDE=
# Stores the access key of the S3 library the scenarios index.
OPAA_CREDENTIALS_ENCRYPTION_KEY=bjzhjv2AKbnBjZCYAR2V/Glp7TYZzqABwkqXs3lEyCY=

# The frontend's fixed address (run-e2e.mjs: OPAA_COMPOSE_FRONTEND_ADDRESS).
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.26.0.10/32

OPAA_OPENAI_BASE_URL=http://ai-stub:8089

# Originals in the object store every instance shares (docker-compose.yml, profile upload-s3).
OPAA_UPLOAD_STORE=s3
OPAA_UPLOAD_S3_ENDPOINT=http://upload-store:9000
OPAA_UPLOAD_S3_BUCKET=opaa-uploads
OPAA_UPLOAD_S3_ACCESS_KEY=opaa-uploads
OPAA_UPLOAD_S3_SECRET_KEY=OpaaUploads!2026
OPAA_UPLOAD_S3_PATH_STYLE=true

# The S3 library of the scenarios reads the bucket "corpus" of the same store, the chat model of the
# answer file and the identity provider they create point at ai-stub; all are private addresses.
OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=upload-store,ai-stub
OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=ai-stub:8089

# A small pool, so that the load scenario reaches it (ADR-0053, Entscheidung 15).
OPAA_DB_POOL_SIZE=5

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa
