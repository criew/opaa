{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based end-to-end tests for OPAA (Playwright).",
  "scripts": {
    "test": "node scripts/run-e2e.mjs",
    "test:demo-smoke": "node scripts/run-e2e.mjs --target demo",
    "test:local-auth": "node scripts/run-e2e.mjs --target local-auth",
    "test:playwright": "playwright test",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
