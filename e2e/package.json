{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based end-to-end tests for OPAA (Playwright).",
  "scripts": {
    "test": "node scripts/run-e2e.mjs",
    "test:demo-smoke": "node scripts/run-e2e.mjs --target demo",
    "test:local-auth": "node scripts/run-e2e.mjs --target local-auth",
    "test:playwright": "playwright test",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
