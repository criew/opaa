{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser-based end-to-end tests for OPAA (Playwright).",
  "scripts": {
    "test": "node scripts/run-e2e.mjs",
    "test:demo-smoke": "node scripts/run-e2e.mjs --target demo",
