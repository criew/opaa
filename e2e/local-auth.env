# Environment for the Docker Compose stack used by the local-auth E2E target (ADR-0033, #1543;
# scripts/run-e2e.mjs --target local-auth). Unlike e2e/e2e.env this stack runs the real operating
# mode "oidc" - the only mode in which the local issuer exists at all - but **without Keycloak**:
# since ADR-0033, Entscheidung 4, an installation with no OIDC provider at all is a legitimate
# state, and it is exactly the state a first start produces. The only way in is the local sign-in,
# which is what this target exists to exercise end to end.
#
# Intentionally tracked in git and safe to commit: every value here is a public test value for a
# stack that is created and destroyed by one command, never a real secret.

# The operating mode (ADR-0005, ADR-0033 Entscheidung 8: the profile name stays "oidc" even though
# it now also carries the local sign-in). No OPAA_OIDC_* variables on purpose - without them the
# OIDC seeder writes no provider row, and GET /api/v1/auth/config answers with an empty "providers"
# list plus "localAccounts".
SPRING_PROFILES_ACTIVE=docker,oidc
# Backend must listen on all interfaces to be reachable from the frontend container (default is
# "localhost", which is loopback-only).
OPAA_SERVER_ADDRESS=0.0.0.0

# The address of the bootstrap administrator the backend seeds on its first start (ADR-0033,
# Entscheidung 5). It must not be the shipped default admin@opaa.local - LocalAdminSeeder rejects
# that value outright and seeds nothing, which would leave this stack with no way in at all.
OPAA_INITIAL_ADMIN_EMAIL=systemverwaltung@opaa.example
# The documented CI/automation path of Entscheidung 5: with the password given, the seed uses it
# and does **not** force a change - which is what lets a test sign in without first reading the
# one-time password out of the container log. The forced-change flow is covered by a *second*
# account the scenarios create through the admin API with an initial password (mode
# INITIAL_PASSWORD), so the forced change is exercised without making every other scenario walk
# through it first.
OPAA_INITIAL_ADMIN_PASSWORD=E2eNotankerKonto!2026

# Root secret of the local issuer (ADR-0033, Entscheidung 6): in the "oidc" mode the backend
# refuses to start without it, and it must be at least 32 characters and no known placeholder. A
# real deployment generates its own with `openssl rand -base64 48` (see .env.docker.example).
OPAA_AUTH_JWT_SECRET=local-auth-e2e-issuer-secret-not-for-production-0123456789

# The suite drives the stack over plain HTTP on localhost, so the refresh cookie cannot carry
# "Secure" - it would never be sent back. Exactly the case Entscheidung 7 allows this switch for;
# the backend logs a WARN line about it on every start in the "oidc" mode, and a scenario asserts
# that the cookie is HttpOnly/SameSite=Strict/Path=/api/v1/auth/local regardless.
OPAA_AUTH_LOCAL_COOKIE_SECURE=false

# Mail settings (host, port, credentials, encryption) are **not** environment variables - they live
# in mail_settings and are configured through the administration (ADR-0033, Entscheidung 10), which
# is what scenario 1 does against the stack's own mailpit. Storing the SMTP password needs the AES
# key of io.opaa.security.SettingsEncryptor: this stack activates "docker,oidc", not "dev", so
# application.yml's dev-only default does not apply. The value below IS that dev default,
# deliberately - a public, explicitly non-production test key (see .env.docker.example for the real
# thing).
OPAA_SETTINGS_ENCRYPTION_KEY=c2V0dGluZ3NkZXZrZXkwMHNldHRpbmdzZGV2a2V5MDE=

# Base URL for the links in mails (ADR-0033, Entscheidung 10) - a precondition of the invitation,
# reset and registration flows, and never taken from the request's Host header. It has to match the
# frontend's actual host port, which run-e2e.mjs controls, so it is set in
# e2e/docker-compose.local-auth.yml, not here - same reason OPAA_CORS_ALLOWED_ORIGINS lives there.

# The frontend's nginx forwards every API call, so X-Forwarded-For counts only from exactly that
# container - the fixed address run-e2e.mjs passes as OPAA_COMPOSE_FRONTEND_ADDRESS (ADR-0033,
# Entscheidung 9). Without it every browser request would share one rate-limit bucket with every
# other, and scenario 4's five deliberate failed sign-ins would collide with scenario 2's.
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.31.0.10/32

# Same reasoning as e2e/e2e.env and e2e/demo-smoke.env: "openai" names the wire protocol (see
# application.yml), and the address points at ai-stub (e2e/ai-stub/server.mjs), not an external
# endpoint and not application.yml's own default (a locally operated Ollama server). No scenario of
# this target asks a chat question; the stub is here because Spring AI's PgVectorStore can probe the
# embedding provider's dimension while the backend starts. Deliberately no OPAA_OPENAI_API_KEY, for
# the same reason as in demo-smoke.env (#771): with a key, LlmModelSeeder would treat it as real and
# try to encrypt it.
OPAA_OPENAI_BASE_URL=http://ai-stub:8089

OPAA_DB_USERNAME=opaa
OPAA_DB_PASSWORD=opaa
