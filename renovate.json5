// Renovate-Konfiguration für OPAA (Issue #751).
//
// Renovate läuft SELBST BETRIEBEN (lokal per Docker-Image oder als bewusst angestoßener
// Lauf) — der Mend-Cloud-Service ist ausdrücklich nicht im Einsatz, es ist keine GitHub-App
// installiert. Betriebsanleitung: docs/renovate.md
//
// Diese Datei ist Repository-Konfiguration; Laufzeitbelange (Token, Zielrepository,
// Dry-Run) kommen beim Aufruf über Umgebungsvariablen dazu.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    // Enthält u. a. die Monorepo-Gruppierungen (MUI, Vitest, testing-library, …) und
    // vernünftige Defaults für alle hier relevanten Manager: gradle (inkl.
    // libs.versions.toml), gradle-wrapper, npm/pnpm, github-actions, dockerfile,
    // docker-compose.
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',

  // Commit-Autor der Update-Branches (#924): Renovates Standard-Autor ist keinem
  // GitHub-Konto zugeordnet und fällt damit durch den CLA-Check (contributor-assistant
  // findet weder Unterschrift noch Allowlist-Treffer — "*[bot]" matcht nur echte
  // App-Bot-Logins). Die Noreply-Adresse ordnet die Commits dem PAT-Inhaber zu, der die
  // PRs ohnehin eröffnet und dessen CLA-Unterschrift vorliegt; der Anzeigename bleibt
  // ehrlich "Renovate Bot".
  gitAuthor: 'Renovate Bot <1293732+bigpuritz@users.noreply.github.com>',

  // Auto-Merge auf stehende Maintainer-Anweisung (#951): Renovate aktiviert beim Eröffnen
  // GitHubs nativen Auto-Merge (Squash) — gemergt wird erst, wenn die Required Checks grün
  // sind. Gilt für minor/patch/pin/digest; MAJOR-Updates sind seit #1002 ausgenommen (siehe
  // packageRule unten) und warten als normale PRs auf eine menschliche Entscheidung.
  // Achtung, bekannte Repo-Lage: e2e ist KEIN Required Check und hält den Merge daher
  // nicht auf (siehe #792).
  automerge: true,
  platformAutomerge: true,
  automergeStrategy: 'squash',

  // Projektsprache (AGENTS.md): Conventional-Commit-Typ und -Scope englisch, Beschreibung
  // deutsch. Ergibt z. B. "chore(deps): @mui/material auf 9.3.0 aktualisieren" — als
  // Commit-Nachricht und PR-Titel.
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  commitMessageAction: '',
  commitMessageTopic: '{{depName}}',
  commitMessageExtra: 'auf {{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{newValue}}{{/if}} aktualisieren',
  // Gruppen-PRs (Spring-Plattform, MUI-/ESLint-Monorepos, …) ersetzen das Topic durch den
  // Gruppennamen und verwerfen das Extra, sobald die Mitglieder verschiedene Zielversionen
  // haben — ohne diesen Block bliebe der Titel verblos („chore(deps): spring-plattform").
  // Extra wird hier immer geleert, damit das Suffix-Verb nie doppelt auftritt.
  group: {
    commitMessageTopic: '{{{groupName}}}',
    commitMessageExtra: '',
    commitMessageSuffix: 'aktualisieren',
  },
  // Deutscher Kopfsatz im sonst englischen Renovate-PR-Body (Projektsprache, AGENTS.md —
  // die dokumentierte Bot-Ausnahme dort erlaubt den englischen Rest).
  prHeader: 'Automatisches Abhängigkeits-Update durch Renovate (#751, siehe docs/renovate.md) — Prüfung und Merge folgen dem normalen Weg.',

  // Läuft täglich per .github/workflows/renovate.yml (zusätzlich manuell auslösbar): kein
  // Stundenlimit, aber eine Obergrenze gleichzeitig offener Update-PRs, damit weder der
  // Erstlauf noch ein Update-Schub das Repo flutet.
  prHourlyLimit: 0,
  prConcurrentLimit: 5,

  // Jeder PR trägt Labels (AGENTS.md); die Bereichszuordnung ergänzen die packageRules.
  labels: ['enhancement'],
  dependencyDashboardTitle: 'Abhängigkeits-Übersicht (Renovate)',
  dependencyDashboardLabels: ['ci'],

  // Vorgabeliste aus :ignoreModulesAndTests (via config:recommended) ohne "**/test/**",
  // "**/tests/**" und "**/examples/**": ignorePaths filtert die Dateiliste VOR jedem Manager, die
  // Image-Pins der Integrationssuiten liegen unter backend/src/test/ und die des
  // Kubernetes-Erprobungsaufbaus unter examples/. Die Liste ist eine Kopie — bei einem
  // Renovate-Major gegen das Preset abgleichen (docs/renovate.md).
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/__fixtures__/**',
  ],

  // Der kubernetes-Manager kennt kein Dateimuster von sich aus; er liest die Images der Hilfsdienste
  // des Erprobungsaufbaus (#2423). Die OPAA-Images dort setzt trial.sh, sie tragen keinen Pin.
  kubernetes: {
    managerFilePatterns: [
      'examples/kubernetes-trial/manifests/*.yaml',
      'examples/kubernetes-trial/jobs/*.yaml',
    ],
  },

  // Regex-Manager für Pins, die kein regulärer Manager sieht; jeder liest Datasource und Paket
  // aus einem "renovate:"-Kommentar direkt über der gepinnten Zeile (übliches Renovate-Muster).
  customManagers: [
    // Das S3-Testcontainer-Image (ADR-0027, #1382/#1949) ist als Java-Konstante gepinnt, für den
    // docker-Manager unsichtbar — der pflegt nur docker-compose.yml, wo dasselbe Image steht.
    // Der Tag ("1.0.0") ist reguläre docker-Versionierung und braucht kein eigenes Schema.
    {
      customType: 'regex',
      managerFilePatterns: ['backend/src/test/java/io/opaa/s3/S3TestFixture.java'],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*public static final String IMAGE = "[^:"]+:(?<currentValue>[^"]+)"',
      ],
    },
    // Das Keycloak-Testcontainer-Image (#1817) ist als Java-Konstante gepinnt, für den
    // docker-Manager unsichtbar — der pflegt nur docker-compose.yml. Ohne diesen Eintrag liefen
    // die beiden Pins desselben Images auseinander. Eigener matchString statt eines gemeinsamen
    // mit dem S3-Testimage: die Konstante ist package-private, und der Tag ("26.7") ist reguläre
    // docker-Versionierung, braucht also kein eigenes Schema.
    {
      customType: 'regex',
      managerFilePatterns: ['backend/src/test/java/io/opaa/integration/keycloak/KeycloakFixture.java'],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*static final String IMAGE = "[^:"]+:(?<currentValue>[^"]+)"',
      ],
    },
    // Das Nextcloud-Testcontainer-Image (#2152) ist als Java-Konstante gepinnt, für den
    // docker-Manager unsichtbar. Eigener matchString wie bei Keycloak: die Konstante ist
    // package-private, der Tag ("34.0.4-apache") ist reguläre docker-Versionierung mit Variante.
    {
      customType: 'regex',
      managerFilePatterns: ['backend/src/test/java/io/opaa/integration/nextcloud/NextcloudFixture.java'],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*static final String IMAGE = "[^:"]+:(?<currentValue>[^"]+)"',
      ],
    },
    // Das Samba-Testcontainer-Image des SMB-Konnektors (#2155) ist als Java-Konstante gepinnt, für
    // den docker-Manager unsichtbar. Gleicher matchString wie bei Keycloak und Nextcloud.
    {
      customType: 'regex',
      managerFilePatterns: ['backend/src/test/java/io/opaa/indexing/source/smb/SambaFixture.java'],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*static final String IMAGE = "[^:"]+:(?<currentValue>[^"]+)"',
      ],
    },
    // Der cdxgen-Aufruf in sbom.yml läuft über "pnpm dlx" statt über eine Manifestdatei — für den
    // github-actions-Manager unsichtbar.
    {
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/sbom.yml'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[\\s\\S]*?cdxgen@(?<currentValue>[^\\s]+)',
      ],
    },
    // Die Werkzeuge der Chart-Prüfung (#2355) und das Helm der Chart-Veröffentlichung (#2356) stehen
    // als Umgebungsvariable, Action-Eingabe oder Matrix-Eintrag direkt unter ihrem Kommentar. Die
    // älteste unterstützte Helm-3-Version trägt bewusst keinen Kommentar: Sie ist eine Zusage aus
    // ADR-0042, kein Stand zum Nachziehen.
    {
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/helm-chart.yml', '.github/workflows/publish-images.yml'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*(?:[A-Za-z_]+:|-)\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
    },
    // Das Renovate-Image selbst (#2433) startet renovate.yml per "docker run", den kein regulärer
    // Manager liest. Version und Index-Digest stehen in der Variable IMAGE unter dem Kommentar;
    // ein Update schreibt beide neu. test_renovate_image_pin.py prüft, dass der Ausdruck greift.
    {
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*IMAGE: [^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
    },
  ],

  packageRules: [
    // Bereichs-Labels nach Manager
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      addLabels: ['backend'],
    },
    {
      matchManagers: ['npm'],
      addLabels: ['frontend'],
    },
    // npm-Abhängigkeiten werden GEPINNT (Maintainer-Entscheidung, 25.08.2026): frontend/ und
    // e2e/ sind Anwendungen, keine Bibliotheken — exakte Versionen in der package.json machen
    // jeden Bump als PR sichtbar, statt ihn als stilles Lockfile-only-Update zu verstecken.
    // Bewusst auf dependencies/devDependencies begrenzt: engines bleibt eine Range (die
    // zulässigen Node-Linien), packageManager ist ohnehin exakt (Corepack-Hash).
    {
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies', 'devDependencies'],
      rangeStrategy: 'pin',
    },
    // pnpm 11 lehnt per Standard-Supply-Chain-Richtlinie npm-Releases ab, die jünger als
    // 24 h sind (ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION, #954) — Renovate wartet dieselbe
    // Frist ab, sonst sind PRs mit brandneuen Releases in CI und Docker-Build zwangsläufig
    // rot. Wer den Sicherheitsabstand erhöht, zieht pnpm- und Renovate-Wert gemeinsam hoch.
    {
      matchManagers: ['npm'],
      minimumReleaseAge: '1 day',
    },
    // jsdom 30.1 no longer exposes the impl symbol that Vitest's jsdom environment reads to
    // convert Blob/File/FormData request bodies - every upload test throws. Hold jsdom below
    // 30.1 until the upstream fix (vitest-dev/vitest#11336) ships, then drop this rule.
    {
      matchPackageNames: ['jsdom'],
      allowedVersions: '<30.1.0',
    },
    // Gleichzeitige Lockfile-Updates gegen semantische Merge-Brueche absichern (#1000,
    // Fehlerbild #996): Am 28.08.2026 mergten mehrere npm-Update-PRs per Auto-Merge
    // nacheinander, jeder auf dem Stand VOR den jeweils anderen gruen - die textuell
    // konfliktfreie Vereinigung der pnpm-lock.yaml war semantisch inkonsistent und brach
    // jeden folgenden "pnpm install --frozen-lockfile". Zwei Mechanismen zusammen:
    //
    // 1. Non-Major-npm-Updates laufen als EIN Sammel-PR je Lauf - eine Lockfile-Aenderung,
    //    nichts zu verschraenken. Majors bleiben einzelne PRs (und mergen ohnehin nicht
    //    automatisch, #1002).
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'npm (non-major)',
    },
    // 2. Der Merge selbst passiert Renovate-seitig statt ueber GitHubs nativen Auto-Merge:
    //    GitHub merged auch einen hinter main liegenden Branch, sobald dessen (alte) Checks
    //    gruen sind - genau die #996-Luecke. Renovate dagegen rebased einen Branch, sobald
    //    er hinter main liegt (rebaseWhen), und merged erst im Folgelauf, wenn der Branch
    //    aktuell UND gruen ist. npm-Merges passieren dadurch nur waehrend Renovate-Laeufen
    //    (taeglich 06:23 bzw. manuell) - der bewusste Preis fuer einen konsistenten Lockfile.
    {
      matchManagers: ['npm'],
      rebaseWhen: 'behind-base-branch',
      platformAutomerge: false,
    },
    // helmv3 und helm-values lesen den Chart unter deploy/helm/opaa (#2356): Chart.yaml-Abhängigkeiten
    // (derzeit keine) und die Images in values.yaml mit festem Tag.
    {
      matchManagers: ['github-actions', 'dockerfile', 'docker-compose', 'helmv3', 'helm-values'],
      addLabels: ['ci'],
    },
    // Die customManagers oben firmieren als "custom.regex"; ohne diese Regel trügen ihre PRs nur
    // das Basislabel. Alle drei pflegen Werkzeug- und Container-Pins des Baus, nicht Anwendungscode.
    {
      matchManagers: ['custom.regex'],
      addLabels: ['ci'],
    },
    // Nebenfunde der Erkennung: die Seed-/Generator-Requirements der Demo und frontend/.nvmrc
    {
      matchManagers: ['pip_requirements'],
      addLabels: ['demo'],
    },
    {
      matchManagers: ['nvm'],
      addLabels: ['frontend'],
    },
    // Spring Boot, Spring Framework und Spring AI bewegen sich zusammen — ein PR statt
    // dreier, die einzeln ohnehin nicht baubar wären (Issue #751). Trifft Koordinaten UND
    // Plugin-IDs unter org.springframework.*; io.spring.dependency-management versioniert
    // unabhängig und bleibt bewusst außen vor.
    {
      groupName: 'Spring-Plattform',
      matchPackageNames: ['org.springframework{/,}**'],
    },
    // config:recommended zieht :semanticPrefixFixDepsChoreOthers nach, das produktive
    // Abhängigkeiten (depType "dependencies" — darunter ALLE libs.versions.toml-Einträge)
    // auf fix(deps) umstellt, und mergeConfidence-Badges, deren Spalten je Abhängigkeit
    // Mend-URLs in den PR-Body einbetten. Beides hier bewusst zurückgedreht: einheitlich
    // chore(deps) (Issue #751) und ein Body ohne Aufrufe an den Mend-Dienst.
    {
      matchPackageNames: ['*'],
      semanticCommitType: 'chore',
      prBodyColumns: ['Package', 'Type', 'Update', 'Change'],
    },
    // Docker-Basisimages sind im Projekt BEWUSST gleitende Tags (node:22-alpine,
    // nginxinc/nginx-unprivileged:alpine, pgvector/pgvector:pg18, eclipse-temurin:21-jdk — siehe Kommentar in
    // e2e/docker-compose.e2e.yml zu PR #453). pinDigests: false ist derzeit ohnehin der
    // Default; die Regel schreibt die Entscheidung fest, damit ein künftiger Preset- oder
    // Renovate-Wechsel sie nicht still kippt. Major-Tag-Wechsel (z. B. node 22 → 24)
    // kommen weiterhin als PR.
    {
      matchDatasources: ['docker'],
      pinDigests: false,
    },
    // Ausnahme von der Regel darüber (#2433): Das Renovate-Image in renovate.yml bekommt das
    // Token mit repo- und workflow-Recht und trägt deshalb Version und Digest. Den vorhandenen
    // Digest pflegt Renovate auch so; pinDigests: true hält die Ausnahme hier ausdrücklich fest.
    // Ein neues Release wird erst nach drei Tagen vorgeschlagen, wie bei den gepinnten Actions,
    // und nie automatisch gemergt.
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['.github/workflows/renovate.yml'],
      matchDepNames: ['renovate/renovate'],
      pinDigests: true,
      minimumReleaseAge: '3 days',
      automerge: false,
    },
    // Ein neuer Digest bei gleicher Version heißt, dass der Tag umgehängt wurde. Renovate legt
    // dafür erst nach Freigabe in der Abhängigkeits-Übersicht einen Branch an.
    {
      matchManagers: ['custom.regex'],
      matchFileNames: ['.github/workflows/renovate.yml'],
      matchDepNames: ['renovate/renovate'],
      matchUpdateTypes: ['digest'],
      dependencyDashboardApproval: true,
    },
    // Major-Updates mergen generell nicht automatisch (#1002): Auto-Merge greift, sobald die
    // Required Checks grün sind — Brüche, die nur ein Nicht-Required-Check (e2e) oder gar kein
    // Check zeigt, rutschen bei Majors sonst unbeaufsichtigt durch (so geschehen mit
    // eclipse-temurin v25, JUnit und pnpm/action-setup am 28.08.2026). Majors bleiben als PR
    // zur menschlichen Entscheidung offen; Ablehnung durch Schließen des PRs (Renovate merkt
    // sich das). Die folgenden enabled:false-Regeln setzen einzelne, aktuell bekannt
    // inkompatible Majors darüber hinaus ganz aus.
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // Die beiden Images des Objektspeichers (#1949) werden nie automatisch gemergt, weil ihr
    // Nachweis erst nach dem Merge läuft: S3TestFixture.IMAGE spricht neben der S3-API auch die
    // Admin-API von rustfs an, die kein Standard ist, und amazon/aws-cli führt die Seed-Schritte
    // des Demo-Stacks aus, die allein die nightly demo-smoke prüft. Ein Vorschlag bleibt als PR
    // zur Entscheidung.
    {
      matchPackageNames: ['rustfs/rustfs', 'amazon/aws-cli'],
      automerge: false,
    },
    // Das Keycloak-Image wird nie automatisch gemergt: Der Tag steckt in KeycloakFixture.IMAGE und
    // im Compose-Stack, geprüft wird er aber nur von keycloakIntegrationTest — einer Suite, die
    // nightly und per Label läuft und kein Required Check ist. Auto-Merge würde ein inkompatibles
    // Image also unbeaufsichtigt auf main lassen; ein Vorschlag bleibt als PR zur Entscheidung.
    {
      matchPackageNames: ['quay.io/keycloak/keycloak'],
      automerge: false,
    },
    // Den Erprobungsaufbau unter examples/ prüft keine CI; ein Bump seiner Hilfsdienste wird lokal
    // mit "trial.sh up" belegt (examples/kubernetes-trial/README.md) und nie automatisch gemergt.
    {
      matchManagers: ['kubernetes'],
      addLabels: ['ci'],
      automerge: false,
    },
    // Die Werkzeuge der Chart-Prüfung prüft nur der Helm-Workflow, und der ist kein Required
    // Check. Ein Bump, der etwa nicht zur gepinnten chart-testing-action oder zum kind-Node-Image
    // passt, bliebe sonst unbeaufsichtigt auf main; ein Vorschlag bleibt als PR zur Entscheidung.
    {
      matchFileNames: ['.github/workflows/helm-chart.yml'],
      automerge: false,
    },
    // Das Helm der Chart-Veröffentlichung läuft nur bei einem Release-Tag, kein PR prüft es; ein
    // Vorschlag bleibt deshalb ebenfalls als PR zur Entscheidung.
    {
      matchFileNames: ['.github/workflows/publish-images.yml'],
      matchDepNames: ['helm/helm'],
      automerge: false,
    },
    // Helm 4 in beiden Workflows pflegt der eigene Regex-Manager (customManagers oben); ohne diese
    // Regel schlüge der github-actions-Manager denselben Bump über setup-helm ein zweites Mal vor.
    {
      matchManagers: ['github-actions'],
      matchDepNames: ['helm'],
      matchFileNames: ['.github/workflows/helm-chart.yml', '.github/workflows/publish-images.yml'],
      enabled: false,
    },
    // Alle Workflows pinnen ihre Actions auf den Commit-SHA mit exaktem Versionskommentar (#2397,
    // #2432, docs/renovate.md); Renovate pflegt beides gemeinsam. Ein neues Release wird erst nach
    // drei Tagen vorgeschlagen; vorher entsteht kein Branch, also auch kein PR-Lauf. Beide Regeln
    // gelten ohne Dateiliste, wie .github/scripts/check_action_pins.sh; test_check_action_pins.py
    // prüft das.
    {
      matchManagers: ['github-actions'],
      matchDepTypes: ['action'],
      pinDigests: true,
      minimumReleaseAge: '3 days',
    },
    // Ein neuer SHA bei unveränderter Version heißt: Der Tag wurde umgehängt. Genau das ist der
    // Angriff, gegen den die Pins schützen. Renovate legt dafür erst nach Freigabe in der
    // Abhängigkeits-Übersicht einen Branch an, denn cve-scan.yml und dependency-graph.yml laufen
    // schon im PR mit Schreibrechten.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['digest'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    // Die Actions der Veröffentlichung übt kein Required Check aus, sie laufen aber bei jedem Push
    // auf main mit packages: write. Ihre Updates mergen deshalb nie automatisch.
    {
      matchManagers: ['github-actions'],
      matchFileNames: ['.github/workflows/publish-images.yml'],
      automerge: false,
    },
    // Temurin-Major bleibt aus, bis die Projekt-Toolchain nachzieht (#1001): build.gradle.kts
    // pinnt die Java-Toolchain auf 21, und im 25-jdk-Image findet Gradle kein JDK 21
    // (Auto-Provisioning ist aus) — der Automerge von #988 hat den Backend-Image-Build und
    // damit E2E/Publish Images auf main gebrochen. Der Wechsel auf Temurin 25 kommt als
    // bewusste Toolchain-Migration (eigenes Issue), nicht als Dependency-Bump.
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['eclipse-temurin'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Debian-Major bleibt aus (#1459): backend/Dockerfile kopiert die kompilierte glibc-Locale
    // C.utf8 aus debian:13-slim in ein gcr.io/distroless/base-nossl-debian13. Das Locale-Format
    // ist glibc-versionsabhängig, und die Debian-Version des Distroless-Images steckt im
    // Imagenamen, den die docker-Versionierung nicht als Update sieht. Ein isolierter Bump auf
    // debian:14-slim bräche also nicht den Build, sondern ließe die JVM still auf
    // ANSI_X3.4-1968 zurückfallen — Dateinamen mit Umlauten wären unlesbar. Beide Stände wandern
    // gemeinsam, von Hand.
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['debian'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Tika-4-Major bleibt aus, bis Spring AI nachzieht (#1005): tika-core kommt hier nur als
    // explizite Deklaration der ohnehin transitiven Version aus spring-ai-tika-document-reader.
    // Ein isolierter Bump auf 4.x kombiniert tika-core 4 mit den Tika-3-Parsern der
    // Spring-AI-BOM und bricht die Format-Erkennung breit (#992: backend/e2e rot). Tika 4
    // kommt, wenn Spring AI seine Tika-Abhaengigkeit auf 4.x hebt - dann Regel entfernen.
    {
      matchPackageNames: ['org.apache.tika:tika-core'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Der MCP-Starter kommt als eigener PR und mergt nie automatisch (#1721, ADR-0035): Er bringt
    // mcp-core mit, und mcp-core entscheidet, welche MCP-Protokollfassungen diese Installation
    // spricht. Ein Wechsel ist damit keine Abhängigkeitsaktualisierung, sondern eine
    // Protokolländerung — und weil es genau einen Server gibt, fallen bei einem Bruch alle
    // Fremdzugänge des Hauses zugleich aus. Die angekündigte Fassungsliste
    // (opaa.mcp.protocol-versions) ist bei jedem Vorschlag gegen die Fassungen zu prüfen, die die
    // neue Bibliothek tatsächlich bedient. Der eigene groupName hebt ihn aus dem Sammel-PR der
    // Spring-Plattform heraus; mcp-core selbst steht in keinem Katalog und ist für Renovate
    // unsichtbar — der Starter ist der einzige Hebel.
    {
      matchPackageNames: ['org.springframework.ai:spring-ai-starter-mcp-server-webmvc'],
      groupName: 'MCP-Server',
      automerge: false,
    },
    // TypeScript-7-Major bleibt aus, bis typescript-eslint nachzieht (#1007): 8.68.0 bricht
    // mit "typescript-eslint does not support TS 7.0" ab (Upstream-Tracking:
    // typescript-eslint/typescript-eslint#10940, Support ab TS >= 7.1). 6.x-Updates laufen
    // weiter; Regel entfernen, sobald Upstream TS 7 traegt.
    {
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
