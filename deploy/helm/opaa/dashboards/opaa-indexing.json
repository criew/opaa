  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "Bibliotheken überfällig",
      "description": "Bibliotheken mit Zeitplan, deren letzter erfolgreicher Lauf länger als zwei ihrer Intervalle zurückliegt. Nur Anzahl; welche, zeigt der Laufstatus der Bibliotheken.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max by (connector) (opaa_indexing_libraries_overdue{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"})) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#11774F",
                "value": null
              },
              {
                "color": "#8F5A00",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
