    {
      "id": 102,
      "type": "stat",
      "title": "Läufe gescheitert (6 h)",
      "description": "Anteil gescheiterter Läufe in sechs Stunden, schlechtester Konnektortyp, ab 4 Läufen. Einzelne defekte Dateien zählen nicht.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max(sum by (connector) (increase(opaa_indexing_runs_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"failed\"}[6h])) / sum by (connector) (increase(opaa_indexing_runs_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"}[6h])) and sum by (connector) (increase(opaa_indexing_runs_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"}[6h])) >= 4)) or on() vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#11774F",
