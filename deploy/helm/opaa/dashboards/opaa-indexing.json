            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(time() - max by (connector) (opaa_indexing_run_last_success_seconds{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"})) / 3600",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
