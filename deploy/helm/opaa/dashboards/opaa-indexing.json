        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (connector) (opaa_indexing_libraries_overdue{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (connector) (increase(opaa_indexing_runs_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"}[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (connector) (increase(opaa_indexing_runs_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"failed\"}[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (connector) (increase(opaa_indexing_documents_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"processed\"}[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (connector, le) (rate(opaa_indexing_run_duration_seconds_bucket{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"completed\"}[24h])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
