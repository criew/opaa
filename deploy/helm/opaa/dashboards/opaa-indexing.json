      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "#0B6FBC",
        "name": "Neuer Pod oder Neustart",
        "expr": "count by (host) (process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"} unless process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"} offset 2m) or count by (host) (changes(process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"}[2m]) > 0)",
        "step": "60s",
        "titleFormat": "Start {{host}}",
        "textFormat": "Pod neu oder neu gestartet (Rolling Update, Skalierung oder Absturz)",
        "tagKeys": "host",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Neue Version",
        "expr": "count by (version) (opaa_build_info{namespace=~\"$namespace\", host=~\"$host\"} unless on(version) opaa_build_info{namespace=~\"$namespace\", host=~\"$host\"} offset 2m)",
        "step": "60s",
        "titleFormat": "Version {{version}}",
        "textFormat": "Die erste Instanz dieser Version ist gestartet",
        "tagKeys": "version",
        "useValueForTime": false
      }
    ]
  },
