            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_rate_limit_rejected_total{namespace=~\"$namespace\", host=~\"$host\", scope=\"global\"}[24h]))",
          "legendFormat": "globale Grenze",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_auth_local_account_lockout_total{namespace=~\"$namespace\", host=~\"$host\"}[24h]))",
          "legendFormat": "Kontosperren",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_external_access_alarms_total{namespace=~\"$namespace\", host=~\"$host\"}[24h]))",
          "legendFormat": "Massenabrufe",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_target_validation_refused_checks_total{namespace=~\"$namespace\", host=~\"$host\"}[24h]))",
          "legendFormat": "Ziele abgelehnt",
          "range": false,
          "instant": true,
          "editorMode": "code"
