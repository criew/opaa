    {
      "id": 501,
      "type": "stat",
      "title": "Nachweispflichten",
      "description": "Prüfsummenkette: Rückstand (Schwelle 6 h). Monate ohne Siegel. Ausleitung an das Sicherheitsmonitoring: Rückstand. Letzter Löschlauf (Schwelle 35 Tage). Protokollhorizont: Zeit, bis das Revisionsprotokoll nicht mehr schreiben kann.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_audit_chain_lag_seconds{namespace=~\"$namespace\", host=~\"$host\"}) / 60",
          "legendFormat": "Prüfsummenkette Rückstand",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_audit_chain_unsealed_months{namespace=~\"$namespace\", host=~\"$host\"})",
          "legendFormat": "Monate ohne Siegel",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_siem_export_lag_seconds{namespace=~\"$namespace\", host=~\"$host\"}) / 60",
          "legendFormat": "SIEM-Rückstand",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_audit_retention_last_run_age_seconds{namespace=~\"$namespace\", host=~\"$host\"}) / 86400",
          "legendFormat": "Löschlauf vor",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_audit_log_horizon_seconds{namespace=~\"$namespace\", host=~\"$host\"}) / 86400",
          "legendFormat": "Protokollhorizont",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
