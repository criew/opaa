    {
      "id": 502,
      "type": "stat",
      "title": "Schutzfunktionen (24 h)",
      "description": "Virenfunde, gescheiterte Virenprüfungen, Alter der Virensignaturen, Abweisungen an einer installationsweiten Grenze, Sperren lokaler Konten, Alarme für Massenabrufe externer Zugänge und abgelehnte neue Ziele der Zielprüfung.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_malware_scans_seconds_count{namespace=~\"$namespace\", host=~\"$host\", result=\"infected\"}[24h]))",
          "legendFormat": "Virenfunde",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_malware_scans_seconds_count{namespace=~\"$namespace\", host=~\"$host\", result=\"failed\"}[24h]))",
          "legendFormat": "Prüfung gescheitert",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_malware_signatures_age_seconds{namespace=~\"$namespace\", host=~\"$host\"}) / 3600",
