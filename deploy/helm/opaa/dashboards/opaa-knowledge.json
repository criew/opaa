        "query": {
          "query": "label_values(opaa_indexing_runs_total{namespace=~\"$namespace\"}, connector)",
          "refId": "v"
        },
        "definition": "label_values(opaa_indexing_runs_total{namespace=~\"$namespace\"}, connector)",
        "refresh": 2,
