  "panels": [
    {
      "id": 301,
      "type": "stat",
      "title": "Bestand",
      "description": "Bibliotheken, Dokumente und Abschnitte der ganzen Installation. Werte privater Bibliotheken zählen erst ab der Mindestgruppengröße mit; ein unlesbarer Wert fehlt in der Summe.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max by (kind) (opaa_inventory_libraries{namespace=~\"$namespace\", host=~\"$host\"}) >= 0)",
          "legendFormat": "Bibliotheken",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max by (kind) (opaa_inventory_documents{namespace=~\"$namespace\", host=~\"$host\"}) >= 0)",
          "legendFormat": "Dokumente",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max by (kind) (opaa_inventory_chunks{namespace=~\"$namespace\", host=~\"$host\"}) >= 0)",
          "legendFormat": "Abschnitte",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(opaa_inventory_spaces{namespace=~\"$namespace\", host=~\"$host\"})",
          "legendFormat": "geteilte Spaces",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {}
      }
    },
    {
      "id": 302,
      "type": "stat",
      "title": "Aktualität",
      "description": "Überfällige Bibliotheken, Dokumente des Zeitraums und nicht verarbeitbare Dokumente.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(max by (connector) (opaa_indexing_libraries_overdue{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\"})) or vector(0)",
          "legendFormat": "überfällig",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_indexing_documents_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"processed\"}[$__range]))",
          "legendFormat": "neu oder geändert",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_indexing_documents_total{namespace=~\"$namespace\", host=~\"$host\", connector=~\"$connector\", result=\"failed\"}[$__range]))",
          "legendFormat": "nicht verarbeitbar",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
