          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(opaa_build_info{namespace=~\"$namespace\"}, host)",
          "refId": "v"
        },
        "definition": "label_values(opaa_build_info{namespace=~\"$namespace\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
