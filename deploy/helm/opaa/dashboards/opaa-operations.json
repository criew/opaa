    {
      "id": 203,
      "type": "stat",
      "title": "Hintergrund",
      "description": "Überfällige geplante Läufe, Warteschlangen über ihrer Schwelle, letzter angewendeter Verzeichnisabgleich, Pods ohne Cache-Meldungen.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count((time() - max by (job) (opaa_scheduled_last_success{namespace=~\"$namespace\", host=~\"$host\", job!~\"audit-chain|audit-retention\"})) > on(job) (3 * max by (job) (opaa_scheduled_expected_interval_seconds{namespace=~\"$namespace\", host=~\"$host\"})) and (time() - max by (job) (opaa_scheduled_last_success{namespace=~\"$namespace\", host=~\"$host\", job!~\"audit-chain|audit-retention\"})) > 900) or vector(0)",
          "legendFormat": "Läufe überfällig",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(max by (queue) (opaa_queue_oldest_age_seconds{namespace=~\"$namespace\", host=~\"$host\", queue=\"indexing\"}) > 7200 or max by (queue) (opaa_queue_oldest_age_seconds{namespace=~\"$namespace\", host=~\"$host\", queue=\"mail_outbox\"}) > 1800 or max by (queue) (opaa_queue_oldest_age_seconds{namespace=~\"$namespace\", host=~\"$host\", queue=\"ocr_backlog\"}) > 21600 or max by (queue) (opaa_queue_oldest_age_seconds{namespace=~\"$namespace\", host=~\"$host\", queue=\"source_events\"}) > 3600) or vector(0)",
          "legendFormat": "Warteschlangen im Verzug",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(time() - max(opaa_directory_sync_last_success_seconds{namespace=~\"$namespace\", host=~\"$host\", provider!=\"none\"})) / 3600",
          "legendFormat": "Abgleich angewendet vor",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(opaa_invalidation_bus_connected{namespace=~\"$namespace\", host=~\"$host\"} == 0) or vector(0)",
          "legendFormat": "Pods ohne Cache-Meldungen",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#11774F",
                "value": null
              },
              {
                "color": "#8F5A00",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Abgleich angewendet vor"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#11774F",
                      "value": null
                    },
                    {
                      "color": "#8F5A00",
                      "value": 26
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
