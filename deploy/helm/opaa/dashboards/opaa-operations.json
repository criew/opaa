              {
                "color": "#11774F",
                "value": 0
              },
              {
                "color": "#8F5A00",
                "value": 1
              },
              {
                "color": "#CE2C31",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "keine Daten",
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 15
        }
      }
    },
    {
      "id": 202,
      "type": "stat",
      "title": "Nutzerseite",
      "description": "Anteil beantworteter Fragen in der letzten Stunde (ab 30 Fragen; abgewiesene Fragen zählen nicht) und Zeit bis zum ersten Wort (p95, 30 min).",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(((sum(increase(opaa_query_count_total{namespace=~\"$namespace\", host=~\"$host\", status=\"success\"}[1h])) / sum(increase(opaa_query_count_total{namespace=~\"$namespace\", host=~\"$host\", status=~\"success|error\"}[1h]))) and on() ((sum(increase(opaa_query_count_total{namespace=~\"$namespace\", host=~\"$host\", status=~\"success|error\"}[1h]))) >= 30))) or on() vector(-1)",
          "legendFormat": "Fragen beantwortet",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(((histogram_quantile(0.95, sum by (le) (rate(opaa_query_time_to_first_token_seconds_bucket{namespace=~\"$namespace\", host=~\"$host\"}[30m])))) and on() ((sum(increase(opaa_query_time_to_first_token_seconds_count{namespace=~\"$namespace\", host=~\"$host\"}[30m]))) >= 30))) or on() vector(-1)",
          "legendFormat": "Erstes Wort (p95)",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#CE2C31",
                "value": null
              },
              {
                "color": "#8F5A00",
                "value": 0.9279999999999999
              },
              {
                "color": "#11774F",
                "value": 0.97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "wenig Verkehr",
                  "color": "#5A6270",
                  "index": 0
                }
              }
            }
          ],
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Erstes Wort (p95)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "wenig Verkehr",
                        "color": "#5A6270",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#5A6270",
                      "value": null
                    },
                    {
                      "color": "#11774F",
                      "value": 0
                    },
                    {
                      "color": "#8F5A00",
