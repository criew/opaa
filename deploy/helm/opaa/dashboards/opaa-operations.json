  "panels": [
    {
      "id": 201,
      "type": "stat",
      "title": "Bausteine",
      "description": "Je Baustein ein Zustand. Backend und Frontend: bereite Pods gegen Soll (Teilausfall: prüfen). Datenbank: Readiness und Wartezeiten im Connection Pool. Anmeldedienst: abgelehnte Aufrufe an Identitätsanbieter und Verzeichnisdienst. Modellrollen: erreichbar für mindestens einen Pod; nicht eingerichtete Rollen sind grau.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(label_replace((((2 * (sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-backend\"}) == bool 0)) + ((sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-backend\"}) < bool sum(kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\".+-backend\"})) * (sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-backend\"}) > bool 0))) and on() (sum(kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\".+-backend\"}) > 0)) > 0, \"k\", \"s0\", \"\", \"\") or label_replace((2 * (max(up{namespace=~\"$namespace\", service=~\".+-backend\"}) == bool 0)) > 0, \"k\", \"s1\", \"\", \"\") or label_replace((vector(0)), \"k\", \"base\", \"\", \"\"))",
          "legendFormat": "Backend",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(((2 * (sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-frontend\"}) == bool 0)) + ((sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-frontend\"}) < bool sum(kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\".+-frontend\"})) * (sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".+-frontend\"}) > bool 0))) and on() (sum(kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\".+-frontend\"}) > 0)) or on() vector(-1)",
          "legendFormat": "Frontend",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(label_replace((2 * (max(opaa_health_group_status{namespace=~\"$namespace\", host=~\"$host\", health_group=\"readiness\"}) == bool 0)) > 0, \"k\", \"s0\", \"\", \"\") or label_replace((sum(increase(hikaricp_connections_timeout_total{namespace=~\"$namespace\", host=~\"$host\"}[10m])) > bool 0) > 0, \"k\", \"s1\", \"\", \"\") or label_replace((vector(0)), \"k\", \"base\", \"\", \"\"))",
          "legendFormat": "Datenbank",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(2 * max((sum by (target) (increase(opaa_outbound_requests_seconds_count{namespace=~\"$namespace\", host=~\"$host\", target=~\"oidc|directory\", outcome=\"auth_error\"}[10m])) / sum by (target) (increase(opaa_outbound_requests_seconds_count{namespace=~\"$namespace\", host=~\"$host\", target=~\"oidc|directory\"}[10m])) > bool 0.5) and sum by (target) (increase(opaa_outbound_requests_seconds_count{namespace=~\"$namespace\", host=~\"$host\", target=~\"oidc|directory\"}[10m])) >= 10)) or on() vector(0)",
          "legendFormat": "Anmeldedienst",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(2 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"chat\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Chat-Modell",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(2 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"embedding\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Embedding",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"rerank\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Rerank",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"ocr\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Texterkennung",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"transcription\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Transkription",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"vision\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Bildverstehen",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "nicht eingerichtet",
                  "color": "#5A6270",
