    {
      "id": 204,
      "type": "timeseries",
      "title": "Antwortzeit je Route (p95)",
      "description": "95. Perzentil der HTTP-Antwortzeit je Route. Gestreamte Chat-Antworten stehen unter Zeit bis zum ersten Wort.",
      "gridPos": {
