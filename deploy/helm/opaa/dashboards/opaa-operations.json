          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 205,
      "type": "timeseries",
      "title": "Fehlerantworten (5xx) je Pod",
      "description": "HTTP-Antworten mit Status 5xx pro Minute.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
