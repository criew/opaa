{
  "uid": "opaa-models",
  "title": "OPAA · KI-Modelle & Kosten",
  "description": "Bereich Modelle: Erreichbarkeit, Antwortzeit, Drosselung, Tokens und Kosten. Kosten nur hier.",
  "tags": [
    "opaa"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "#0B6FBC",
        "name": "Neuer Pod oder Neustart",
        "expr": "count by (host) (process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"} unless process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"} offset 2m) or count by (host) (changes(process_start_time_seconds{namespace=~\"$namespace\", host=~\"$host\"}[2m]) > 0)",
        "step": "60s",
        "titleFormat": "Start {{host}}",
        "textFormat": "Pod neu oder neu gestartet (Rolling Update, Skalierung oder Absturz)",
        "tagKeys": "host",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Neue Version",
        "expr": "count by (version) (opaa_build_info{namespace=~\"$namespace\", host=~\"$host\"} unless on(version) opaa_build_info{namespace=~\"$namespace\", host=~\"$host\"} offset 2m)",
        "step": "60s",
        "titleFormat": "Version {{version}}",
        "textFormat": "Die erste Instanz dieser Version ist gestartet",
        "tagKeys": "version",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "OPAA",
      "type": "dashboards",
      "tags": [
        "opaa"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datenquelle",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(opaa_build_info, namespace)",
          "refId": "v"
        },
        "definition": "label_values(opaa_build_info, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "host",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(opaa_build_info{namespace=~\"$namespace\"}, host)",
          "refId": "v"
        },
        "definition": "label_values(opaa_build_info{namespace=~\"$namespace\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "runbook",
        "type": "constant",
        "query": "https://opaa.io/handbuch/betrieb/alarme.html",
        "hide": 2,
        "current": {
          "text": "https://opaa.io/handbuch/betrieb/alarme.html",
          "value": "https://opaa.io/handbuch/betrieb/alarme.html"
        }
      },
      {
        "name": "model",
        "label": "Modell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(opaa_model_tokens_total{namespace=~\"$namespace\"}, model)",
          "refId": "v"
        },
        "definition": "label_values(opaa_model_tokens_total{namespace=~\"$namespace\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "price_input",
        "label": "Preis Eingabe (€ je 1 Mio. Tokens)",
        "type": "textbox",
        "query": "0",
        "hide": 0,
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "name": "price_output",
        "label": "Preis Ausgabe (€ je 1 Mio. Tokens)",
        "type": "textbox",
        "query": "0",
        "hide": 0,
        "current": {
          "text": "0",
          "value": "0"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 401,
      "type": "stat",
      "title": "Modellrollen",
      "description": "Erreichbarkeit je Rolle für mindestens einen Pod. Nicht eingerichtete Rollen sind grau.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(2 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"chat\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Chat-Modell",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(2 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"embedding\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Embedding",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"rerank\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Rerank",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"ocr\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Texterkennung",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"transcription\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Transkription",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 * (max(opaa_model_role_available{namespace=~\"$namespace\", host=~\"$host\", role=\"vision\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Bildverstehen",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "nicht gemessen",
                  "color": "#5A6270",
                  "index": 4
                },
                "-1": {
                  "text": "nicht eingerichtet",
                  "color": "#5A6270",
                  "index": 0
                },
                "0": {
                  "text": "in Ordnung",
                  "color": "#11774F",
                  "index": 1
                },
                "1": {
                  "text": "prüfen",
                  "color": "#8F5A00",
                  "index": 2
                },
                "2": {
                  "text": "gestört",
                  "color": "#CE2C31",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5A6270",
                "value": null
              },
              {
                "color": "#11774F",
                "value": 0
              },
              {
                "color": "#8F5A00",
                "value": 1
              },
              {
                "color": "#CE2C31",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "keine Daten",
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 16
        }
      }
    },
    {
      "id": 402,
      "type": "stat",
      "title": "Steuerung (gewählter Zeitraum)",
      "description": "Tokens des Chat-Modells und daraus berechnete Kosten. Die Kosten rechnet Grafana aus den Preisen oben (Euro je eine Million Tokens); OPAA speichert keine Kosten.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"input\"}[$__range]))) + (sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"output\"}[$__range])))) / 1e6",
          "legendFormat": "Tokens",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"input\"}[$__range]))) * $price_input + (sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"output\"}[$__range]))) * $price_output) / 1e6",
          "legendFormat": "Kosten",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"input\"}[$__range]))) * $price_input + (sum(increase(opaa_model_tokens_total{namespace=~\"$namespace\", host=~\"$host\", model=~\"$model\", token_type=\"output\"}[$__range]))) * $price_output) / 1e6 / ($__range_s / 86400) * 30",
          "legendFormat": "Hochrechnung 30 Tage",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(opaa_outbound_throttled_total{namespace=~\"$namespace\", host=~\"$host\"}[$__range]))",
          "legendFormat": "gedrosselt",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Kosten"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hochrechnung 30 Tage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: Mio."
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gedrosselt"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {}
      }
    },
    {
      "id": 403,
      "type": "timeseries",
      "title": "Antwortzeit der Chat- und Embedding-Modelle (p95)",
      "description": "95. Perzentil der Aufrufdauer je Operation und Modell, nur zur Anzeige.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (gen_ai_operation_name, gen_ai_request_model, le) (rate(gen_ai_client_operation_seconds_bucket{namespace=~\"$namespace\", host=~\"$host\"}[10m])))",
          "legendFormat": "{{gen_ai_operation_name}} {{gen_ai_request_model}}",
          "range": true,
