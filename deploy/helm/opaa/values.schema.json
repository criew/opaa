{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OPAA Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publicBaseUrl",
    "database",
    "embedding",
    "bootstrap",
    "secrets",
    "uploads"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluationDatabase": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "database": {
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uploads": {
            "properties": {
              "store": {
                "const": "s3"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uploads": {
            "properties": {
              "s3": {
                "required": [
                  "endpoint",
                  "bucket"
                ],
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "pattern": "^https?://\\S+$"
                  },
                  "bucket": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uploads": {
            "properties": {
              "store": {
                "const": "s3"
              }
            }
          },
          "secrets": {
            "properties": {
              "existingSecret": {
                "const": ""
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "secrets": {
            "required": [
              "s3AccessKey",
              "s3SecretKey"
            ],
            "properties": {
              "s3AccessKey": {
                "type": "string",
                "minLength": 1
              },
              "s3SecretKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rerank": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rerank": {
            "required": [
              "baseUrl",
              "model"
            ],
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transcription": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "transcription": {
            "required": [
              "baseUrl",
              "model"
            ],
            "properties": {
              "baseUrl": {
                "type": "string",
                "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "siemExport": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "siemExport": {
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "publicBaseUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s/]+$",
      "description": "Public address with scheme and without trailing slash or path, e.g. https://opaa.example.org"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^([a-z_][a-z0-9_]{0,62})?$",
          "description": "Plain lower-case identifier (OPAA_DB_SCHEMA); empty: public"
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "",
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        }
      },
      "required": [
        "port",
        "name",
        "username"
      ]
    },
    "evaluationDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": [
                "string",
                "integer"
              ]
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "rerank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s, 5m or PT5M; empty keeps the application default"
        },
        "probeInterval": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 10m or 24h (at least 10s); empty keeps the application default"
        }
      }
    },
    "siemExport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^([^\\s/:]+)?$",
          "description": "Host name of the syslog receiver, without scheme or port"
        },
        "port": {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,4})?$",
          "description": "TCP port; empty keeps the application default"
        },
        "tls": {
          "type": "string",
          "enum": [
            "",
            "true",
            "false"
          ],
          "description": "\"false\" sends without TLS; empty keeps TLS on"
        },
        "includeLabels": {
          "type": "boolean"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s or PT30S; empty keeps the application default"
        }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^([a-z]{2})?$",
          "description": "ISO-639-1 code; empty keeps the application default"
        },
        "maxAudioBytes": {
          "type": "string",
          "pattern": "^([0-9]+)?$",
          "description": "Largest recording in bytes; empty keeps the application default"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s, 5m or PT5M; empty keeps the application default"
        },
        "maxConcurrent": {
          "type": "string",
          "pattern": "^([1-9][0-9]*)?$",
          "description": "Recordings passed on at the same time; empty keeps the application default"
        }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s, 5m or PT5M; empty keeps the application default"
        },
        "readTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s, 5m or PT5M; empty keeps the application default"
        },
        "writeTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 30s, 5m or PT5M; empty keeps the application default"
        }
      }
    },
    "features": {
      "type": "object",
      "description": "Installation-wide feature flags; each sets OPAA_FEATURES_<NAME>_ENABLED (promptLibraries -> OPAA_FEATURES_PROMPT_LIBRARIES_ENABLED). Only flags the backend knows are accepted",
      "additionalProperties": false,
      "properties": {
        "promptLibraries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "Prompt libraries"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "Metadata of documents and libraries"
        },
        "speechInput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "Dictation in the chat"
        },
        "externalAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "External access: access tokens, library releases and the MCP server"
        }
      }
    },
    "targetValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indexingAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identityProviderAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "uploads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": {
          "type": "string",
          "enum": [
            "s3",
            "persistentVolumeClaim"
          ]
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            },
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "pathStyle": {
              "type": "boolean"
            },
            "keyPrefix": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": [
                "string",
                "integer"
              ]
            },
            "storageClassName": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "fsGroup": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "store"
      ]
    },
    "filesystemSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,53}[a-z0-9])?$"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/\\S+$"
          },
          "volume": {
            "type": "object",
            "minProperties": 1,
            "description": "A Kubernetes volume source, e.g. persistentVolumeClaim or nfs"
          }
        },
        "required": [
          "name",
          "mountPath",
          "volume"
        ]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "interval": {
              "type": "string",
              "pattern": "^(0|([0-9]+(ms|s|m|h|d|w|y))+)?$",
              "description": "Prometheus duration such as 30s or 1m30s; empty keeps the Prometheus default"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^(0|([0-9]+(ms|s|m|h|d|w|y))+)?$",
              "description": "Prometheus duration such as 30s or 1m30s; empty keeps the Prometheus default"
            }
          }
        },
        "podAnnotations": {
          "type": "boolean"
        },
        "scrapeFrom": {
          "type": "array"
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "errorRateThreshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "heapUsageThreshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "errorRateMinRequests": {
              "type": "integer",
              "minimum": 0
            },
            "indexingStallMinutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "trustedProxyCidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$",
        "description": "IPv4 or IPv6 address or CIDR range"
      }
    },
    "localAdminAllowedCidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$",
        "description": "IPv4 or IPv6 address or CIDR range"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backendIngress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraFrom": {
              "type": "array"
            }
          }
        },
        "frontendIngress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controllerNamespaceSelector": {
              "type": "object"
            },
            "controllerPodSelector": {
              "type": "object"
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dns": {
              "type": "array"
            },
            "backendRules": {
              "type": "array"
            }
          }
        }
      }
    },
    "extraCACertificates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h|d)|P\\S+)?$",
          "description": "Duration such as 60s, 3m or PT3M; empty keeps the application default"
        },
        "maxInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Input limit of the embedding endpoint in tokens; null keeps the application default"
        }
      },
      "required": [
        "baseUrl",
        "model",
        "dimensions"
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialAdmin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$",
              "not": {
                "pattern": "(?i)^admin@opaa\\.local$"
              },
              "description": "Deliverable mailbox of the first system administrator; admin@opaa.local is refused by the backend"
            }
          },
          "required": [
            "email"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerUri": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "authority": {
              "type": "string",
              "description": "Without effect: the issuer is the authority of the sign-in flow as well. Still accepted so that existing value files keep rendering.",
              "deprecated": true
            },
            "jwkSetUri": {
              "type": "string"
            }
          }
        },
        "chatModel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "baseUrl",
            "model"
          ]
        }
      },
      "required": [
        "initialAdmin",
        "chatModel"
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "jwtSecret": {
          "type": "string"
        },
        "databasePassword": {
          "type": "string"
        },
        "credentialsEncryptionKey": {
          "type": "string"
        },
        "settingsEncryptionKey": {
          "type": "string"
        },
        "s3AccessKey": {
          "type": "string"
        },
        "s3SecretKey": {
          "type": "string"
        },
        "embeddingApiKey": {
          "type": "string"
        },
        "chatApiKey": {
          "type": "string"
        },
        "rerankApiKey": {
          "type": "string"
        },
        "initialAdminPassword": {
          "type": "string"
        },
        "transcriptionApiKey": {
          "type": "string"
        }
      },
      "required": [
        "existingSecret"
      ],
      "if": {
        "properties": {
          "existingSecret": {
            "const": ""
          }
        }
      },
      "then": {
        "required": [
          "jwtSecret",
          "databasePassword",
          "credentialsEncryptionKey",
          "settingsEncryptionKey"
        ],
        "properties": {
          "jwtSecret": {
            "minLength": 32,
            "not": {
              "pattern": "(?i)(^\\s*(change_me|change-me|changeme|changeit|secret|password|opaa|example|default))|NICHT-FUER-DEN-PRODUKTIVBETRIEB"
            },
            "description": "At least 32 characters, not starting with a placeholder such as secret or opaa (the backend's SecretValidator), e.g. openssl rand -base64 48"
          },
          "databasePassword": {
            "minLength": 1
          },
          "credentialsEncryptionKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$",
            "not": {
              "enum": [
                "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=",
                "c2V0dGluZ3NkZXZrZXkwMHNldHRpbmdzZGV2a2V5MDE="
              ]
            },
            "description": "Base64 of 32 random bytes, e.g. openssl rand -base64 32; the publicly known development keys are refused"
          },
          "settingsEncryptionKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$",
            "not": {
              "enum": [
                "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=",
                "c2V0dGluZ3NkZXZrZXkwMHNldHRpbmdzZGV2a2V5MDE="
              ]
            },
            "description": "Base64 of 32 random bytes, e.g. openssl rand -base64 32; the publicly known development keys are refused"
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of backend pods, 0 stops the backend; more than 1 needs backend.migration.enabled and originals every pod sees (ADR-0053)"
