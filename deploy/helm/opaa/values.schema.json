        },
        "cspConnectSrcExtra": {
          "type": "string",
          "pattern": "^ *(((([Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?)://)?(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*(:([0-9]{1,5}|\\*))?(/[A-Za-z0-9._~%!&()*+=:@/-]*)?|([Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?):|\\*)( +((([Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?)://)?(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*(:([0-9]{1,5}|\\*))?(/[A-Za-z0-9._~%!&()*+=:@/-]*)?|([Hh][Tt][Tt][Pp][Ss]?|[Ww][Ss][Ss]?):|\\*))*)? *$",
          "description": "Sources for connect-src, space-separated, each [scheme://][*.]host[:port|:*][/path] with scheme http, https, ws or wss, a scheme such as https: or *; the same rule the image checks at start, since the value is spliced into the nginx configuration"
        },
        "backendReadTimeout": {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,5}[smh])?$",
          "description": "How long the frontend nginx waits for the backend's answer on /api/ and /mcp, a number with unit s, m or h such as 900s; the same rule the image checks at start; empty keeps the image default"
        },
