# ============================================================
# OPAA Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# Counterpart for the other deployment mode: .env.docker.example, the
# template for Docker Compose. Carry changes to variables shared by both
# templates over to the other one.
# ============================================================

# --- AI Providers ---
# One connection path for both functions: the OpenAI-compatible protocol. "openai" is the
# name of the wire protocol, not of a vendor - Ollama speaks it too, under its own /v1 endpoint,
# which is why there is no separate "ollama" provider anymore. The base URL below therefore
# already defaults to a locally operated Ollama server (http://localhost:11434/v1) - leave it as
# is to keep every model call inside your own network. Point it at a real vendor's endpoint only
# when you mean to.
# Shared base URL of the embedding (override below)
#OPAA_OPENAI_BASE_URL=http://localhost:11434/v1
# API key used for embedding (unless overridden below) - Ollama needs none
OPAA_OPENAI_API_KEY=
#
# The chat model is not configured here: the installation sets it (assistant or answer file), the
# model administration changes it (docs/handbuch/betrieb/modelle.md). In the "dev" mode the
# backend starts with phi3:mini at the base URL above.

# --- Embedding ---
# The embedding model is not configured here: the installation sets it (assistant or answer file)
# and fixes its vector size with a probe embedding (docs/handbuch/betrieb/modelle.md). In the "dev"
# mode the backend embeds with bge-m3 at the base URL above.
# Budget of one embedding call (default 180s, enough for a batch of bge-m3 on CPU); too short a value
# aborts the call and fails its document.
#OPAA_OPENAI_EMBEDDING_TIMEOUT=180s
# Address check (SSRF) of every model address the installation or the model administration stores
# or tests; separate from OPAA_INDEXING_TARGET_VALIDATION_*. A model server on this machine needs
# its host and port here, e.g. "localhost:11434" (an entry without port admits every port).
#OPAA_MODEL_TARGET_VALIDATION_ENABLED=true
#OPAA_MODEL_TARGET_VALIDATION_ALLOWLIST=localhost:11434

# --- Database ---
# JDBC connection URL for PostgreSQL
OPAA_DB_URL=jdbc:postgresql://localhost:5432/opaa?prepareThreshold=0
# Database username
OPAA_DB_USERNAME=opaa
# Database password
OPAA_DB_PASSWORD=opaa
# PostgreSQL schema for all of OPAA's objects; must exist before the first start
#OPAA_DB_SCHEMA=public

# --- Server ---
# Bind address (0.0.0.0 for all interfaces). Beyond loopback the "dev" profile refuses to start
# unless OPAA_AUTH_DEV_ALLOW_REMOTE=true confirms it: there every request is a system administrator.
OPAA_SERVER_ADDRESS=localhost
# Allowed CORS origins (comma-separated)
OPAA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Force HTTP/1.1 (needed for vLLM/Uvicorn-based servers)
OPAA_HTTP_FORCE_HTTP1=false

# --- Documents & Indexing ---
# Host path mounted into the container (Docker Compose only)
OPAA_INDEXING_DOCUMENT_PATH_HOST=./documents
# Tokens per text chunk for the Tika fallback and plain texts
OPAA_INDEXING_CHUNK_SIZE=1000
# Target characters per chunk for structured formats (Markdown, DOCX, ODT, HTML, PDF,
# Confluence, slides, tables), 500-8000; existing chunks are re-cut by the pipeline re-index
#OPAA_INDEXING_CHUNK_TARGET_CHARACTERS=4000
# Number of chunks per embedding batch
OPAA_INDEXING_BATCH_SIZE=50
# Minimum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new indexing tasks are rejected
OPAA_INDEXING_THREAD_POOL_QUEUE_CAPACITY=20
# User-Agent sent with every request to a source OPAA does not operate (RSS feed, web directory,
# Confluence, connection test) - must stay truthful, never impersonate a browser
OPAA_INDEXING_HTTP_USER_AGENT=OPAA-Indexer/1.0
# How many consecutive HTTP 429 answers one RSS/web-directory request waits out before it fails;
# 0 falls back to the default 6 (Confluence has its own OPAA_INDEXING_CONFLUENCE_MAX_RATE_LIMIT_RETRIES)
OPAA_INDEXING_HTTP_MAX_RATE_LIMIT_RETRIES=6
# Longest single wait honoured from a Retry-After header (RSS/web directory; Confluence has its own)
OPAA_INDEXING_HTTP_MAX_RETRY_AFTER=2m
# Requests one RSS/web-directory run may send, retries included, before it ends in an orderly
# way as incomplete; 0 = unbounded (Confluence and S3 have their own budgets)
OPAA_INDEXING_HTTP_REQUEST_BUDGET_PER_RUN=0
# Total time one RSS/web-directory run may wait on HTTP 429 answers before it ends in an
# orderly way as incomplete
OPAA_INDEXING_HTTP_MAX_RATE_LIMIT_WAIT_PER_RUN=15m
# Max. number of RSS feed entries processed in a single run
OPAA_INDEXING_RSS_MAX_ENTRIES=200
# Max. bytes read from an RSS feed itself before parsing aborts
OPAA_INDEXING_RSS_MAX_FEED_SIZE_BYTES=10485760
# Max. bytes read from a single RSS entry's detail page
OPAA_INDEXING_RSS_MAX_PAGE_SIZE_BYTES=5242880
# Minimum delay in ms between two RSS detail-page requests (politeness)
OPAA_INDEXING_RSS_REQUEST_DELAY_MS=1000
# CSS selector (Jsoup syntax) used to find an RSS detail page's main content; falls back to <body>
OPAA_INDEXING_RSS_MAIN_CONTENT_SELECTOR=main, article, [role=main]
# Which links on an RSS entry's detail page count as attachments: GENERIC (default) or GSB
# (Government Site Builder's query-parameter attachment pattern). Applies to every RSS run in this
# deployment - not a per-run choice, see ADR-0017/#468.
OPAA_INDEXING_RSS_ATTACHMENT_PROFILE=GENERIC
# Max. number of attachments downloaded per RSS entry
OPAA_INDEXING_RSS_MAX_ATTACHMENTS_PER_ENTRY=10
# Max. bytes read from a single RSS entry attachment before the download aborts
OPAA_INDEXING_RSS_MAX_ATTACHMENT_SIZE_BYTES=20971520
# Max. recursion depth for an HTTP_DIRECTORY crawl - the root is depth 0, so a crawl visits
# depths 0..max-depth inclusive
OPAA_INDEXING_CRAWL_MAX_DEPTH=10
# Max. number of file entries (and directories visited) in a single HTTP_DIRECTORY
# crawl before truncating
OPAA_INDEXING_CRAWL_MAX_ENTRIES=5000

# Confluence-Zugriffsschicht (ADR-0023): Seitengröße, Zeitlimit, Ratenbegrenzung, Größenlimits.
# Ein selbst betriebenes Confluence Data Center im privaten Adressbereich braucht zusätzlich einen
# Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_CONFLUENCE_PAGE_SIZE=100
OPAA_INDEXING_CONFLUENCE_REQUEST_TIMEOUT=30s
OPAA_INDEXING_CONFLUENCE_DETECTION_TIMEOUT=10s
OPAA_INDEXING_CONFLUENCE_MAX_RATE_LIMIT_RETRIES=6
OPAA_INDEXING_CONFLUENCE_MAX_RETRY_AFTER=2m
OPAA_INDEXING_CONFLUENCE_MAX_RESPONSE_BYTES=10485760
OPAA_INDEXING_CONFLUENCE_MAX_ATTACHMENT_SIZE_BYTES=20971520
OPAA_INDEXING_CONFLUENCE_MAX_LISTING_PAGES=500
OPAA_INDEXING_CONFLUENCE_INCREMENTAL_OVERLAP=10m
# Anfragebudget je Lauf: erschöpft -> Lauf endet geordnet als "unvollständig, wird
# fortgesetzt"; 0 schaltet das Budget ab
OPAA_INDEXING_CONFLUENCE_REQUEST_BUDGET_PER_RUN=50000
# S3-Zugriffsschicht (ADR-0027): Seitengröße, Objektgrenze, Zeitlimit, Wiederholungen bei
# 503 SlowDown/429 und Anfragebudget je Lauf (0 schaltet das Budget ab). Ein interner Objektspeicher
# im privaten Adressbereich braucht zusätzlich einen Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_S3_LIST_PAGE_SIZE=1000
OPAA_INDEXING_S3_MAX_OBJECT_SIZE_BYTES=52428800
OPAA_INDEXING_S3_REQUEST_TIMEOUT=30s
OPAA_INDEXING_S3_MAX_RETRIES=5
OPAA_INDEXING_S3_RETRY_BACKOFF=500ms
OPAA_INDEXING_S3_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_S3_MAX_OBJECTS_PER_RUN=1000000
OPAA_INDEXING_S3_DOWNLOAD_CONCURRENCY=2
# Google-Drive-Konnektor (siehe docs/handbuch/arbeitsmittel/wissensbibliotheken/konnektoren/google-drive.md, Abschnitt „Konfiguration")
OPAA_INDEXING_GOOGLE_DRIVE_PAGE_SIZE=1000
OPAA_INDEXING_GOOGLE_DRIVE_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_GOOGLE_DRIVE_REQUEST_TIMEOUT=30s
OPAA_INDEXING_GOOGLE_DRIVE_MAX_RETRIES=5
OPAA_INDEXING_GOOGLE_DRIVE_RETRY_BACKOFF=1s
OPAA_INDEXING_GOOGLE_DRIVE_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_GOOGLE_DRIVE_MAX_FILES_PER_RUN=1000000
OPAA_INDEXING_GOOGLE_DRIVE_DOWNLOAD_CONCURRENCY=2
# Nextcloud-Konnektor: Dateigrenze, Zeitlimit, Anfragebudget je Lauf, Notbremse,
# gleichzeitige Downloads, Grenze einer PROPFIND-Antwort und Höchstalter der gemerkten
# Ordner-ETags. Eine Nextcloud im privaten Adressbereich braucht einen Eintrag in
# OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_NEXTCLOUD_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_NEXTCLOUD_REQUEST_TIMEOUT=30s
OPAA_INDEXING_NEXTCLOUD_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_NEXTCLOUD_MAX_ENTRIES_PER_RUN=1000000
OPAA_INDEXING_NEXTCLOUD_DOWNLOAD_CONCURRENCY=2
OPAA_INDEXING_NEXTCLOUD_MAX_RESPONSE_BYTES=67108864
# SMB-Konnektor: Dateigrenze, Zeitlimit, Budget an SMB-Nachrichten je Lauf, Notbremse,
# gleichzeitige Downloads und Einträge je Auflistungsseite. Ein Dateiserver im privaten
# Adressbereich braucht einen Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_SMB_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_SMB_REQUEST_TIMEOUT=30s
OPAA_INDEXING_SMB_REQUEST_BUDGET_PER_RUN=100000
OPAA_INDEXING_SMB_MAX_ENTRIES_PER_RUN=1000000
OPAA_INDEXING_SMB_DOWNLOAD_CONCURRENCY=2
OPAA_INDEXING_SMB_LIST_PAGE_SIZE=1000
# Gemeinsamer Ereigniseingang aller Push-Wege (Confluence-Webhook, S3-Ereignisse): Sammelzeit je
# Bibliothek, Obergrenze je Stapel (darüber läuft der gewöhnliche Lauf des Konnektors) und
# Wartezyklen auf einen laufenden Lauf (siehe docs/handbuch/betrieb/konfiguration.md). Löst
# OPAA_INDEXING_CONFLUENCE_WEBHOOK_* und OPAA_INDEXING_S3_EVENTS_* ab.
OPAA_INDEXING_EVENTS_DEBOUNCE=5s
OPAA_INDEXING_EVENTS_MAX_PENDING_KEYS=500
OPAA_INDEXING_EVENTS_MAX_DEFERRALS=120
# Max. bytes a single HTTP_DIRECTORY entry may transfer before the download aborts -
# enforced while streaming, so a rejected entry cannot fill the temp partition either
OPAA_INDEXING_CRAWL_MAX_FILE_SIZE_BYTES=104857600
# Absolute base directories a FILESYSTEM library's sourcePath must resolve underneath (comma-
# separated, ADR-0018 Entscheidung 6). Empty (the default) disables the FILESYSTEM source type
# entirely - it is the actual security boundary, not who may create a library. URL-based source
# types (HTTP_DIRECTORY, RSS_FEED) are covered by OPAA_INDEXING_TARGET_VALIDATION_* below instead.
# OPAA_INDEXING_FILESYSTEM_ALLOWLIST=/srv/opaa/documents
# Whether HTTP_DIRECTORY/RSS_FEED fetches (indexing runs and the connection test) reject a target
# whose resolved address is loopback, link-local, private or otherwise non-routable (SSRF
# hardening). Default true - an operator with a legitimate internal document source turns this off
# deliberately, it does not default to permissive.
OPAA_INDEXING_TARGET_VALIDATION_ENABLED=true
# Hostnames (comma-separated, exact match, case-insensitive) exempted from the address check above
# even while it is enabled - lets an operator name specific internal sources without disabling the
# check for every other target. Empty by default.
# OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=intranet.example.org

# --- Document Upload ---
# Directory the uploaded originals live in with the default filesystem store below; a network share
# the operating system mounts onto it is the same case as far as the application is concerned.
# OPAA_UPLOAD_STORAGE_PATH=./uploads
# Which storage holds the uploaded originals (ADR-0030): "filesystem" (the directory in
# OPAA_UPLOAD_STORAGE_PATH above, a network share mounted onto it included) or "s3" (an
# S3-compatible object store, the block below). Any other value refuses the start. Default
# filesystem - an installation that configures nothing keeps behaving exactly as before.
# OPAA_UPLOAD_STORE=filesystem
#
# Only read with OPAA_UPLOAD_STORE=s3. Endpoint, bucket, access key and secret key are required
# then; a missing one refuses the start naming the variable, while a store that is merely
# unreachable does not (it shows up under /actuator/health/upload-store). The bucket must already
# exist - OPAA never creates it. Encryption at rest, versioning, retention and replication are
# configured on the bucket, OPAA sets no encryption headers.
# OPAA_UPLOAD_S3_ENDPOINT=http://localhost:8095
# OPAA_UPLOAD_S3_REGION=us-east-1
# OPAA_UPLOAD_S3_BUCKET=opaa-uploads
# Prefix in front of every object key; keep the trailing slash if a folder is meant. Separates
# several installations sharing one bucket.
# OPAA_UPLOAD_S3_KEY_PREFIX=
# true = endpoint/bucket/key (MinIO, Ceph), false = bucket.endpoint/key (AWS, Hetzner)
# OPAA_UPLOAD_S3_PATH_STYLE=true
# The key needs s3:PutObject, s3:GetObject, s3:DeleteObject and s3:ListBucket on the bucket. Unlike
# an S3 library's credentials both values may contain colons; neither is ever logged.
# OPAA_UPLOAD_S3_ACCESS_KEY=
# OPAA_UPLOAD_S3_SECRET_KEY=
# Directory for an upload's working file and for the local copy a re-index, a metadata re-run or an
# attachment re-extraction needs. Empty = the JVM's temp directory. Plan for the size of the files
# in flight here *and* in the JVM temp directory (Spring's multipart spool).
# OPAA_UPLOAD_S3_TEMP_DIRECTORY=
# Address check on every request to the object store - own namespace, switching the connectors'
# check off never switches this one off. The configured endpoint always passes, allowlisted hosts
# additionally.
# OPAA_UPLOAD_S3_TARGET_VALIDATION_ENABLED=true
# OPAA_UPLOAD_S3_TARGET_VALIDATION_ALLOWLIST=
#
# Own worker pool for the REST upload endpoint's asynchronous processing - deliberately
# separate from OPAA_INDEXING_THREAD_POOL_* above, see UploadProperties#threadPool.
# Minimum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new upload tasks are rejected (results in an immediate FAILED row instead
# of the task being silently discarded - see IndexingConfiguration#uploadTaskExecutor)
OPAA_UPLOAD_THREAD_POOL_QUEUE_CAPACITY=20
# Places of the upload pool (max size plus queue) one account may hold at once, so a single
# account cannot take them all; 0 means a quarter of the pool, at least one. Per instance.
OPAA_UPLOAD_MAX_PLACES_PER_ACCOUNT=0
# Minutes a stored original must be old before the orphan cleanup may report or remove it as
# orphaned - an upload whose row is being written right now is not an orphan. A report may
# raise this per call, never lower it; see docs/handbuch/betrieb/originalablage.md.
OPAA_UPLOAD_ORPHAN_GRACE_MINUTES=60

# --- Library ---
# Maximum total size (bytes), summed across every document a library holds, that library may
# occupy (Standardkontingent je Bibliothek). Enforced at every ingestion path that stores
# document content, not only the upload endpoint - see LibraryStorageQuotaService. Default 10 GiB.
# 0 or negative disables the quota entirely (no fallback to the default) - important for an
# existing deployment with a library already larger than 10 GiB, which this quota would otherwise
# retroactively block from any further upload/connector document.
OPAA_LIBRARY_QUOTA_BYTES=10737418240

# --- Query ---
# Final number of chunks selected for the answer prompt, out of OPAA_QUERY_FETCH_K candidates.
# Every selected chunk goes into the prompt uncut - nothing trims it to the chat model's context
# window. With a small context window tie it to the window size: about 6 for ~8k tokens, 12 for
# ~16k. With Ollama the server's context length (num_ctx) is the limit, not the model's.
# These values hold without neighbour chunks: by default every selected chunk also brings its
# neighbours in the same document, up to OPAA_QUERY_NEIGHBOR_CHUNKS_MAX_ADDED_CHARACTERS (40000)
# characters on top. With a small context window lower that budget or set
# OPAA_QUERY_NEIGHBOR_CHUNKS_RADIUS=0.
OPAA_QUERY_TOP_K=20
# Number of candidates the vector search itself retrieves before MMR narrows them down to
# OPAA_QUERY_TOP_K. Must be >= OPAA_QUERY_TOP_K.
OPAA_QUERY_FETCH_K=25
# MMR relevance/diversity trade-off (0.0–1.0) applied when narrowing OPAA_QUERY_FETCH_K candidates
# down to OPAA_QUERY_TOP_K. Default 1.0 disables diversity entirely (plain top-K by
# relevance, no extra database round trip) - diversity selection is implemented but ships as an
# opt-in (set below 1.0 to enable), not a default: measured against the multi-topic golden
# cases, 0.7 underperformed plain topK=8 (19/20 vs. 20/20 cases with both expected documents
# retrieved) - see QueryProperties#mmrLambda's Javadoc for the full numbers and decision rule.
OPAA_QUERY_MMR_LAMBDA=1.0
# Minimum cosine similarity to include a result (0.0–1.0)
OPAA_QUERY_SIMILARITY_THRESHOLD=0.3
# Splits a question into up to OPAA_QUERY_MAX_SUB_QUERIES independent search queries before
# retrieval - each gets its own permission/threshold-scoped similaritySearch call, fused by
# reciprocal rank fusion. Adds one LLM call per query (the systemwide active chat model of the
# model administration); falls back to today's single-query retrieval on any LLM failure or
# unparsable output, never a broken query.
OPAA_QUERY_DECOMPOSITION_ENABLED=true
# Upper bound on how many independent search queries a decomposed question may split into
OPAA_QUERY_MAX_SUB_QUERIES=3
# Once a document has a chunk in the final selection, up to this many of its chunks from the
# already permission/threshold-filtered candidate pool are preferred over a chunk of a different
# document - the fix for a document's own detail chunk (e.g. a fee table)
# losing its slot to an unrelated document purely because fusion/MMR spread OPAA_QUERY_TOP_K
# across topics first. Two-tier eviction: tier 1 evicts the weakest chunk of a document already
# holding two chunks; if none exists, tier 2 evicts the lowest-ranked chunk of the whole
# selection, but only when the completing document's own best chunk ranks strictly better (may
# drop a document out of the selection entirely), capped at max(1, OPAA_QUERY_TOP_K / 4) tier-2
# evictions per query. Never exceeds OPAA_QUERY_TOP_K overall. A fill target, not a cap per
# document: one that already holds more chunks is never trimmed to it, it loses chunks only as an
# eviction source for another document. 1 (the default) disables
# completion entirely: no sibling chunks are pulled in (the selection may still hold several
# chunks of one document), and the neighbour chunks (OPAA_QUERY_NEIGHBOR_CHUNKS_RADIUS) supply
# the surrounding text without taking a selection slot.
OPAA_QUERY_MAX_CHUNKS_PER_DOCUMENT=1
# Whether the lexical (PostgreSQL full-text) search path runs its query and contributes its ranked
# lists to the fusion. The value moves the answer itself: false spares the
# query and makes retrieval purely vectorial, at a measured 15 percentage points of hit rate@5 on
# the administration eval domain. Either way the stage stays in the chain and reports itself as
# switched off in the search explanation protocol.
OPAA_QUERY_FULL_TEXT_SEARCH_ENABLED=true

# --- Reranking (ships switched off) ---
# Switch, endpoint, model and key of the rerank model role are set by the system administration
# under Modelle > Reranking (ADR-0060); the former OPAA_RERANK_ENABLED/_BASE_URL/_MODEL/_API_KEY
# are no longer read. Only the load limits stay here.
# Time budget of a single rerank request. When it runs out the search keeps the fused order: a slow
# endpoint costs the ordering, never the answer.
OPAA_RERANK_TIMEOUT=10s
# How many fused candidates the rerank stage scores, and at the same time the budget MMR selection
# and fusion keep for it while reranking runs (0-200). 0 switches the stage off through its
# own parameter, independently of the switch under Modelle > Reranking. The window does not extend retrieval's
# reach: what no search stage returned can neither be fused nor reranked. That reach is
# OPAA_QUERY_FETCH_K per list times the lists in flight (sub-queries times active search paths), so
# raise OPAA_QUERY_FETCH_K along with this value - see docs/handbuch/betrieb/modelle.md, "Reranking
# einschalten".
OPAA_QUERY_RERANK_CANDIDATE_COUNT=50

# Transcription model role: dictation in the chat input. Switch, endpoint, model, key and language
# are set by the system administration under Modelle > Spracheingabe (ADR-0060); the former
# OPAA_TRANSCRIPTION_ENABLED/_BASE_URL/_MODEL/_API_KEY/_LANGUAGE are no longer read. Recordings are
# passed through in memory, never stored, never logged (docs/handbuch/betrieb/modelle.md).
# Largest recording in bytes (a two-minute recording is well below 1 MB).
#OPAA_TRANSCRIPTION_MAX_AUDIO_BYTES=10485760
# Time budget of one transcription request; CPU transcription is slow.
#OPAA_TRANSCRIPTION_TIMEOUT=120s
# Recordings passed on at the same time across the whole installation (each held in memory).
#OPAA_TRANSCRIPTION_MAX_CONCURRENT=4

# --- pgvector ---
# The vector size comes from the probe embedding of the installation.
# Distance function: cosine_distance, euclidean_distance, negative_inner_product
OPAA_PGVECTOR_DISTANCE_TYPE=cosine_distance

# --- Rate Limiting ---
# Enable or disable rate limiting globally
OPAA_RATE_LIMIT_ENABLED=true
# Max query requests per user within the time window
OPAA_RATE_LIMIT_QUERY_MAX_REQUESTS=10
# Time window for per-user query rate limit (seconds)
OPAA_RATE_LIMIT_QUERY_WINDOW_SECONDS=60
# Max query requests across all users within the time window
OPAA_RATE_LIMIT_QUERY_GLOBAL_MAX_REQUESTS=100
# Max indexing requests per user within the time window
OPAA_RATE_LIMIT_INDEXING_MAX_REQUESTS=1
# Time window for per-user indexing rate limit (seconds)
OPAA_RATE_LIMIT_INDEXING_WINDOW_SECONDS=60
# Max indexing requests across all users within the time window
OPAA_RATE_LIMIT_INDEXING_GLOBAL_MAX_REQUESTS=5
# Vertraute Proxys (ADR-0033): X-Forwarded-For zählt nur, wenn die Verbindung aus einem dieser
# Netze kommt; leer = Header ignoriert. Bei bootRun auf dem Host ohne Proxy leer lassen; hinter
# einem Reverse-Proxy dessen Adresse oder Netz eintragen (0.0.0.0/0 und ::/0 werden abgelehnt).
#OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# Grenzen der lokalen Anmeldung (ADR-0033), Vorgaben - vollständige Liste in .env.docker.example.
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_MAX_REQUESTS=10
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_WINDOW_SECONDS=60
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_GLOBAL_MAX_REQUESTS=100

# --- Authentication ---
# The auth mode is chosen by the active Spring profile, not by a variable:
# "oidc" for any deployment, "dev" for local development and tests. Without
# one of them the backend refuses to start. See docs/handbuch/betrieb/authentifizierung.md.
#
# Development mode ("dev") authenticates every request as a configured user
# without checking any credentials. Pre-configured users: dev-admin
# (admin@opaa.local, becomes SYSTEM_ADMIN) and dev-user.
# Issuer claim of the synthetic tokens
OPAA_AUTH_DEV_ISSUER=opaa-dev
# User assumed when no X-OPAA-Dev-User header is sent
OPAA_AUTH_DEV_DEFAULT_USER=dev-admin
# Installation mode of the operating mode (profile "oidc", ADR-0060,
# docs/handbuch/betrieb/installation.md): an empty database offers only the installation - first
# account, sign-in method, chat model - in the browser or over the installation API. The token
# (empty: the first start generates one and prints it once; at least 32 characters), the networks
# the API answers from (empty: no restriction) and an answer file for an installation without the
# browser (secrets in it only as paths of files).
#OPAA_INSTALLATION_TOKEN=
#OPAA_INSTALLATION_ALLOWED_CIDRS=
#OPAA_INSTALLATION_ANSWER_FILE=
# Mail servers on internal addresses the optional mail step may reach, host or host:port.
#OPAA_INSTALLATION_MAIL_TARGET_ALLOWLIST=
# "force" restores the bootstrap account once at start-up (unlocked, expiry cleared, new one-time
# password in the log, every session ended). Remove again afterwards.
#OPAA_LOCAL_ADMIN_RESET=force
# Network restriction for local system administrators: comma-separated addresses or CIDR ranges
# (IPv4 and IPv6) local SYSTEM_ADMIN accounts may sign in from; empty = no restriction. Regular
# local accounts are not affected. Checked against the resolved client address (X-Forwarded-For
# counts only behind a proxy listed in OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS).
#OPAA_LOCAL_ADMIN_ALLOWED_CIDRS=10.0.0.0/8,2001:db8::/32
#
# Overview of all test-account patterns in this repo (dev users, Keycloak
# realm user, E2E suite, source credentials) and why they are not unified:
# docs/handbuch/betrieb/authentifizierung.md, section "Testkonten im Überblick".

# --- Zugangsdaten-Verschlüsselung ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung der Zugangsdaten einer
# Quellkonfiguration (knowledge_libraries.source_credentials) ruhend in der Datenbank. Erforderlich,
# sobald eine Bibliothek vom Typ HTTP_DIRECTORY/RSS_FEED mit Zugangsdaten angelegt oder geändert
# wird - ohne gültigen Schlüssel schlägt genau dieser Schreibvorgang mit 503 fehl, der Start selbst
# bricht nicht ab. Erzeugen z. B. mit: openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/betrieb/netz-und-sicherheit.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_CREDENTIALS_ENCRYPTION_KEY=

# --- Verschlüsselung der Zugangsschlüssel verwalteter Chat-Modelle ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung von llm_models.api_key_ciphertext
# ruhend in der Datenbank - ein eigener Schlüssel, getrennt von OPAA_CREDENTIALS_ENCRYPTION_KEY
# oben. Erforderlich, sobald ein Chat-Modell MIT Zugangsschlüssel angelegt oder geändert wird
# (einschliesslich der einmaligen Übernahme einer bestehenden openai-Konfiguration mit
# API-Schlüssel beim ersten Start nach einem Update) - ohne gültigen Schlüssel schlägt genau
# dieser Vorgang fehl, der Start selbst bricht nicht ab. Eine reine Ollama-Installation oder ein
# openai-kompatibler Endpunkt OHNE Schlüssel braucht diese Variable nicht. Erzeugen z. B. mit:
# openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/betrieb/modelle.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_SETTINGS_ENCRYPTION_KEY=

# --- Lokale Konten: Token-Secret und Sitzungsfristen (ADR-0033) ---
# Wurzelgeheimnis der lokalen Benutzerverwaltung: Aus ihm leitet das Backend per HKDF die Schlüssel
# für die Signatur lokaler Access-Tokens sowie die Lookup-Hashes der Refresh- und Aktionstoken ab.
# Im Betriebsmodus (Profil "oidc") PFLICHT: Fehlt der Wert, ist er kürzer als 32 Zeichen oder ein
# Platzhalter, bricht der Start mit einer Meldung ab, die diese Variable nennt. Erzeugen mit:
# openssl rand -base64 48
# Eine Rotation beendet alle lokalen Sitzungen und entwertet alle offenen Einladungs-, Rücksetz-
# und Übergabelinks - bewusst der eine Handgriff nach einer Datenbank-Rücksicherung.
# KEIN echter Wert gehört in dieses Beispiel oder ins Repository.
# Auskommentiert lassen: ein leerer Wert würde im Profil "dev" den dort hinterlegten, ausdrücklich
# nicht produktionstauglichen Default überschreiben.
#OPAA_AUTH_JWT_SECRET=
# Sitzungsfristen lokaler Konten - Vorgaben aus ADR-0033, nur bei Bedarf setzen: Leerlauffrist
# (Refresh-Token) höchstens 30 Tage, absolute Höchstdauer einer Sitzung höchstens 90 Tage; für
# lokale Systemverwalterkonten gelten die kürzeren ADMIN-Werte. Ein Wert außerhalb dieser Grenzen
# bricht den Start ab.
#OPAA_AUTH_LOCAL_ACCESS_TOKEN_TTL=15m
#OPAA_AUTH_LOCAL_REFRESH_TOKEN_TTL=7d
#OPAA_AUTH_LOCAL_SESSION_MAX_LIFETIME=30d
#OPAA_AUTH_LOCAL_ADMIN_REFRESH_TOKEN_TTL=4h
#OPAA_AUTH_LOCAL_ADMIN_SESSION_MAX_LIFETIME=12h
# "false" nur für lokales HTTP ohne TLS - das Refresh-Cookie verliert dann sein Secure-Attribut.
#OPAA_AUTH_LOCAL_COOKIE_SECURE=true
# Gnadenfrist nach der Erneuerung einer Sitzung (ADR-0033): Ein Neuladen, das die Antwort der
# Erneuerung verworfen hat, legt das alte Refresh-Token noch einmal vor; innerhalb dieser Frist gilt
# das nicht als Wiederverwendung. Höchstens 60s, 0 schaltet sie ab.
#OPAA_AUTH_LOCAL_REFRESH_GRACE_PERIOD=20s
# Kontosperre nach Fehlversuchen (ADR-0033): nach MAX_ATTEMPTS falschen Passwörtern ist das Konto
# für DURATION gesperrt (feste Dauer, keine Verlängerung); der Zähler geht bei erfolgreicher
# Anmeldung auf null.
#OPAA_AUTH_LOCAL_LOCKOUT_MAX_ATTEMPTS=5
#OPAA_AUTH_LOCAL_LOCKOUT_DURATION=15m

# --- E-Mail-Versand (SMTP) ---
# Adresse, unter der diese Installation von aussen erreichbar ist. Sie bildet die Basis jedes Links
# in einer von OPAA versendeten E-Mail (Einladung, Passwort vergessen, Bestaetigung). Bewusst eine
# Umgebungsvariable und keine Einstellung in der Verwaltung: der Host-Header einer Anfrage wird nie
# als Basis verwendet, und wer die Basis im Browser aendern koennte, koennte aus einer
# kompromittierten Verwaltersitzung heraus jeden Link umlenken. Ohne Wert baut OPAA keinen Link;
# die Verwaltung der Konten bietet die davon abhaengigen Ablaeufe dann nicht an.
# Vollstaendige Adresse mit Schema, ohne abschliessenden Schraegstrich.
#OPAA_PUBLIC_BASE_URL=http://localhost:5173
# Zeitgrenzen der SMTP-Verbindung. Der Versand laeuft synchron im Anfrage-Thread der Person, die
# gerade auf ihre Einladung wartet - ein haengender Mailserver darf ihn nicht laenger halten als hier
# erlaubt. Server, Port, Verschluesselung, Zugangsdaten und Absender stehen NICHT hier, sondern in
# der Verwaltung unter "E-Mail-Versand" (das Passwort liegt verschluesselt in der Datenbank).
#OPAA_MAIL_CONNECT_TIMEOUT=10s
#OPAA_MAIL_READ_TIMEOUT=15s
#OPAA_MAIL_WRITE_TIMEOUT=15s

# --- OIDC (used with oidc profile) ---
# The identity provider comes from the installation (assistant or answer file, signIn) and the
# Anbieterverwaltung (ADR-0025, ADR-0060), not from this file.
# Address check (SSRF) for every issuer/JWK set address of a provider, from the installation as
# well as from the Anbieterverwaltung; separate from OPAA_INDEXING_TARGET_VALIDATION_* and
# OPAA_MODEL_TARGET_VALIDATION_*. Internal identity providers need their host listed here, a
# Keycloak on this machine "localhost".
#OPAA_OIDC_TARGET_VALIDATION_ENABLED=true
#OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=localhost:8180
# Additional origin(s) the frontend's Content-Security-Policy connect-src must allow, beyond
# 'self'. Needed because oidc-client-ts fetches OIDC discovery metadata and later
# exchanges the auth code directly from the browser against the authority's origin - if that
# origin differs from the frontend's own, it must be listed here (space-separated for more than
# one), or the CSP silently blocks the OIDC login. Defaults to this compose file's bundled
# Keycloak, which runs on its own port, not behind the frontend's nginx. A production identity
# provider on its own address (Entra ID, a house-wide Keycloak) needs its own origin here instead
# - see docs/handbuch/betrieb/authentifizierung.md, section "OIDC (Keycloak)".
OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:8180

# --- Docker Compose ports ---
# Backend host port (mapped to container port 8080)
OPAA_BACKEND_PORT=8081
# Frontend host port (mapped to container port 8080)
OPAA_FRONTEND_PORT=3000
