# ============================================================
# OPAA Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# Counterpart for the other deployment mode: .env.docker.example, the
# template for Docker Compose. Carry changes to variables shared by both
# templates over to the other one.
# ============================================================

# --- AI Providers ---
# One connection path for both functions: the OpenAI-compatible protocol (#762). "openai" is the
# name of the wire protocol, not of a vendor - Ollama speaks it too, under its own /v1 endpoint,
# which is why there is no separate "ollama" provider anymore. The base URL below therefore
# already defaults to a locally operated Ollama server (http://localhost:11434/v1) - leave it as
# is to keep every model call inside your own network. Point it at a real vendor's endpoint only
# when you mean to.
# Shared base URL for both chat and embedding (override per-function below)
#OPAA_OPENAI_BASE_URL=http://localhost:11434/v1
# API key used for both chat and embedding (unless overridden below) - Ollama needs none
OPAA_OPENAI_API_KEY=

# --- OpenAI Chat (override shared defaults per-function) ---
# Left commented out on purpose: a value set here but left empty would override the application
# default with an empty string (same reasoning as OPAA_OPENAI_BASE_URL above).
# Separate API key for chat (falls back to OPAA_OPENAI_API_KEY)
#OPAA_OPENAI_CHAT_API_KEY=
# Separate base URL for chat (falls back to OPAA_OPENAI_BASE_URL)
#OPAA_OPENAI_CHAT_BASE_URL=
# Chat model name
OPAA_OPENAI_CHAT_MODEL=phi3:mini
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
OPAA_OPENAI_CHAT_TEMPERATURE=0.7
# Maximum tokens in chat response
OPAA_OPENAI_CHAT_MAX_TOKENS=2000

# --- OpenAI Embedding (override shared defaults per-function) ---
# Same caveat as OPAA_OPENAI_CHAT_API_KEY/OPAA_OPENAI_CHAT_BASE_URL above - left commented out.
# Separate API key for embeddings (falls back to OPAA_OPENAI_API_KEY)
#OPAA_OPENAI_EMBEDDING_API_KEY=
# Separate base URL for embeddings (falls back to OPAA_OPENAI_BASE_URL)
#OPAA_OPENAI_EMBEDDING_BASE_URL=
# Embedding model name. Its output dimension must match OPAA_PGVECTOR_DIMENSIONS below -
# nomic-embed-text (the default here) embeds at 768 dimensions, which is why that variable below
# is set to 768 rather than the application's own 1536 default (#720).
OPAA_OPENAI_EMBEDDING_MODEL=nomic-embed-text

# --- Database ---
# JDBC connection URL for PostgreSQL
OPAA_DB_URL=jdbc:postgresql://localhost:5432/opaa?prepareThreshold=0
# Database username
OPAA_DB_USERNAME=opaa
# Database password
OPAA_DB_PASSWORD=opaa

# --- Server ---
# Bind address (0.0.0.0 for all interfaces)
OPAA_SERVER_ADDRESS=0.0.0.0
# Allowed CORS origins (comma-separated)
OPAA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Force HTTP/1.1 (needed for vLLM/Uvicorn-based servers)
OPAA_HTTP_FORCE_HTTP1=false

# --- Documents & Indexing ---
# Host path mounted into the container (Docker Compose only)
OPAA_INDEXING_DOCUMENT_PATH_HOST=./documents
# Characters per text chunk for embedding
OPAA_INDEXING_CHUNK_SIZE=1000
# Number of chunks per embedding batch
OPAA_INDEXING_BATCH_SIZE=50
# Minimum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new indexing tasks are rejected
OPAA_INDEXING_THREAD_POOL_QUEUE_CAPACITY=20
# Max. number of RSS feed entries processed in a single run (#467)
OPAA_INDEXING_RSS_MAX_ENTRIES=200
# Max. bytes read from an RSS feed itself before parsing aborts
OPAA_INDEXING_RSS_MAX_FEED_SIZE_BYTES=10485760
# Max. bytes read from a single RSS entry's detail page
OPAA_INDEXING_RSS_MAX_PAGE_SIZE_BYTES=5242880
# Minimum delay in ms between two RSS detail-page requests (politeness)
OPAA_INDEXING_RSS_REQUEST_DELAY_MS=1000
# User-Agent sent with RSS feed/detail-page requests - must stay truthful, never impersonate a browser
OPAA_INDEXING_RSS_USER_AGENT=OPAA-Indexer/1.0
# CSS selector (Jsoup syntax) used to find an RSS detail page's main content; falls back to <body>
OPAA_INDEXING_RSS_MAIN_CONTENT_SELECTOR=main, article, [role=main]
# Which links on an RSS entry's detail page count as attachments (#468): GENERIC (default) or GSB
# (Government Site Builder's query-parameter attachment pattern). Applies to every RSS run in this
# deployment - not a per-run choice, see ADR-0017/#468.
OPAA_INDEXING_RSS_ATTACHMENT_PROFILE=GENERIC
# Max. number of attachments downloaded per RSS entry
OPAA_INDEXING_RSS_MAX_ATTACHMENTS_PER_ENTRY=10
# Max. bytes read from a single RSS entry attachment before the download aborts
OPAA_INDEXING_RSS_MAX_ATTACHMENT_SIZE_BYTES=20971520
# Max. recursion depth for an HTTP_DIRECTORY crawl (#836) - the root is depth 0, so a crawl visits
# depths 0..max-depth inclusive
OPAA_INDEXING_CRAWL_MAX_DEPTH=10
# Max. number of file entries (and, since #836, directories visited) in a single HTTP_DIRECTORY
# crawl before truncating
OPAA_INDEXING_CRAWL_MAX_ENTRIES=5000

# Confluence-Zugriffsschicht (ADR-0023): Seitengröße, Zeitlimit, Ratenbegrenzung, Größenlimits.
# Ein selbst betriebenes Confluence Data Center im privaten Adressbereich braucht zusätzlich einen
# Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_CONFLUENCE_PAGE_SIZE=100
OPAA_INDEXING_CONFLUENCE_REQUEST_TIMEOUT=30s
OPAA_INDEXING_CONFLUENCE_DETECTION_TIMEOUT=10s
OPAA_INDEXING_CONFLUENCE_MAX_RATE_LIMIT_RETRIES=6
OPAA_INDEXING_CONFLUENCE_MAX_RETRY_AFTER=2m
OPAA_INDEXING_CONFLUENCE_MAX_RESPONSE_BYTES=10485760
OPAA_INDEXING_CONFLUENCE_MAX_ATTACHMENT_SIZE_BYTES=20971520
OPAA_INDEXING_CONFLUENCE_USER_AGENT=OPAA-Indexer/1.0
OPAA_INDEXING_CONFLUENCE_MAX_LISTING_PAGES=500
OPAA_INDEXING_CONFLUENCE_FULL_SYNC_INTERVAL=7d
OPAA_INDEXING_CONFLUENCE_INCREMENTAL_OVERLAP=10m
# Anfragebudget je Lauf (#1141): erschöpft -> Lauf endet geordnet als "unvollständig, wird
# fortgesetzt"; 0 schaltet das Budget ab
OPAA_INDEXING_CONFLUENCE_REQUEST_BUDGET_PER_RUN=50000
# Webhook-Eingang (#1140): Sammelzeit je Bibliothek, Obergrenze gezielter Einzelabrufe je Stapel,
# Anzahl der Verschiebungen, wenn gerade ein Lauf läuft (siehe docs/handbuch/deployment.md)
OPAA_INDEXING_CONFLUENCE_WEBHOOK_DEBOUNCE=5s
OPAA_INDEXING_CONFLUENCE_WEBHOOK_MAX_PENDING_PAGES=200
OPAA_INDEXING_CONFLUENCE_WEBHOOK_MAX_DEFERRALS=120
# Max. bytes a single HTTP_DIRECTORY entry may transfer before the download aborts (#1236) -
# enforced while streaming, so a rejected entry cannot fill the temp partition either
OPAA_INDEXING_CRAWL_MAX_FILE_SIZE_BYTES=104857600
# Absolute base directories a FILESYSTEM library's sourcePath must resolve underneath (comma-
# separated, #484/ADR-0018 Entscheidung 6). Empty (the default) disables the FILESYSTEM source type
# entirely - it is the actual security boundary, not who may create a library. URL-based source
# types (HTTP_DIRECTORY, RSS_FEED) are covered by OPAA_INDEXING_TARGET_VALIDATION_* below instead.
# OPAA_INDEXING_FILESYSTEM_ALLOWLIST=/srv/opaa/documents
# Whether HTTP_DIRECTORY/RSS_FEED fetches (indexing runs and the connection test) reject a target
# whose resolved address is loopback, link-local, private or otherwise non-routable (#267, SSRF
# hardening). Default true - an operator with a legitimate internal document source turns this off
# deliberately, it does not default to permissive.
OPAA_INDEXING_TARGET_VALIDATION_ENABLED=true
# Hostnames (comma-separated, exact match, case-insensitive) exempted from the address check above
# even while it is enabled - lets an operator name specific internal sources without disabling the
# check for every other target. Empty by default.
# OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=intranet.example.org

# --- Document Upload ---
# Own worker pool for the REST upload endpoint's asynchronous processing (#434/#614) - deliberately
# separate from OPAA_INDEXING_THREAD_POOL_* above, see UploadProperties#threadPool.
# Minimum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new upload tasks are rejected (results in an immediate FAILED row instead
# of the task being silently discarded - see IndexingConfiguration#uploadTaskExecutor)
OPAA_UPLOAD_THREAD_POOL_QUEUE_CAPACITY=20
# Minutes a document may stay PENDING before UploadPendingRecoveryRunner treats it as abandoned by
# a process that died mid-task and sets it to FAILED at the next application startup (#614)
OPAA_UPLOAD_PENDING_RECOVERY_THRESHOLD_MINUTES=30

# --- Library ---
# Maximum total size (bytes), summed across every document a library holds, that library may
# occupy (#119, Standardkontingent je Bibliothek). Enforced at every ingestion path that stores
# document content, not only the upload endpoint - see LibraryStorageQuotaService. Default 10 GiB.
# 0 or negative disables the quota entirely (no fallback to the default) - important for an
# existing deployment with a library already larger than 10 GiB, which this quota would otherwise
# retroactively block from any further upload/connector document.
OPAA_LIBRARY_QUOTA_BYTES=10737418240

# --- Query ---
# Final number of chunks selected for the answer prompt, out of OPAA_QUERY_FETCH_K candidates (#914)
OPAA_QUERY_TOP_K=8
# Number of candidates the vector search itself retrieves before MMR narrows them down to
# OPAA_QUERY_TOP_K (#914). Must be >= OPAA_QUERY_TOP_K.
OPAA_QUERY_FETCH_K=25
# MMR relevance/diversity trade-off (0.0–1.0) applied when narrowing OPAA_QUERY_FETCH_K candidates
# down to OPAA_QUERY_TOP_K (#914). Default 1.0 disables diversity entirely (plain top-K by
# relevance, no extra database round trip) - diversity selection is implemented but ships as an
# opt-in (set below 1.0 to enable), not a default: measured against #915's multi-topic golden
# cases, 0.7 underperformed plain topK=8 (19/20 vs. 20/20 cases with both expected documents
# retrieved) - see QueryProperties#mmrLambda's Javadoc for the full numbers and decision rule.
OPAA_QUERY_MMR_LAMBDA=1.0
# Minimum cosine similarity to include a result (0.0–1.0)
OPAA_QUERY_SIMILARITY_THRESHOLD=0.3
# Fraction of queries the permission-history drift check actually runs for (0.0–1.0)
OPAA_QUERY_PERMISSION_HISTORY_SAMPLE_RATE=1.0
# Splits a question into up to OPAA_QUERY_MAX_SUB_QUERIES independent search queries before
# retrieval (#923) - each gets its own permission/threshold-scoped similaritySearch call, fused by
# reciprocal rank fusion. Adds one LLM call per query (the systemwide active chat model, see
# OPAA_OPENAI_CHAT_* above); falls back to today's single-query retrieval on any LLM failure or
# unparsable output, never a broken query.
OPAA_QUERY_DECOMPOSITION_ENABLED=true
# Upper bound on how many independent search queries a decomposed question may split into (#923)
OPAA_QUERY_MAX_SUB_QUERIES=3
# Once a document has a chunk in the final selection, up to this many of its chunks from the
# already permission/threshold-filtered candidate pool are preferred over a chunk of a different
# document (#932 scope v2) - the fix for a document's own detail chunk (e.g. a fee table)
# losing its slot to an unrelated document purely because fusion/MMR spread OPAA_QUERY_TOP_K
# across topics first. Two-tier eviction: tier 1 evicts the weakest chunk of a document already
# holding two chunks; if none exists, tier 2 evicts the lowest-ranked chunk of the whole
# selection, but only when the completing document's own best chunk ranks strictly better (may
# drop a document out of the selection entirely), capped at max(1, OPAA_QUERY_TOP_K / 4) tier-2
# evictions per query. Never exceeds OPAA_QUERY_TOP_K overall. 1 disables completion entirely.
OPAA_QUERY_MAX_CHUNKS_PER_DOCUMENT=2
# Whether the lexical (PostgreSQL full-text) search path runs its query and contributes its ranked
# lists to the fusion (#1048/#1049). Since #1049 the value moves the answer itself: false spares the
# query and makes retrieval purely vectorial, at a measured 15 percentage points of hit rate@5 on
# the administration eval domain. Either way the stage stays in the chain and reports itself as
# switched off in the search explanation protocol.
OPAA_QUERY_FULL_TEXT_SEARCH_ENABLED=true

# --- Reranking (ships switched off) ---
# The rerank model role's own switch (#1050), deliberately separate from the endpoint settings
# below: "reranking is off" should be a statement, not the indistinguishable result of a forgotten
# configuration line. Set to true without a configured endpoint - or with one that does not answer
# - the application logs the fault at startup, keeps the state visible on the "Suche & Indexierung"
# administration page, and searches on without reranking.
OPAA_RERANK_ENABLED=false
# Base URL of the rerank endpoint, without the /rerank path. Any service answering
# POST {base}/rerank works - vLLM, Text Embeddings Inference, Infinity, Jina, Cohere, Voyage. It
# must accept at least OPAA_QUERY_RERANK_CANDIDATE_COUNT documents per request.
#OPAA_RERANK_BASE_URL=http://reranker:80
# Model identifier sent with every rerank request. Together with the base URL it binds the role;
# with either one missing the role counts as unbound.
#OPAA_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Optional access key. It appears only in the Authorization header of the rerank request - never in
# a log, never in a status response, not even truncated.
#OPAA_RERANK_API_KEY=
# Time budget of a single rerank request. When it runs out the search keeps the fused order: a slow
# endpoint costs the ordering, never the answer.
OPAA_RERANK_TIMEOUT=10s
# How many fused candidates the rerank stage scores, and at the same time the budget MMR selection
# and fusion keep for it while reranking runs (0-200, #1050). 0 switches the stage off through its
# own parameter, independently of OPAA_RERANK_ENABLED. The window does not extend retrieval's
# reach: what no search stage returned can neither be fused nor reranked. That reach is
# OPAA_QUERY_FETCH_K per list times the lists in flight (sub-queries times active search paths), so
# raise OPAA_QUERY_FETCH_K along with this value - see docs/handbuch/deployment.md, "Reranking
# einschalten".
OPAA_QUERY_RERANK_CANDIDATE_COUNT=50

# --- pgvector ---
# Vector dimensions (must match the embedding model output). 768, not the application's own 1536
# default (#720): OPAA_OPENAI_EMBEDDING_MODEL above defaults to nomic-embed-text, which embeds at
# 768 dimensions - leaving this at 1536 breaks indexing out of the box with a dimension-mismatch
# error the moment the first document is embedded. Change this together with
# OPAA_OPENAI_EMBEDDING_MODEL if you switch to a different embedding model.
OPAA_PGVECTOR_DIMENSIONS=768
# Distance function: cosine_distance, euclidean_distance, negative_inner_product
OPAA_PGVECTOR_DISTANCE_TYPE=cosine_distance

# --- Rate Limiting ---
# Enable or disable rate limiting globally
OPAA_RATE_LIMIT_ENABLED=true
# Max query requests per user within the time window
OPAA_RATE_LIMIT_QUERY_MAX_REQUESTS=10
# Time window for per-user query rate limit (seconds)
OPAA_RATE_LIMIT_QUERY_WINDOW_SECONDS=60
# Max query requests across all users within the time window
OPAA_RATE_LIMIT_QUERY_GLOBAL_MAX_REQUESTS=100
# Max indexing requests per user within the time window
OPAA_RATE_LIMIT_INDEXING_MAX_REQUESTS=1
# Time window for per-user indexing rate limit (seconds)
OPAA_RATE_LIMIT_INDEXING_WINDOW_SECONDS=60
# Max indexing requests across all users within the time window
OPAA_RATE_LIMIT_INDEXING_GLOBAL_MAX_REQUESTS=5

# --- Authentication ---
# The auth mode is chosen by the active Spring profile, not by a variable:
# "oidc" for any deployment, "dev" for local development and tests. Without
# one of them the backend refuses to start. See docs/handbuch/deployment.md.
#
# Development mode ("dev") authenticates every request as a configured user
# without checking any credentials. Pre-configured users: dev-admin
# (admin@opaa.local, becomes SYSTEM_ADMIN) and dev-user.
# Issuer claim of the synthetic tokens
OPAA_AUTH_DEV_ISSUER=opaa-dev
# User assumed when no X-OPAA-Dev-User header is sent
OPAA_AUTH_DEV_DEFAULT_USER=dev-admin
# Email for the initial admin user (auto-created on first start)
OPAA_INITIAL_ADMIN_EMAIL=admin@opaa.local
#
# Overview of all test-account patterns in this repo (dev users, Keycloak
# realm user, E2E suite, source credentials) and why they are not unified:
# docs/handbuch/deployment.md, section "Testkonten im Überblick".

# --- Zugangsdaten-Verschlüsselung (#483) ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung der Zugangsdaten einer
# Quellkonfiguration (knowledge_libraries.source_credentials) ruhend in der Datenbank. Erforderlich,
# sobald eine Bibliothek vom Typ HTTP_DIRECTORY/RSS_FEED mit Zugangsdaten angelegt oder geändert
# wird - ohne gültigen Schlüssel schlägt genau dieser Schreibvorgang mit 503 fehl, der Start selbst
# bricht nicht ab. Erzeugen z. B. mit: openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/deployment.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_CREDENTIALS_ENCRYPTION_KEY=

# --- Verschlüsselung der Zugangsschlüssel verwalteter Chat-Modelle (#756) ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung von llm_models.api_key_ciphertext
# ruhend in der Datenbank - ein eigener Schlüssel, getrennt von OPAA_CREDENTIALS_ENCRYPTION_KEY
# oben. Erforderlich, sobald ein Chat-Modell MIT Zugangsschlüssel angelegt oder geändert wird
# (einschliesslich der einmaligen Übernahme einer bestehenden openai-Konfiguration mit
# API-Schlüssel beim ersten Start nach einem Update) - ohne gültigen Schlüssel schlägt genau
# dieser Vorgang fehl, der Start selbst bricht nicht ab. Eine reine Ollama-Installation oder ein
# openai-kompatibler Endpunkt OHNE Schlüssel braucht diese Variable nicht. Erzeugen z. B. mit:
# openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/deployment.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_SETTINGS_ENCRYPTION_KEY=

# --- OIDC (used with oidc profile) ---
# Bootstrap values (ADR-0025, #1329): taken over ONCE, on the first start in the oidc mode, as the
# first provider row of the Anbieterverwaltung; afterwards the database leads. ISSUER_URI,
# CLIENT_ID and JWK_SET_URI must be set - there are no defaults any more - and seed the provider
# row; AUTHORITY has no effect since #1332 (the sign-in page uses the provider row's issuer as
# its authority) and is kept only for older setups. Keep them set afterwards: they are the
# recovery anchor
# for OPAA_OIDC_BOOTSTRAP=force and their addresses are always allowed by the address check.
# JWK Set URI for token verification (container-internal URL)
OPAA_OIDC_JWK_SET_URI=http://keycloak:8180/realms/opaa/protocol/openid-connect/certs
# OIDC issuer URI for token validation
OPAA_OIDC_ISSUER_URI=http://localhost:8180/realms/opaa
# OIDC authority URL - without effect since #1332 (the sign-in page uses the provider row's issuer)
OPAA_OIDC_AUTHORITY=http://localhost:8180/realms/opaa
# OIDC client ID for the frontend
OPAA_OIDC_CLIENT_ID=opaa-frontend
# "force" restores the provider above once (enabled, default, values overwritten) - the way back
# from a mistyped issuer of the only provider. Remove again after the next start.
#OPAA_OIDC_BOOTSTRAP=force
# Address check (SSRF) for issuer/JWK set addresses a SYSTEM_ADMIN enters in the
# Anbieterverwaltung; separate from OPAA_INDEXING_TARGET_VALIDATION_*. The two addresses above
# are always allowed; further internal identity providers need their host listed here.
#OPAA_OIDC_TARGET_VALIDATION_ENABLED=true
#OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=idp.intern.example
# Additional origin(s) the frontend's Content-Security-Policy connect-src must allow, beyond
# 'self' (#409/#670). Needed because oidc-client-ts fetches OIDC discovery metadata and later
# exchanges the auth code directly from the browser against the authority's origin - if that
# origin differs from the frontend's own, it must be listed here (space-separated for more than
# one), or the CSP silently blocks the OIDC login. Defaults to this compose file's bundled
# Keycloak, which runs on its own port, not behind the frontend's nginx. A production identity
# provider on its own address (Entra ID, a house-wide Keycloak) needs its own origin here instead
# - see docs/handbuch/deployment.md, section "OIDC (Keycloak)".
OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:8180

# --- Docker Compose ports ---
# Backend host port (mapped to container port 8080)
OPAA_BACKEND_PORT=8081
# Frontend host port (mapped to container port 80)
OPAA_FRONTEND_PORT=3000
