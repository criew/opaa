      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(opaa_model_requests_total{result!=\"success\",model=~\"$model\",instance=~\"$instance\"}[$__interval]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
