  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(opaa_build_info, instance)",
          "refId": "v"
        },
        "definition": "label_values(opaa_build_info, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "Alle",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "connector",
        "label": "Konnektortyp",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(opaa_indexing_runs_total, connector)",
          "refId": "v"
        },
        "definition": "label_values(opaa_indexing_runs_total, connector)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "Alle",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
