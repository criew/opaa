            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(opaa_auth_logins_total{instance=~\"$instance\"}[$__interval]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "interval": "15m"
