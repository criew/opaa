    {
      "id": 803,
      "type": "timeseries",
      "title": "Anmeldungen pro Stunde",
      "description": "Erfolgreiche und fehlgeschlagene Anmeldungen (lokal und OIDC), IdP-Fehler.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
