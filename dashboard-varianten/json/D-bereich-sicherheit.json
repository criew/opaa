        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(opaa_build_info, instance)",
          "refId": "v"
        },
        "definition": "label_values(opaa_build_info, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "Alle",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 801,
      "type": "stat",
      "title": "Nachweispflichten",
      "description": "Prüfsummenkette: Rückstand (Schwelle 6 h). Monate ohne Siegel. SIEM-Export: Rückstand (Schwelle 1 h). Letzter Löschlauf (Schwelle 35 Tage). Protokollhorizont: Zeit, bis das Protokoll nicht mehr schreiben kann (unter 14 Tagen prüfen, unter 48 h sofort).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(opaa_audit_chain_lag_seconds) / 60",
          "legendFormat": "Prüfsummenkette Rückstand",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(opaa_audit_chain_unsealed_months)",
          "legendFormat": "Monate ohne Siegel",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(opaa_siem_export_lag_seconds) / 60",
          "legendFormat": "SIEM-Rückstand",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(opaa_audit_retention_last_run_age_seconds) / 86400",
          "legendFormat": "Löschlauf vor",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(opaa_audit_log_horizon_seconds) / 86400",
          "legendFormat": "Protokollhorizont",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
