  "description": "Bereich Informationssicherheit und Revision.",
  "tags": [
    "opaa",
    "variante-d"
  ],
  "timezone": "Europe/Berlin",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
