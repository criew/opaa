    {
      "id": 103,
      "type": "stat",
      "title": "Läufe gescheitert (6 h)",
      "description": "Anteil gescheiterter Läufe in den letzten 6 h, schlechtester Konnektortyp, ab 4 Läufen. Einzelne kaputte Dateien zählen hier nicht – Läufe zeigen Quellen- und Zugangsprobleme.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((max(sum by (connector) (increase(opaa_indexing_runs_total{result=\"failed\",connector=~\"$connector\"}[6h])) / sum by (connector) (increase(opaa_indexing_runs_total{connector=~\"$connector\"}[6h])))) and on() ((min(sum by (connector) (increase(opaa_indexing_runs_total{connector=~\"$connector\"}[6h])))) >= 4))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#11774F",
                "value": null
