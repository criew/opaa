  "panels": [
    {
      "id": 501,
      "type": "stat",
      "title": "Bausteine",
      "description": "Je Baustein ein Zustand. Backend/Frontend: bereite Pods gegen Soll (Teilausfall = prüfen). Datenbank: erreichbar, keine Verbindungs-Timeouts. Anmeldedienst: Anteil IdP-Fehler (ab 10 Anmeldungen). Modellrollen aus opaa_model_role_available; nicht eingerichtete Rollen sind grau, nicht rot.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(2 * (sum(kube_deployment_status_replicas_available{deployment=\"opaa-backend\"}) == bool 0)) + ((sum(kube_deployment_status_replicas_available{deployment=\"opaa-backend\"}) < bool sum(kube_deployment_spec_replicas{deployment=\"opaa-backend\"})) * (sum(kube_deployment_status_replicas_available{deployment=\"opaa-backend\"}) > bool 0))",
          "legendFormat": "Backend",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(2 * (sum(kube_deployment_status_replicas_available{deployment=\"opaa-frontend\"}) == bool 0)) + ((sum(kube_deployment_status_replicas_available{deployment=\"opaa-frontend\"}) < bool sum(kube_deployment_spec_replicas{deployment=\"opaa-frontend\"})) * (sum(kube_deployment_status_replicas_available{deployment=\"opaa-frontend\"}) > bool 0))",
          "legendFormat": "Frontend",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(label_replace((2 * (min(pg_up) == bool 0)), \"k\", \"s0\", \"\", \"\") or label_replace(((sum(increase(hikaricp_connections_timeout_total{instance=~\"$instance\"}[10m])) > bool 0)), \"k\", \"s1\", \"\", \"\") or label_replace(vector(0), \"k\", \"zero\", \"\", \"\"))",
          "legendFormat": "Datenbank",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((2 * ((sum(increase(opaa_auth_logins_total{method=\"oidc\",result=\"idp_error\",instance=~\"$instance\"}[10m])) / sum(increase(opaa_auth_logins_total{method=\"oidc\",instance=~\"$instance\"}[10m]))) > bool 0.5)) and on() ((sum(increase(opaa_auth_logins_total{method=\"oidc\",instance=~\"$instance\"}[10m]))) >= 10))) or on() vector(0)",
          "legendFormat": "Anmeldedienst (IdP)",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(label_replace(((2 * (min(opaa_model_role_available{role=\"chat\",instance=~\"$instance\"}) == bool 0))), \"k\", \"s0\", \"\", \"\") or label_replace(((((sum(increase(opaa_model_requests_total{role=\"chat\",result=\"throttled\",instance=~\"$instance\"}[30m])) / sum(increase(opaa_model_requests_total{role=\"chat\",instance=~\"$instance\"}[30m]))) > bool 0.2) and on() ((sum(increase(opaa_model_requests_total{role=\"chat\",instance=~\"$instance\"}[30m]))) >= 20))), \"k\", \"s1\", \"\", \"\") or label_replace(vector(0), \"k\", \"zero\", \"\", \"\")) and on() count(opaa_model_role_available{role=\"chat\",instance=~\"$instance\"})) or on() vector(-1)",
          "legendFormat": "Chat-Modell",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(2 * (min(opaa_model_role_available{role=\"embedding\",instance=~\"$instance\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Embedding",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 * (min(opaa_model_role_available{role=\"rerank\",instance=~\"$instance\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Rerank",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 * (min(opaa_model_role_available{role=\"ocr\",instance=~\"$instance\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Texterkennung",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 * (min(opaa_model_role_available{role=\"transcription\",instance=~\"$instance\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Transkription",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 * (min(opaa_model_role_available{role=\"vision\",instance=~\"$instance\"}) == bool 0)) or on() vector(-1)",
          "legendFormat": "Bildverstehen",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "nicht eingerichtet",
                  "color": "#5A6270",
                  "index": 0
                },
                "0": {
                  "text": "in Ordnung",
                  "color": "#11774F",
                  "index": 1
                },
                "1": {
                  "text": "prüfen",
                  "color": "#8F5A00",
                  "index": 2
                },
                "2": {
                  "text": "gestört",
                  "color": "#CE2C31",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5A6270",
                "value": null
              },
              {
                "color": "#11774F",
                "value": 0
              },
              {
                "color": "#8F5A00",
                "value": 1
              },
              {
                "color": "#CE2C31",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "keine Daten",
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 15
        }
      }
    },
    {
      "id": 502,
      "type": "stat",
      "title": "Nutzerseite",
      "description": "Erfolgsquoten der letzten 15 min (ab Mindestvolumen) und Wartezeit bis zum ersten Wort (p95).",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((sum(increase(opaa_query_count_total{status=\"success\",instance=~\"$instance\"}[15m])) / sum(increase(opaa_query_count_total{instance=~\"$instance\"}[15m]))) and on() ((sum(increase(opaa_query_count_total{instance=~\"$instance\"}[15m]))) >= 8))) or on() vector(-1)",
          "legendFormat": "Chat erfolgreich",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((sum(increase(opaa_auth_logins_total{result=\"success\",instance=~\"$instance\"}[15m])) / sum(increase(opaa_auth_logins_total{result=~\"success|idp_error\",instance=~\"$instance\"}[15m]))) and on() ((sum(increase(opaa_auth_logins_total{result=~\"success|idp_error\",instance=~\"$instance\"}[15m]))) >= 5))) or on() vector(-1)",
          "legendFormat": "Anmeldung erfolgreich",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((histogram_quantile(0.95, sum by (le) (rate(opaa_query_time_to_first_token_seconds_bucket{instance=~\"$instance\"}[15m])))) and on() ((sum(increase(opaa_query_count_total{instance=~\"$instance\"}[15m]))) >= 8))) or on() vector(-1)",
          "legendFormat": "Erstes Wort (p95)",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#CE2C31",
                "value": null
              },
              {
                "color": "#8F5A00",
                "value": 0.95
              },
              {
                "color": "#11774F",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "wenig Verkehr",
                  "color": "#5A6270",
                  "index": 0
                }
              }
            }
          ],
          "links": [],
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Anmeldung erfolgreich"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#CE2C31",
                      "value": null
                    },
                    {
                      "color": "#8F5A00",
                      "value": 0.9
                    },
                    {
                      "color": "#11774F",
                      "value": 0.98
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Erstes Wort (p95)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#11774F",
