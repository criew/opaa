    {
      "id": 503,
      "type": "stat",
      "title": "Hintergrund",
      "description": "Scheduler-Jobs überfällig (3 × erwartetes Intervall), Warteschlangen über ihrer jeweiligen Schwelle, Verzeichnisabgleich, Invalidierungs-Bus.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(((time() - max by (job) (opaa_scheduled_last_success_seconds{job!~\"audit-.*\"})) > 3 * max by (job) (opaa_scheduled_expected_interval_seconds)) > 900) or vector(0)",
          "legendFormat": "Jobs überfällig",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (queue) (opaa_queue_oldest_age_seconds{queue=\"mail_outbox\"}) > 1800 or max by (queue) (opaa_queue_oldest_age_seconds{queue=\"source_event_batches\"}) > 3600 or max by (queue) (opaa_queue_oldest_age_seconds{queue=\"ocr\"}) > 21600 or max by (queue) (opaa_queue_oldest_age_seconds{queue=\"indexing\"}) > 7200) or vector(0)",
          "legendFormat": "Warteschlangen im Verzug",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - max(opaa_directory_sync_last_applied_seconds)) / 60",
          "legendFormat": "Abgleich angewendet vor",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(opaa_invalidation_bus_connected)",
          "legendFormat": "Invalidierungs-Bus",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
