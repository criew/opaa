# ============================================================
# OPAA Docker Compose Environment Configuration
# Copy this file to .env.docker and adjust values as needed.
#
# Counterpart for the other deployment mode: .env.example, the template for
# a host-side `./gradlew bootRun`. Carry changes to variables shared by both
# templates over to the other one.
# ============================================================

# --- Authentication ---
# The auth mode is chosen by the active Spring profile, not by a variable:
# "oidc" for any deployment, "dev" for local development and tests. Without
# one of them the backend refuses to start (io.opaa.auth.AuthProfileGuard).
# "docker" activates the Docker-specific configuration (DB URL, Ollama URL)
# below. See docs/handbuch/betrieb/authentifizierung.md.
SPRING_PROFILES_ACTIVE=docker,dev
#
# --- Switching this stack to the operating mode ---
# Three lines, then the installation (docs/handbuch/betrieb/installation.md):
#   1. SPRING_PROFILES_ACTIVE=docker,oidc                 (above)
#   2. OPAA_AUTH_JWT_SECRET=<openssl rand -base64 48>     (section "Local accounts")
#   3. OPAA_PUBLIC_BASE_URL=<the public address>          (section "Mail") - only
#      needed for invitation and reset links
# An empty database then starts in the installation mode: first account, sign-in method and chat
# model are set in the browser, with the installation token from the log, or from the answer file
# below. Everything else in this file already carries a value that works for this stack,
# OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS included.
#
# Development mode ("dev", the default above) authenticates every request as
# a configured user without checking any credentials. Pre-configured users:
# dev-admin (admin@opaa.local, becomes SYSTEM_ADMIN) and dev-user.
# Whoever reaches the frontend port is therefore system administrator: the stack publishes it on
# 127.0.0.1 only, and the backend refuses to start in "dev" with OPAA_FRONTEND_BIND_ADDRESS beyond
# loopback (section "Docker Compose ports" below) unless this line confirms it. Leave it unset;
# a stack reachable from other machines runs "docker,oidc".
#OPAA_AUTH_DEV_ALLOW_REMOTE=false
# In the "oidc" mode the first administrator is the local account of the installation
# (ADR-0033, ADR-0060); provider accounts get SYSTEM_ADMIN by role assignment only.
# Issuer claim of the synthetic tokens
OPAA_AUTH_DEV_ISSUER=opaa-dev
# User assumed when no X-OPAA-Dev-User header is sent
OPAA_AUTH_DEV_DEFAULT_USER=dev-admin
# Installation mode (ADR-0060, docs/handbuch/betrieb/installation.md): the token of the
# installation API and the browser assistant (empty: the first start generates one and prints it
# once; at least 32 characters) and the networks the API answers from (empty: no restriction).
#OPAA_INSTALLATION_TOKEN=
#OPAA_INSTALLATION_ALLOWED_CIDRS=
# Mail servers on internal addresses the optional mail step of the assistant may reach, host or
# host:port (the stack's mailpit: mailpit:1025). Without it, enter such a server after the
# installation under Administration -> E-Mail.
#OPAA_INSTALLATION_MAIL_TARGET_ALLOWLIST=mailpit:1025
# Answer file for an installation without the browser: copy installation/installation.example.json
# to installation/installation.json, put the password of the first account into
# installation/admin-password (readable for uid 65532, never in the JSON itself) and uncomment
# the line. docker-compose.yml mounts ./installation (OPAA_INSTALLATION_DIR_HOST) read-only there.
# Ignored once the installation is completed. A model on an internal host, such as "ollama" of
# this stack, needs host and port in OPAA_MODEL_TARGET_VALIDATION_ALLOWLIST (below).
#OPAA_INSTALLATION_ANSWER_FILE=/run/opaa/installation/installation.json
# Address check (SSRF) of every model address the installation or the model administration stores
# or tests (chat, embedding, rerank, transcription); separate from OPAA_INDEXING_TARGET_VALIDATION_*,
# so a model host listed here is no permitted source and a source host none for models. An entry
# host:port admits only that port; the Ollama of this stack is "ollama:11434".
# Set for the "ollama" profile and the Ollama template of the model form; harmless without it.
#OPAA_MODEL_TARGET_VALIDATION_ENABLED=true
OPAA_MODEL_TARGET_VALIDATION_ALLOWLIST=ollama:11434
# "force" restores the bootstrap account once at start-up (unlocked, expiry cleared, new one-time
# password in the log, every session ended). Remove again afterwards.
#OPAA_LOCAL_ADMIN_RESET=force
# Network restriction for local system administrators: comma-separated addresses or CIDR ranges
# (IPv4 and IPv6) local SYSTEM_ADMIN accounts may sign in from; empty = no restriction. Regular
# local accounts are not affected. Checked against the resolved client address - behind this
# stack's nginx the one from X-Forwarded-For, once OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS (below)
# names that container's address.
#OPAA_LOCAL_ADMIN_ALLOWED_CIDRS=10.0.0.0/8,2001:db8::/32
#
# Demo stack (docker-compose.yml, profile "demo"): running the seed against the Rheinfurt
# demo profile (demo/seed/seed.py --profile demo) requires SPRING_PROFILES_ACTIVE=docker,oidc above
# and the first account admin@stadt-rheinfurt.example, matching the "demo-admin" Keycloak user in
# keycloak/realm-export.json - see demo/README.md, section "Seed ausführen".
#
# Overview of all test-account patterns in this repo (dev users, Keycloak
# realm user, E2E suite, source credentials) and why they are not unified:
# docs/handbuch/betrieb/authentifizierung.md, section "Testkonten im Überblick".

# --- AI Providers ---
# One connection path for both functions: the OpenAI-compatible protocol. "openai" is the
# name of the wire protocol, not of a vendor - Ollama speaks it too, under its own /v1 endpoint,
# which is why there is no separate "ollama" provider anymore. The base URL already defaults to
# http://ollama:11434/v1 on this ("docker") profile - that hostname resolves once the optional
# "ollama" Compose service runs, started with `docker compose --profile ollama up` (see
# docker-compose.yml and docs/handbuch/betrieb/docker-compose.md, section "Schnellstart"). Without that profile it is
# only a placeholder hostname, see the comment further below. Leave it as is to keep every model
# call inside your own network; point it at a real vendor's endpoint only when you mean to.
# Left commented out on purpose: a value set here but left empty would
# override the application default with an empty string (see the variable
# table in docs/handbuch/betrieb/konfiguration.md). Without the optional "ollama" Compose profile
# this stack includes no ollama service and assumes a reachable Ollama server instead. The stack
# still starts without one, but indexing fails until it is reachable. If Ollama runs on the host
# itself, http://host.docker.internal:11434/v1 reaches it from inside the container
# (docker-compose.yml already sets the required extra_hosts entry for the backend service).
#OPAA_OPENAI_BASE_URL=
# API key used for embedding (unless overridden below) - Ollama needs none
#OPAA_OPENAI_API_KEY=
#
# The chat model is not configured here: the installation sets it (assistant or answer file), the
# model administration changes it (docs/handbuch/betrieb/modelle.md). In the "dev" mode the stack
# starts with phi3:mini at the base URL above.

# --- Embedding ---
# The embedding model is not configured here either: the installation sets it (assistant or answer
# file) and fixes its vector size with a probe embedding (docs/handbuch/betrieb/modelle.md). In the
# "dev" mode the stack embeds with bge-m3 at the base URL above. The Compose profile "ollama" pulls
# bge-m3 and creates it with an input limit of 8192 tokens: then add "maxInputTokens": 8192 to the
# embeddingModel of the answer file.
# Budget of one embedding call (default 180s, enough for a batch of bge-m3 on CPU); too short a value
# aborts the call and fails its document.
#OPAA_OPENAI_EMBEDDING_TIMEOUT=180s

# --- Database ---
# JDBC connection URL for PostgreSQL. Left commented out on purpose: the
# active "docker" Spring profile already defaults it to
# jdbc:postgresql://postgres:5432/opaa?prepareThreshold=0, which is the
# Docker-internal hostname of the postgres service. The value below is only
# correct for a bootRun setup on the host, not inside the container network.
#OPAA_DB_URL=jdbc:postgresql://localhost:5432/opaa?prepareThreshold=0
# Database username
OPAA_DB_USERNAME=opaa
# Database password
OPAA_DB_PASSWORD=opaa
# PostgreSQL schema for all of OPAA's objects; must exist before the first start
#OPAA_DB_SCHEMA=public
# Connections of this instance's pool (default 10). Several instances (docker-compose.multi.yml)
# need max_connections of PostgreSQL for (instances + 1) x (pool + 1) plus the migration step.
#OPAA_DB_POOL_SIZE=10

# --- Server ---
# Bind address (0.0.0.0 for all interfaces) - required so the backend is
# reachable from the frontend container's Nginx reverse proxy.
OPAA_SERVER_ADDRESS=0.0.0.0
# Allowed CORS origins (comma-separated) - must match the frontend's host
# port (default 3000, see docker-compose.yml's frontend port mapping; the
# OPAA_FRONTEND_PORT variable further below does not control this - see the
# comment there).
OPAA_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Force HTTP/1.1 (needed for vLLM/Uvicorn-based servers)
OPAA_HTTP_FORCE_HTTP1=false
# How long a stop lets the requests already in flight finish before they are cut off. The value is
# a window per shutdown phase, not a budget for the whole stop: the short built-in window for chat
# title and chat note comes on top. Background indexing and upload work gets no window at all - it
# is interrupted at once. Raising this value means raising OPAA_STOP_GRACE_PERIOD along with it
# (that one is read from the process environment/a real .env file only, see the note at the top).
#OPAA_SHUTDOWN_TIMEOUT=60s
# Time zone of the backend: times of the scheduled runs, day, month and year boundaries of the
# deadlines and the dates in mails follow it. Set explicitly; with more than one backend instance it
# must be the same on all of them, or the second instance refuses to start.
TZ=UTC
# Instance register: how often this instance reports that it runs, and after how long without a
# report it counts as gone (at least four reports; the same on every instance).
#OPAA_INSTANCE_HEARTBEAT_INTERVAL=15s
#OPAA_INSTANCE_DEAD_AFTER=120s

# --- Documents & Indexing ---
# Host path mounted into the container (Docker Compose only). Only effective
# from the process environment/a real .env file, never from this env_file -
# see docs/handbuch/betrieb/konfiguration.md, section "Alle Umgebungsvariablen". Left commented
# out so an uncommented value here does not wrongly suggest it takes effect.
#OPAA_INDEXING_DOCUMENT_PATH_HOST=./documents
# Tokens per text chunk for the Tika fallback and plain texts
OPAA_INDEXING_CHUNK_SIZE=1000
# Target characters per chunk for structured formats (Markdown, DOCX, ODT, HTML, PDF,
# Confluence, slides, tables), 500-8000; existing chunks are re-cut by the pipeline re-index
#OPAA_INDEXING_CHUNK_TARGET_CHARACTERS=4000
# Number of chunks per embedding batch
OPAA_INDEXING_BATCH_SIZE=50
# Maximum number of concurrent embedding calls per document, capped by a shared, process-wide
# pool (1-32). 1 processes the batches sequentially. Default 3 is
# conservative for CPU-bound, locally hosted Ollama (no measured throughput gain past 1 in the
# benchmark - embedding computation serializes there). Raise this for a network/latency-bound
# API or GPU backend that genuinely serves concurrent requests in parallel (8-16 in that same
# benchmark) - not auto-detected, the operator has to know their backend.
#OPAA_INDEXING_EMBEDDING_CONCURRENCY=3
# Minimum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the indexing pool
OPAA_INDEXING_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new indexing tasks are rejected
OPAA_INDEXING_THREAD_POOL_QUEUE_CAPACITY=20
# User-Agent sent with every request to a source OPAA does not operate (RSS feed, web directory,
# Confluence, connection test) - must stay truthful, never impersonate a browser
OPAA_INDEXING_HTTP_USER_AGENT=OPAA-Indexer/1.0
# How many consecutive HTTP 429 answers one RSS/web-directory request waits out before it fails;
# 0 falls back to the default 6 (Confluence has its own OPAA_INDEXING_CONFLUENCE_MAX_RATE_LIMIT_RETRIES)
OPAA_INDEXING_HTTP_MAX_RATE_LIMIT_RETRIES=6
# Longest single wait honoured from a Retry-After header (RSS/web directory; Confluence has its own)
OPAA_INDEXING_HTTP_MAX_RETRY_AFTER=2m
# Requests one RSS/web-directory run may send, retries included, before it ends in an orderly
# way as incomplete; 0 = unbounded (Confluence and S3 have their own budgets)
OPAA_INDEXING_HTTP_REQUEST_BUDGET_PER_RUN=0
# Total time one RSS/web-directory run may wait on HTTP 429 answers before it ends in an
# orderly way as incomplete
OPAA_INDEXING_HTTP_MAX_RATE_LIMIT_WAIT_PER_RUN=15m
# Max. number of RSS feed entries processed in a single run
OPAA_INDEXING_RSS_MAX_ENTRIES=200
# Max. bytes read from an RSS feed itself before parsing aborts
OPAA_INDEXING_RSS_MAX_FEED_SIZE_BYTES=10485760
# Max. bytes read from a single RSS entry's detail page
OPAA_INDEXING_RSS_MAX_PAGE_SIZE_BYTES=5242880
# Minimum delay in ms between two RSS detail-page requests (politeness)
OPAA_INDEXING_RSS_REQUEST_DELAY_MS=1000
# CSS selector (Jsoup syntax) used to find an RSS detail page's main content; falls back to <body>
OPAA_INDEXING_RSS_MAIN_CONTENT_SELECTOR=main, article, [role=main]
# Which links on an RSS entry's detail page count as attachments: GENERIC (default) or GSB
# (Government Site Builder's query-parameter attachment pattern). Applies to every RSS run in this
# deployment - not a per-run choice, see ADR-0017/#468.
OPAA_INDEXING_RSS_ATTACHMENT_PROFILE=GENERIC
# Max. number of attachments downloaded per RSS entry
OPAA_INDEXING_RSS_MAX_ATTACHMENTS_PER_ENTRY=10
# Max. bytes read from a single RSS entry attachment before the download aborts
OPAA_INDEXING_RSS_MAX_ATTACHMENT_SIZE_BYTES=20971520
# Max. recursion depth for an HTTP_DIRECTORY crawl - the root is depth 0, so a crawl visits
# depths 0..max-depth inclusive
OPAA_INDEXING_CRAWL_MAX_DEPTH=10
# Max. number of file entries (and directories visited) in a single HTTP_DIRECTORY
# crawl before truncating
OPAA_INDEXING_CRAWL_MAX_ENTRIES=5000

# Confluence-Zugriffsschicht (ADR-0023): Seitengröße, Zeitlimit, Ratenbegrenzung, Größenlimits.
# Ein selbst betriebenes Confluence Data Center im privaten Adressbereich braucht zusätzlich einen
# Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_CONFLUENCE_PAGE_SIZE=100
OPAA_INDEXING_CONFLUENCE_REQUEST_TIMEOUT=30s
OPAA_INDEXING_CONFLUENCE_DETECTION_TIMEOUT=10s
OPAA_INDEXING_CONFLUENCE_MAX_RATE_LIMIT_RETRIES=6
OPAA_INDEXING_CONFLUENCE_MAX_RETRY_AFTER=2m
OPAA_INDEXING_CONFLUENCE_MAX_RESPONSE_BYTES=10485760
OPAA_INDEXING_CONFLUENCE_MAX_ATTACHMENT_SIZE_BYTES=20971520
OPAA_INDEXING_CONFLUENCE_MAX_LISTING_PAGES=500
OPAA_INDEXING_CONFLUENCE_INCREMENTAL_OVERLAP=10m
# Anfragebudget je Lauf: erschöpft -> Lauf endet geordnet als "unvollständig, wird
# fortgesetzt"; 0 schaltet das Budget ab
OPAA_INDEXING_CONFLUENCE_REQUEST_BUDGET_PER_RUN=50000
# S3-Zugriffsschicht (ADR-0027): Seitengröße, Objektgrenze, Zeitlimit, Wiederholungen bei
# 503 SlowDown/429 und Anfragebudget je Lauf (0 schaltet das Budget ab). Ein interner Objektspeicher
# im privaten Adressbereich braucht zusätzlich einen Eintrag in OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST.
OPAA_INDEXING_S3_LIST_PAGE_SIZE=1000
OPAA_INDEXING_S3_MAX_OBJECT_SIZE_BYTES=52428800
OPAA_INDEXING_S3_REQUEST_TIMEOUT=30s
OPAA_INDEXING_S3_MAX_RETRIES=5
OPAA_INDEXING_S3_RETRY_BACKOFF=500ms
OPAA_INDEXING_S3_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_S3_MAX_OBJECTS_PER_RUN=1000000
OPAA_INDEXING_S3_DOWNLOAD_CONCURRENCY=2
# Google-Drive-Konnektor (siehe docs/handbuch/arbeitsmittel/wissensbibliotheken/konnektoren/google-drive.md, Abschnitt „Konfiguration")
OPAA_INDEXING_GOOGLE_DRIVE_PAGE_SIZE=1000
OPAA_INDEXING_GOOGLE_DRIVE_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_GOOGLE_DRIVE_REQUEST_TIMEOUT=30s
OPAA_INDEXING_GOOGLE_DRIVE_MAX_RETRIES=5
OPAA_INDEXING_GOOGLE_DRIVE_RETRY_BACKOFF=1s
OPAA_INDEXING_GOOGLE_DRIVE_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_GOOGLE_DRIVE_MAX_FILES_PER_RUN=1000000
OPAA_INDEXING_GOOGLE_DRIVE_DOWNLOAD_CONCURRENCY=2
OPAA_INDEXING_GOOGLE_DRIVE_DOWNLOAD_TIMEOUT=10m
# SharePoint-Konnektor (siehe docs/handbuch/arbeitsmittel/wissensbibliotheken/konnektoren/sharepoint.md, Abschnitt „Konfiguration")
OPAA_INDEXING_SHAREPOINT_PAGE_SIZE=200
OPAA_INDEXING_SHAREPOINT_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_SHAREPOINT_REQUEST_TIMEOUT=30s
OPAA_INDEXING_SHAREPOINT_DOWNLOAD_TIMEOUT=10m
OPAA_INDEXING_SHAREPOINT_MAX_RETRIES=5
OPAA_INDEXING_SHAREPOINT_MAX_RETRY_WAIT=60s
OPAA_INDEXING_SHAREPOINT_MAX_THROTTLE_WAIT_PER_RUN=30m
OPAA_INDEXING_SHAREPOINT_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_SHAREPOINT_MAX_FILES_PER_RUN=1000000
OPAA_INDEXING_SHAREPOINT_DOWNLOAD_CONCURRENCY=2
# Dropbox-Konnektor (siehe docs/handbuch/arbeitsmittel/wissensbibliotheken/konnektoren/dropbox.md, Abschnitt „Konfiguration"); die Adressen
# OPAA_INDEXING_DROPBOX_*_BASE und *_ENDPOINT nur für einen Ersatzserver in Tests setzen
OPAA_INDEXING_DROPBOX_PAGE_SIZE=2000
OPAA_INDEXING_DROPBOX_MAX_FILE_SIZE_BYTES=52428800
OPAA_INDEXING_DROPBOX_REQUEST_TIMEOUT=30s
OPAA_INDEXING_DROPBOX_DOWNLOAD_TIMEOUT=10m
OPAA_INDEXING_DROPBOX_MAX_RETRIES=5
OPAA_INDEXING_DROPBOX_MAX_RETRY_WAIT=5m
OPAA_INDEXING_DROPBOX_REQUEST_BUDGET_PER_RUN=20000
OPAA_INDEXING_DROPBOX_MAX_FILES_PER_RUN=1000000
OPAA_INDEXING_DROPBOX_DOWNLOAD_CONCURRENCY=2
# Gemeinsamer Ereigniseingang aller Push-Wege (Confluence-Webhook, S3-Ereignisse): Sammelzeit je
# Bibliothek, Obergrenze je Stapel (darüber läuft der gewöhnliche Lauf des Konnektors) und
# Wartezyklen auf einen laufenden Lauf (siehe docs/handbuch/betrieb/konfiguration.md). Löst
# OPAA_INDEXING_CONFLUENCE_WEBHOOK_* und OPAA_INDEXING_S3_EVENTS_* ab.
OPAA_INDEXING_EVENTS_DEBOUNCE=5s
OPAA_INDEXING_EVENTS_MAX_PENDING_KEYS=500
OPAA_INDEXING_EVENTS_MAX_DEFERRALS=120
# Max. bytes a single HTTP_DIRECTORY entry may transfer before the download aborts -
# enforced while streaming, so a rejected entry cannot fill the temp partition either
OPAA_INDEXING_CRAWL_MAX_FILE_SIZE_BYTES=104857600
# DoS-hardening limits for TabularDocumentPipeline (XLSX/CSV/ODS):
# Max. columns read from a single row (XLSX/ODS alike) - a wider row is truncated, not rejected
OPAA_INDEXING_TABULAR_MAX_ROW_COLUMNS=200
# Max. times a single ODS cell's table:number-columns-repeated is expanded (ODF exports routinely
# pad a row with one repeated empty cell up to the full sheet width)
OPAA_INDEXING_TABULAR_MAX_ODS_CELL_REPEAT=50
# Max. bytes read from an ODS file's decompressed content.xml before parsing aborts
OPAA_INDEXING_TABULAR_MAX_ODS_CONTENT_XML_BYTES=10485760
# Max. rows parsed from a single ODS file before parsing aborts
OPAA_INDEXING_TABULAR_MAX_ODS_ROWS=100000
# DoS-hardening limits for MailDocumentPipeline (EML/MSG):
# Max. number of attachments read from a single message
OPAA_INDEXING_MAIL_MAX_ATTACHMENTS_PER_MESSAGE=50
# Max. bytes read from a single attachment before it is skipped
OPAA_INDEXING_MAIL_MAX_ATTACHMENT_BYTES=52428800
# Max. bytes read from the .eml/.msg file itself before parsing is refused
OPAA_INDEXING_MAIL_MAX_MESSAGE_BYTES=104857600
# DoS-hardening limits for OdtDocumentPipeline/OdpDocumentPipeline (ODT/ODP):
# Max. bytes read from an ODT/ODP file's decompressed content.xml before parsing aborts
OPAA_INDEXING_ODF_MAX_CONTENT_XML_BYTES=10485760
# Max. paragraph/heading/table elements read from a single ODT document before parsing aborts
OPAA_INDEXING_ODF_MAX_ODT_PARAGRAPHS=50000
# Max. draw:page slides read from a single ODP presentation before parsing aborts
OPAA_INDEXING_ODF_MAX_ODP_SLIDES=5000
# Max. spaces a single text:s element expands to (text:c repeat count)
OPAA_INDEXING_ODF_MAX_SPACE_REPEAT=1000
# Max. characters accumulated, across the whole document, into a paragraph/cell text buffer before
# parsing aborts - bounds an unbounded number of text:s elements within a single paragraph, which
# OPAA_INDEXING_ODF_MAX_SPACE_REPEAT alone does not cap
OPAA_INDEXING_ODF_MAX_TEXT_CHARACTERS=10000000
# DoS-hardening limits for the structure formats (PDF, DOCX, PPTX, XLSX/CSV, HTML, Markdown):
# Max. characters of text a single document may yield; a document past it fails to parse
OPAA_INDEXING_PARSER_LIMITS_MAX_TEXT_CHARACTERS=10000000
# Max. bytes a single XML part of a DOCX/PPTX/XLSX package may unpack to
OPAA_INDEXING_PARSER_LIMITS_MAX_OOXML_PART_BYTES=33554432
# Max. bytes all XML parts of one DOCX/PPTX/XLSX package may unpack to together
OPAA_INDEXING_PARSER_LIMITS_MAX_OOXML_TOTAL_BYTES=67108864
# Max. content-stream operators processed for one PDF, each array operand element counting as one
# more (bounds CPU time of nested forms); drawing-heavy plans may need more
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_OPERATORS=200000000
# Max. decoded content-stream bytes parsed for one PDF, a form counted each time it is drawn
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_CONTENT_BYTES=536870912
# Max. bytes a single PDF stream (content, cross-reference or object stream) may decode to, checked
# before PDFBox decodes it in memory
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_STREAM_BYTES=33554432
# Max. wall-clock seconds reading one PDF may take (backstop for the limits above)
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_PARSE_SECONDS=120
# Max. pages of one PDF, counted along its page tree instead of the page count it declares
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_PAGES=10000
# Max. objects of one PDF: cross-reference entries along the /Prev chain, objects of unpacked
# object streams and objects a brute-force search finds, added up
OPAA_INDEXING_PARSER_LIMITS_MAX_PDF_OBJECTS=1000000
# Absolute base directories a FILESYSTEM library's sourcePath must resolve underneath (comma-
# separated, ADR-0018 Entscheidung 6). Empty (the default) disables the FILESYSTEM source type
# entirely - it is the actual security boundary, not who may create a library. URL-based source
# types (HTTP_DIRECTORY, RSS_FEED) are covered by OPAA_INDEXING_TARGET_VALIDATION_* below instead.
# OPAA_INDEXING_FILESYSTEM_ALLOWLIST=/srv/opaa/documents
# Max. recursion depth for nested attachments (Mail-in-Mail, a Feed-Anlage) before the remainder is
# skipped - one general value for every connector's attachment path (ADR-0022 Entscheidung 6)
OPAA_INDEXING_ATTACHMENTS_MAX_DEPTH=5
# Max. attachments one document indexes over all levels of nesting together, and their total bytes
OPAA_INDEXING_ATTACHMENTS_MAX_PER_ROOT=500
OPAA_INDEXING_ATTACHMENTS_MAX_BYTES_PER_ROOT=1073741824
# Whether HTTP_DIRECTORY/RSS_FEED fetches (indexing runs and the connection test) reject a target
# whose resolved address is loopback, link-local, private or otherwise non-routable (SSRF
# hardening). Default true - an operator with a legitimate internal document source turns this off
# deliberately, it does not default to permissive.
OPAA_INDEXING_TARGET_VALIDATION_ENABLED=true
# Hostnames (comma-separated, exact match, case-insensitive) exempted from the address check above
# even while it is enabled - lets an operator name specific internal sources without disabling the
# check for every other target. Empty by default.
# OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=intranet.example.org
#
# Demo stack (docker-compose.yml, profile "demo"): the corpus webservers "demo-corpus"
# and "presse.stadt-rheinfurt.example" and the object store "objectstore" resolve to
# Compose-network-internal addresses, which the check above rejects for everyone by default. Set
# this in your own .env.docker (never in this template, and never unconditionally in
# docker-compose.yml itself - that would silently widen the allowlist for every deployment using
# this compose file, demo profile or not) when running the demo profile:
# OPAA_INDEXING_TARGET_VALIDATION_ALLOWLIST=demo-corpus,presse.stadt-rheinfurt.example,objectstore
#
# The demo's S3 library is the first seeded library with source credentials, so the demo
# profile also needs OPAA_CREDENTIALS_ENCRYPTION_KEY below (a generated value, see there and
# demo/README.md, "Installation mit einem Befehl") - without it the seed fails with 503 at that library.

# --- Document Upload: storage of the originals ---
# Which storage holds the uploaded originals (ADR-0030): "filesystem" - the bind mount
# OPAA_UPLOAD_STORAGE_PATH_HOST (default ./uploads) on /app/uploads, a network share mounted onto
# it included - or "s3", an S3-compatible object store. Any other value refuses the start. Default
# filesystem; an installation that configures nothing keeps behaving exactly as before.
#
# With "filesystem", the host directory has to be writable for uid/gid 65532 - the account the
# backend container runs under - otherwise every upload fails with AccessDeniedException.
# On a local directory that means chown; on a mounted network share, where chown does not take,
# it means the mount options (uid=65532,gid=65532) or a "user:" entry on the backend service. See
# docs/handbuch/betrieb/docker-compose.md, "Nicht-root-Betrieb des Backend-Containers".
#
# The stack brings an object store for this along under the Compose profile "upload-s3"
# (docker-compose.yml, service "upload-store"): an S3-compatible store with its own volume, separate from the
# demo profile's "objectstore", which is a *source* for the S3 connector and not a storage. Start it with
#   docker compose --profile upload-s3 up -d upload-store upload-store-init
# and uncomment the whole block below - its values are exactly the service's own defaults. Without
# the profile these lines stay commented out and nothing changes.
#
# OPAA_UPLOAD_STORE=s3
# OPAA_UPLOAD_S3_ENDPOINT=http://upload-store:9000
# OPAA_UPLOAD_S3_BUCKET=opaa-uploads
# OPAA_UPLOAD_S3_ACCESS_KEY=opaa-uploads
# OPAA_UPLOAD_S3_SECRET_KEY=OpaaUploads!2026
#
# Optional, defaults apply when unset: signature region (any value for a self-hosted store, the bucket's
# region on AWS), a prefix in front of every object key (keep the trailing slash if a folder is
# meant; it separates several installations sharing one bucket), addressing style (true =
# endpoint/bucket/key for a self-hosted store, false = bucket.endpoint/key for AWS/Hetzner), the directory
# for an upload's working file and the local copies a re-index, a metadata re-run or an attachment
# re-extraction needs (empty = /tmp in the container), and the address check on every request to
# the store - own namespace, so switching the connectors' check off never switches this one off,
# and the configured endpoint always passes without an allowlist entry.
# OPAA_UPLOAD_S3_REGION=us-east-1
# OPAA_UPLOAD_S3_KEY_PREFIX=
# OPAA_UPLOAD_S3_PATH_STYLE=true
# OPAA_UPLOAD_S3_TEMP_DIRECTORY=
# OPAA_UPLOAD_S3_TARGET_VALIDATION_ENABLED=true
# OPAA_UPLOAD_S3_TARGET_VALIDATION_ALLOWLIST=
#
# Running the "demo" profile, the store is a different one: the demo writes into the "opaa-uploads"
# bucket of its own "objectstore" service, with the bucket-scoped key its init step creates, so a demo
# stack stays one object store instead of two. Values and reasoning: demo/README.md, "Installation
# mit einem Befehl". The "upload-s3" profile stays untouched by that.
#
# The "upload-store" service's own root credentials, bucket name and host ports are interpolated by
# Compose itself, so they only take effect from the process environment or a real .env file, never
# from this file (OPAA_UPLOAD_STORE_ROOT_USER, OPAA_UPLOAD_STORE_ROOT_PASSWORD,
# OPAA_UPLOAD_STORE_BUCKET, OPAA_UPLOAD_STORE_PORT, OPAA_UPLOAD_STORE_CONSOLE_PORT). The first
# three default to the bucket and the two keys above and have to keep matching them; the two host
# ports have no counterpart here, the backend never goes through them.

# --- Document Upload ---
# Own worker pool for the REST upload endpoint's asynchronous processing - deliberately
# separate from OPAA_INDEXING_THREAD_POOL_* above, see UploadProperties#threadPool.
# Minimum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_CORE_SIZE=2
# Maximum threads in the upload pool
OPAA_UPLOAD_THREAD_POOL_MAX_SIZE=4
# Queue capacity before new upload tasks are rejected (results in an immediate FAILED row instead
# of the task being silently discarded - see IndexingConfiguration#uploadTaskExecutor)
OPAA_UPLOAD_THREAD_POOL_QUEUE_CAPACITY=20
# Minutes a stored original must be old before the orphan cleanup may report or remove it as
# orphaned - an upload whose row is being written right now is not an orphan. A report may
# raise this per call, never lower it; see docs/handbuch/betrieb/originalablage.md.
OPAA_UPLOAD_ORPHAN_GRACE_MINUTES=60

# --- Library ---
# Maximum total size (bytes), summed across every document a library holds, that library may
# occupy (Standardkontingent je Bibliothek). Enforced at every ingestion path that stores
# document content, not only the upload endpoint - see LibraryStorageQuotaService. Default 10 GiB.
# 0 or negative disables the quota entirely (no fallback to the default) - important for an
# existing deployment with a library already larger than 10 GiB, which this quota would otherwise
# retroactively block from any further upload/connector document.
OPAA_LIBRARY_QUOTA_BYTES=10737418240

# --- Query ---
# Final number of chunks selected for the answer prompt, out of OPAA_QUERY_FETCH_K candidates.
# Every selected chunk goes into the prompt uncut - nothing trims it to the chat model's context
# window. With a small context window tie it to the window size: about 6 for ~8k tokens, 12 for
# ~16k. With Ollama the server's context length (num_ctx) is the limit, not the model's.
# These values hold without neighbour chunks: by default every selected chunk also brings its
# neighbours in the same document, up to OPAA_QUERY_NEIGHBOR_CHUNKS_MAX_ADDED_CHARACTERS (40000)
# characters on top. With a small context window lower that budget or set
# OPAA_QUERY_NEIGHBOR_CHUNKS_RADIUS=0.
OPAA_QUERY_TOP_K=20
# Number of candidates every search query retrieves per search path (vector and full text). All of
# them reach the fusion, which selects OPAA_QUERY_TOP_K. Must be >= OPAA_QUERY_TOP_K.
OPAA_QUERY_FETCH_K=25
# MMR relevance/diversity trade-off (0.0–1.0) by which every candidate list is reordered before the
# fusion; nothing is cut. Default 1.0 disables diversity entirely: the stage does not
# run and the search protocol reports it as switched off - diversity selection is implemented but
# ships as an opt-in (set below 1.0 to enable), not a default: measured against the multi-topic golden
# cases, 0.7 underperformed plain topK=8 (19/20 vs. 20/20 cases with both expected documents
# retrieved) - see QueryProperties#mmrLambda's Javadoc for the full numbers and decision rule.
OPAA_QUERY_MMR_LAMBDA=1.0
# Minimum cosine similarity to include a result (0.0–1.0)
OPAA_QUERY_SIMILARITY_THRESHOLD=0.3
# Splits a question into up to OPAA_QUERY_MAX_SUB_QUERIES independent search queries before
# retrieval - each gets its own permission/threshold-scoped similaritySearch call, fused by
# reciprocal rank fusion. Adds one LLM call per query (the systemwide active chat model of the
# model administration); falls back to today's single-query retrieval on any LLM failure or
# unparsable output, never a broken query.
OPAA_QUERY_DECOMPOSITION_ENABLED=true
# Upper bound on how many independent search queries a decomposed question may split into
OPAA_QUERY_MAX_SUB_QUERIES=3
# Once a document has a chunk in the final selection, up to this many of its chunks from the
# already permission/threshold-filtered candidate pool are preferred over a chunk of a different
# document - the fix for a document's own detail chunk (e.g. a fee table)
# losing its slot to an unrelated document purely because fusion/MMR spread OPAA_QUERY_TOP_K
# across topics first. Two-tier eviction: tier 1 evicts the weakest chunk of a document already
# holding two chunks; if none exists, tier 2 evicts the lowest-ranked chunk of the whole
# selection, but only when the completing document's own best chunk ranks strictly better (may
# drop a document out of the selection entirely), capped at max(1, OPAA_QUERY_TOP_K / 4) tier-2
# evictions per query. Never exceeds OPAA_QUERY_TOP_K overall. A fill target, not a cap per
# document: one that already holds more chunks is never trimmed to it, it loses chunks only as an
# eviction source for another document. 1 (the default) disables
# completion entirely: no sibling chunks are pulled in (the selection may still hold several
# chunks of one document), and the neighbour chunks (OPAA_QUERY_NEIGHBOR_CHUNKS_RADIUS) supply
# the surrounding text without taking a selection slot.
OPAA_QUERY_MAX_CHUNKS_PER_DOCUMENT=1
# Whether the lexical (PostgreSQL full-text) search path runs its query and contributes its ranked
# lists to the fusion. The value moves the answer itself: false spares the
# query and makes retrieval purely vectorial, at a measured 15 percentage points of hit rate@5 on
# the administration eval domain. Either way the stage stays in the chain and reports itself as
# switched off in the search explanation protocol.
OPAA_QUERY_FULL_TEXT_SEARCH_ENABLED=true
# Relevance cutoff after fusion and reranking: fixed keeps up to OPAA_QUERY_TOP_K chunks,
# relative keeps those scoring at least OPAA_QUERY_RELEVANCE_CUTOFF_RELATIVE_THRESHOLD of the best,
# knee cuts before the first drop of OPAA_QUERY_RELEVANCE_CUTOFF_KNEE_DROP of the best. Never below
# OPAA_QUERY_RELEVANCE_CUTOFF_MIN_CHUNKS, never above OPAA_QUERY_TOP_K.
OPAA_QUERY_RELEVANCE_CUTOFF_MODE=fixed
OPAA_QUERY_RELEVANCE_CUTOFF_MIN_CHUNKS=10
OPAA_QUERY_RELEVANCE_CUTOFF_RELATIVE_THRESHOLD=0.6
OPAA_QUERY_RELEVANCE_CUTOFF_KNEE_DROP=0.25
# How the fusion scores the candidate lists: rrf by rank, score by normalized scores (cosine
# rescaled from the similarity threshold, ts_rank relative to the best of its list), the latter
# weighted by OPAA_QUERY_FUSION_VECTOR_WEIGHT for the vector path. With the sub-query quota every
# sub-query is fused on its own and the selection is filled round-robin, so a hit leading one aspect
# is not displaced by documents all sub-queries share; without decomposition it has no effect.
OPAA_QUERY_FUSION_METHOD=rrf
OPAA_QUERY_FUSION_SUB_QUERY_QUOTA=true
OPAA_QUERY_FUSION_VECTOR_WEIGHT=0.7
# The best N candidates of every list (one per sub-query and search path) enter the selection
# whatever their fused rank, so a hit only one search path finds is not displaced by chunks both
# paths rank around 10. top-k stays the cap; 0 switches it off.
OPAA_QUERY_FUSION_GUARANTEED_PER_LIST=1

# --- Reranking (ships switched off) ---
# Switch, endpoint, model and key of the rerank model role are set by the system administration
# under Modelle > Reranking (ADR-0060); the former OPAA_RERANK_ENABLED/_BASE_URL/_MODEL/_API_KEY
# are no longer read. Only the load limits stay here.
# Time budget of a single rerank request. When it runs out the search keeps the fused order: a slow
# endpoint costs the ordering, never the answer.
OPAA_RERANK_TIMEOUT=10s
# Longest gap without an answer from the rerank endpoint before OPAA probes it (default 60s, at
# least 10s). Every probe is a real rerank request, billed by a paid endpoint even when nobody asks a
# question; every real rerank call resets the gap. Choose a large value for a paid service. An
# unreachable endpoint is retried about a minute after the last failure regardless (a hanging
# probe itself takes up to OPAA_RERANK_TIMEOUT).
#OPAA_RERANK_PROBE_INTERVAL=24h
# How many fused candidates the rerank stage scores, and at the same time the budget MMR selection
# and fusion keep for it while reranking runs (0-200). 0 switches the stage off through its
# own parameter, independently of the switch under Modelle > Reranking. The window does not extend retrieval's
# reach: what no search stage returned can neither be fused nor reranked. That reach is
# OPAA_QUERY_FETCH_K per list times the lists in flight (sub-queries times active search paths), so
# raise OPAA_QUERY_FETCH_K along with this value - see docs/handbuch/betrieb/modelle.md, "Reranking
# einschalten".
OPAA_QUERY_RERANK_CANDIDATE_COUNT=50

# Transcription model role: dictation in the chat input. Switch, endpoint, model, key and language
# are set by the system administration under Modelle > Spracheingabe (ADR-0060); the former
# OPAA_TRANSCRIPTION_ENABLED/_BASE_URL/_MODEL/_API_KEY/_LANGUAGE are no longer read. Recordings are
# passed through in memory, never stored, never logged (docs/handbuch/betrieb/modelle.md).
# Largest recording in bytes (a two-minute recording is well below 1 MB).
#OPAA_TRANSCRIPTION_MAX_AUDIO_BYTES=10485760
# Time budget of one transcription request; CPU transcription is slow.
#OPAA_TRANSCRIPTION_TIMEOUT=120s
# Recordings passed on at the same time by one backend instance (each held in memory); with several
# instances: the installation's budget divided by the number of instances.
#OPAA_TRANSCRIPTION_MAX_CONCURRENT=4

# --- Malware scan ---
# Every file is sent to a clamd daemon (TCP, INSTREAM) before a library takes it in; off by
# default. clamd's StreamMaxLength must cover the largest file. REJECT keeps a file the scanner
# could not judge out, ACCEPT takes it in unscanned.
OPAA_MALWARE_SCAN_ENABLED=false
#OPAA_MALWARE_SCAN_HOST=clamav
#OPAA_MALWARE_SCAN_PORT=3310
#OPAA_MALWARE_SCAN_TIMEOUT=30s
#OPAA_MALWARE_SCAN_ON_UNAVAILABLE=REJECT

# --- Export of the audit log to a SIEM ---
# Syslog with CEF over TCP to the security monitoring of the house, TLS by default with the JVM
# trust store; no pseudonyms, from the moment it is switched on (ADR-0055).
OPAA_SIEM_EXPORT_ENABLED=false
#OPAA_SIEM_EXPORT_HOST=siem.example.org
#OPAA_SIEM_EXPORT_PORT=6514
#OPAA_SIEM_EXPORT_TLS=true
#OPAA_SIEM_EXPORT_INCLUDE_LABELS=false
#OPAA_SIEM_EXPORT_TIMEOUT=30s

# --- pgvector ---
# The vector size comes from the probe embedding of the installation.
# Distance function: cosine_distance, euclidean_distance, negative_inner_product
OPAA_PGVECTOR_DISTANCE_TYPE=cosine_distance

# --- Rate Limiting ---
# *_GLOBAL_MAX_REQUESTS count for the whole installation in the database; every other limit counts
# per backend instance: with several instances set it to the installation's budget divided by their
# number (docs/handbuch/betrieb/mehrere-instanzen.md, "Grenzen und Budgets").
# Enable or disable rate limiting globally
OPAA_RATE_LIMIT_ENABLED=true
# Max query requests per user within the time window
OPAA_RATE_LIMIT_QUERY_MAX_REQUESTS=10
# Time window for per-user query rate limit (seconds)
OPAA_RATE_LIMIT_QUERY_WINDOW_SECONDS=60
# Max query requests across all users within the time window
OPAA_RATE_LIMIT_QUERY_GLOBAL_MAX_REQUESTS=100
# Max indexing requests per user within the time window
OPAA_RATE_LIMIT_INDEXING_MAX_REQUESTS=1
# Time window for per-user indexing rate limit (seconds)
OPAA_RATE_LIMIT_INDEXING_WINDOW_SECONDS=60
# Max indexing requests across all users within the time window
OPAA_RATE_LIMIT_INDEXING_GLOBAL_MAX_REQUESTS=5
# Max query requests per signed-in account within the time window, whatever its address
#OPAA_RATE_LIMIT_QUERY_MAX_REQUESTS_PER_ACCOUNT=10
# Chat search (POST /api/v1/spaces/{spaceId}/chats/search), defaults: per client, across all
# clients, per account
#OPAA_RATE_LIMIT_CHAT_SEARCH_MAX_REQUESTS=60
#OPAA_RATE_LIMIT_CHAT_SEARCH_WINDOW_SECONDS=60
#OPAA_RATE_LIMIT_CHAT_SEARCH_GLOBAL_MAX_REQUESTS=1200
#OPAA_RATE_LIMIT_CHAT_SEARCH_MAX_REQUESTS_PER_ACCOUNT=60
# Search without an answer (POST /api/v1/search) and hit fetch (GET /api/v1/search/hits/{hitId}),
# one budget for both, defaults: per client, across all clients, per account and per access token
# (an access token spends no budget of its address)
#OPAA_RATE_LIMIT_SEARCH_MAX_REQUESTS=30
#OPAA_RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
#OPAA_RATE_LIMIT_SEARCH_GLOBAL_MAX_REQUESTS=300
#OPAA_RATE_LIMIT_SEARCH_MAX_REQUESTS_PER_ACCOUNT=30
# Vertraute Proxys (ADR-0033): X-Forwarded-For zählt nur, wenn die Verbindung aus einer dieser
# Adressen kommt. Der nginx des Frontend-Containers reicht jeden API-Aufruf weiter, deshalb MUSS
# hier seine feste Adresse stehen - docker-compose.yml legt sie auf 172.28.0.10 im Netz 172.28.0.0/16
# fest (OPAA_COMPOSE_FRONTEND_ADDRESS/OPAA_COMPOSE_SUBNET in der Shell-Umgebung oder .env ändern
# beides; diesen Wert dann mit). Genau diese eine Adresse, nicht das ganze Netz: Die Gateway-Adresse
# (172.28.0.1) spricht jeder Prozess des Docker-Hosts und jeder Container - wer sie vertraut, macht
# jeden davon zum Proxy. Steht ein weiterer Proxy auf DEMSELBEN Host vor dem Frontend-Container,
# erscheint er dem nginx unter genau dieser Gateway-Adresse und muss mit ihr ergänzt werden
# (172.28.0.10/32,172.28.0.1/32) - mit dem genannten Risiko; ein Proxy auf einem anderen Rechner
# kommt mit seiner eigenen Adresse dazu. Leer = Header ignoriert = alle Clients hinter dem Proxy
# teilen sich einen Zähler; Bereiche weiter als /8 (0.0.0.0/0, ::/0) werden beim Start abgelehnt.
OPAA_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.28.0.10/32
# Grenzen der lokalen Anmeldung (ADR-0033), Vorgaben; je Client-Adresse, sofern nicht anders
# vermerkt. GLOBAL = über alle Adressen je Fenster (Frühwarnung gegen verteiltes Credential
# Stuffing: WARN-Zeile und Metrik), PER_ADDRESS = je genannter E-Mail-Adresse.
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_MAX_REQUESTS=10
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_WINDOW_SECONDS=60
#OPAA_RATE_LIMIT_LOCAL_AUTH_LOGIN_GLOBAL_MAX_REQUESTS=100
#OPAA_RATE_LIMIT_LOCAL_AUTH_REFRESH_MAX_REQUESTS=30
#OPAA_RATE_LIMIT_LOCAL_AUTH_REFRESH_WINDOW_SECONDS=60
#OPAA_RATE_LIMIT_LOCAL_AUTH_CHANGE_PASSWORD_MAX_REQUESTS=5
#OPAA_RATE_LIMIT_LOCAL_AUTH_CHANGE_PASSWORD_WINDOW_SECONDS=300
#OPAA_RATE_LIMIT_LOCAL_AUTH_REGISTER_MAX_REQUESTS=5
#OPAA_RATE_LIMIT_LOCAL_AUTH_REGISTER_WINDOW_SECONDS=3600
#OPAA_RATE_LIMIT_LOCAL_AUTH_REGISTER_GLOBAL_MAX_REQUESTS=50
#OPAA_RATE_LIMIT_LOCAL_AUTH_REGISTER_MAX_REQUESTS_PER_ADDRESS=3
#OPAA_RATE_LIMIT_LOCAL_AUTH_FORGOT_PASSWORD_MAX_REQUESTS=5
#OPAA_RATE_LIMIT_LOCAL_AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=3600
#OPAA_RATE_LIMIT_LOCAL_AUTH_FORGOT_PASSWORD_GLOBAL_MAX_REQUESTS=50
#OPAA_RATE_LIMIT_LOCAL_AUTH_FORGOT_PASSWORD_MAX_REQUESTS_PER_ADDRESS=3
#OPAA_RATE_LIMIT_LOCAL_AUTH_SET_PASSWORD_MAX_REQUESTS=10
#OPAA_RATE_LIMIT_LOCAL_AUTH_SET_PASSWORD_WINDOW_SECONDS=900
#OPAA_RATE_LIMIT_LOCAL_AUTH_VERIFY_EMAIL_MAX_REQUESTS=10
#OPAA_RATE_LIMIT_LOCAL_AUTH_VERIFY_EMAIL_WINDOW_SECONDS=900

# --- Zugangsdaten-Verschlüsselung ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung der Zugangsdaten einer
# Quellkonfiguration (knowledge_libraries.source_credentials) ruhend in der Datenbank. Erforderlich,
# sobald eine Bibliothek vom Typ HTTP_DIRECTORY/RSS_FEED mit Zugangsdaten angelegt oder geändert
# wird - ohne gültigen Schlüssel schlägt genau dieser Schreibvorgang mit 503 fehl, der Start selbst
# bricht nicht ab. Erzeugen z. B. mit: openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/betrieb/netz-und-sicherheit.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_CREDENTIALS_ENCRYPTION_KEY=

# --- Verschlüsselung der Zugangsschlüssel verwalteter Chat-Modelle ---
# AES-256-Schlüssel (Base64, 32 rohe Byte) zur Verschlüsselung von llm_models.api_key_ciphertext
# ruhend in der Datenbank - ein eigener Schlüssel, getrennt von OPAA_CREDENTIALS_ENCRYPTION_KEY
# oben. Erforderlich, sobald ein Chat-Modell MIT Zugangsschlüssel angelegt oder geändert wird
# (einschliesslich der einmaligen Übernahme einer bestehenden openai-Konfiguration mit
# API-Schlüssel beim ersten Start nach einem Update) - ohne gültigen Schlüssel schlägt genau
# dieser Vorgang fehl, der Start selbst bricht nicht ab. Eine reine Ollama-Installation oder ein
# openai-kompatibler Endpunkt OHNE Schlüssel braucht diese Variable nicht. Erzeugen z. B. mit:
# openssl rand -base64 32
# KEIN echter Schlüssel gehört in dieses Beispiel oder ins Repository. Siehe docs/handbuch/betrieb/modelle.md.
# Auskommentiert lassen: ein leerer Wert würde im Docker-Stack (Profil "dev") den dort
# hinterlegten, ausdrücklich nicht produktionstauglichen Default überschreiben.
#OPAA_SETTINGS_ENCRYPTION_KEY=

# --- Lokale Konten: Token-Secret und Sitzungsfristen (ADR-0033) ---
# Wurzelgeheimnis der lokalen Benutzerverwaltung: Aus ihm leitet das Backend per HKDF die Schlüssel
# für die Signatur lokaler Access-Tokens sowie die Lookup-Hashes der Refresh- und Aktionstoken ab.
# Im Betriebsmodus (SPRING_PROFILES_ACTIVE=docker,oidc, auch für den Demo-Stack) PFLICHT: Fehlt der Wert, ist er kürzer als 32 Zeichen oder ein
# Platzhalter, bricht der Start mit einer Meldung ab, die diese Variable nennt. Erzeugen mit:
# openssl rand -base64 48
# Eine Rotation beendet alle lokalen Sitzungen und entwertet alle offenen Einladungs-, Rücksetz-
# und Übergabelinks - bewusst der eine Handgriff nach einer Datenbank-Rücksicherung.
# KEIN echter Wert gehört in dieses Beispiel oder ins Repository.
# Auskommentiert lassen: ein leerer Wert würde im Profil "dev" den dort hinterlegten, ausdrücklich
# nicht produktionstauglichen Default überschreiben.
#OPAA_AUTH_JWT_SECRET=
# Sitzungsfristen lokaler Konten - Vorgaben aus ADR-0033, nur bei Bedarf setzen: Leerlauffrist
# (Refresh-Token) höchstens 30 Tage, absolute Höchstdauer einer Sitzung höchstens 90 Tage; für
# lokale Systemverwalterkonten gelten die kürzeren ADMIN-Werte. Ein Wert außerhalb dieser Grenzen
# bricht den Start ab.
#OPAA_AUTH_LOCAL_ACCESS_TOKEN_TTL=15m
#OPAA_AUTH_LOCAL_REFRESH_TOKEN_TTL=7d
#OPAA_AUTH_LOCAL_SESSION_MAX_LIFETIME=30d
#OPAA_AUTH_LOCAL_ADMIN_REFRESH_TOKEN_TTL=4h
#OPAA_AUTH_LOCAL_ADMIN_SESSION_MAX_LIFETIME=12h
# "false" nur für lokales HTTP ohne TLS - das Refresh-Cookie verliert dann sein Secure-Attribut.
#OPAA_AUTH_LOCAL_COOKIE_SECURE=true
# Gnadenfrist nach der Erneuerung einer Sitzung (ADR-0033): Ein Neuladen, das die Antwort der
# Erneuerung verworfen hat, legt das alte Refresh-Token noch einmal vor; innerhalb dieser Frist gilt
# das nicht als Wiederverwendung. Höchstens 60s, 0 schaltet sie ab.
#OPAA_AUTH_LOCAL_REFRESH_GRACE_PERIOD=20s
# Kontosperre nach Fehlversuchen (ADR-0033): nach MAX_ATTEMPTS falschen Passwörtern ist das Konto
# für DURATION gesperrt (feste Dauer, keine Verlängerung); der Zähler geht bei erfolgreicher
# Anmeldung auf null (und beim Sperren selbst: nach Ablauf der Sperre gilt wieder das volle
# Kontingent). Ein Wert unter 1 bzw. eine Dauer <= 0 bricht den Start ab.
#OPAA_AUTH_LOCAL_LOCKOUT_MAX_ATTEMPTS=5
#OPAA_AUTH_LOCAL_LOCKOUT_DURATION=15m

# --- E-Mail-Versand (SMTP) ---
# Adresse, unter der diese Installation von aussen erreichbar ist. Sie bildet die Basis jedes Links
# in einer von OPAA versendeten E-Mail (Einladung, Passwort vergessen, Bestaetigung). Bewusst eine
# Umgebungsvariable und keine Einstellung in der Verwaltung: der Host-Header einer Anfrage wird nie
# als Basis verwendet, und wer die Basis im Browser aendern koennte, koennte aus einer
# kompromittierten Verwaltersitzung heraus jeden Link umlenken. Ohne Wert baut OPAA keinen Link;
# die Verwaltung der Konten bietet die davon abhaengigen Ablaeufe dann nicht an.
# Vollstaendige Adresse mit Schema, ohne abschliessenden Schraegstrich.
#OPAA_PUBLIC_BASE_URL=http://localhost:3000
# Zeitgrenzen der SMTP-Verbindung. Der Versand laeuft synchron im Anfrage-Thread der Person, die
# gerade auf ihre Einladung wartet - ein haengender Mailserver darf ihn nicht laenger halten als hier
# erlaubt. Server, Port, Verschluesselung, Zugangsdaten und Absender stehen NICHT hier, sondern in
# der Verwaltung unter "E-Mail-Versand" (das Passwort liegt verschluesselt in der Datenbank).
#OPAA_MAIL_CONNECT_TIMEOUT=10s
#OPAA_MAIL_READ_TIMEOUT=15s
#OPAA_MAIL_WRITE_TIMEOUT=15s
# Mailpit als Mailserver des lokalen Stapels: `docker compose --profile mail up` startet ihn,
# die Weboberflaeche liegt danach auf http://localhost:8025. In der Verwaltung unter
# "E-Mail-Versand" eintragen: Server "mailpit", Port 1025, Verschluesselung NONE, keine Zugangsdaten.
# Nur aus der Prozessumgebung/einer echten .env wirksam, nie aus dieser env_file.
#OPAA_MAILPIT_SMTP_PORT=1025
#OPAA_MAILPIT_WEB_PORT=8025

# --- OIDC (used with oidc profile) ---
# The identity provider comes from the installation (assistant or answer file, signIn) and the
# Anbieterverwaltung (ADR-0025, ADR-0060), not from this file.
# Address check (SSRF) for every issuer/JWK set address of a provider, from the installation as
# well as from the Anbieterverwaltung; separate from OPAA_INDEXING_TARGET_VALIDATION_* and
# OPAA_MODEL_TARGET_VALIDATION_*. Internal
# identity providers need their host listed here - the bundled Keycloak of this stack
# "localhost:8180,keycloak:8180" (issuer for the browser, JWK set for the backend); an entry with
# a port admits only that port of the host.
#OPAA_OIDC_TARGET_VALIDATION_ENABLED=true
#OPAA_OIDC_TARGET_VALIDATION_ALLOWLIST=localhost:8180,keycloak:8180
# Additional origin(s) the frontend's Content-Security-Policy connect-src must allow, beyond
# 'self'. Needed because oidc-client-ts fetches OIDC discovery metadata and later
# exchanges the auth code directly from the browser against the authority's origin - if that
# origin differs from the frontend's own, it must be listed here (space-separated for more than
# one), or the CSP silently blocks the OIDC login. Only relevant with the "oidc" Spring profile
# (SPRING_PROFILES_ACTIVE=docker,oidc above) - the "dev" default this template ships with does not
# start Keycloak (compose profile "oidc", see docs/handbuch/betrieb/authentifizierung.md, section "OIDC (Keycloak)").
# Uncomment when switching to docker,oidc with this compose file's bundled Keycloak, which runs on
# its own port, not behind the frontend's nginx. A production identity provider on its own address
# (Entra ID, a house-wide Keycloak) needs its own origin here instead.
#OPAA_CSP_CONNECT_SRC_EXTRA=http://localhost:8180

# Shows the demo/source notice in the frontend footer - a synthetic-corpus disclaimer plus
# a link to the LHM-Dienstleistungen-Corpus dataset origin and license. Only meant for the
# Rheinfurt demo instance, not for regular OPAA installations - the frontend image defaults this
# to "false" (frontend/Dockerfile). The local demo stack (demo/README.md, "Compose-Stack starten")
# sets it to "true" in its own .env.docker - the frontend service loads this env_file (see
# docker-compose.yml), so setting it there is enough; no image rebuild needed.
#OPAA_DEMO_MODE=false

# How long the frontend's nginx waits for the backend's answer on /api/ and /mcp (number with unit
# s, m or h; the image defaults to 600s, see frontend/Dockerfile). A chat answer arrives in one
# piece after retrieval, reranking and the model call; raise this together with OPAA_RERANK_TIMEOUT
# and with the timeout of every proxy in front of the frontend container.
#OPAA_BACKEND_READ_TIMEOUT=600s

# Seed-only route of the Rheinfurt demo: with "true" the backend accepts prepared chat
# transcripts through POST /api/v1/spaces/{id}/chat-imports, which the demo seed's last step uses
# to fill Andrea Vogt's space with chats. Off by default and never meant for a regular
# installation - without it the route does not exist (demo/README.md, "Seed ausführen").
#OPAA_DEMO_CHAT_IMPORT_ENABLED=false

# Installation-wide feature flags (ADR-0044): every feature is on unless set to "false" here.
# Switching one off hides it and ignores its existing data, it deletes nothing; takes effect after
# a restart of the backend (docs/handbuch/betrieb/konfiguration.md, "Funktionen abschalten").
# false hides the prompt libraries from catalog, chat and interface; their data stays.
#OPAA_FEATURES_PROMPT_LIBRARIES_ENABLED=true
# false leaves documents with their title alone and disables every metadata filter; data stays.
#OPAA_FEATURES_METADATA_ENABLED=true
# false hides dictation in the chat even with transcription configured.
#OPAA_FEATURES_SPEECH_INPUT_ENABLED=true
# false removes the external access entirely: no access tokens, no library releases, no MCP
# server on /mcp. Tokens, releases and channel settings stay stored.
#OPAA_FEATURES_EXTERNAL_ACCESS_ENABLED=true

# --- Docker Compose ports ---
# Backend host port (mapped to container port 8080). Only effective from the process
# environment/a real .env file, never from this env_file - see docs/handbuch/betrieb/konfiguration.md, section "Alle
# Umgebungsvariablen". Left commented out here so the value below does not suggest otherwise.
#OPAA_BACKEND_PORT=8081
# Frontend host port (mapped to container port 8080). Same caveat as OPAA_BACKEND_PORT above -
# effective only from the process environment/a real .env file, never from this env_file.
#OPAA_FRONTEND_PORT=3000
# Host addresses the frontend and the bundled Keycloak are published on; 127.0.0.1 by default,
# 0.0.0.0 opens them to every interface, past ufw/firewalld. Same caveat as above. Beyond loopback
# the "dev" profile does not start without OPAA_AUTH_DEV_ALLOW_REMOTE=true
# (docs/handbuch/betrieb/docker-compose.md, "Härtung des Compose-Stapels").
#OPAA_FRONTEND_BIND_ADDRESS=127.0.0.1
#OPAA_KEYCLOAK_BIND_ADDRESS=127.0.0.1
